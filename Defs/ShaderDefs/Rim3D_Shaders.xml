<?xml version="1.0" encoding="utf-8"?>
<!-- RimVision on RimWorld 1.7: the original Unity shaders ported to the Waylith engine (Shaders/Rim3D_*.glsl).
     Render state mirrors each original pass; per-material blend, depth write and culling come from the material. -->
<Defs>

  <ShaderDef>
    <defName>Rim3D_TacticalGlow</defName>
    <shaderProgram>
      <vertexShaderFileName>Rim3D_TacticalGlow.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>Rim3D_TacticalGlow.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <blendMode>Alpha</blendMode>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3995</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <ShaderDef>
    <defName>Rim3D_PreviewSurface</defName>
    <shaderProgram>
      <vertexShaderFileName>Rim3D_PreviewSurface.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>Rim3D_PreviewSurface.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <depthWrite>true</depthWrite>
      <cullMode>None</cullMode>
      <stencilEnabled>true</stencilEnabled>
      <stencilCompare>Always</stencilCompare>
      <stencilPassOp>Replace</stencilPassOp>
      <stencilRef>0</stencilRef>
      <stencilReadMask>255</stencilReadMask>
      <stencilWriteMask>64</stencilWriteMask>
      <renderQueue>2450</renderQueue>
    </shaderProgram>
  </ShaderDef>

