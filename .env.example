# Copy to .env and fill in only what auto-detection gets wrong. Never commit .env.

# Folder holding this repo and the shared reference/ folder. Defaults to the repo's parent folder.
# RWMW2_WORKSPACE=/path/to/game_modding

# RimWorld install folder (the one containing Version.txt).
# RIMWORLD_DIR=C:\Program Files (x86)\Steam\steamapps\common\RimWorld

# Folder that contains your MW2 install folder. IW4L calls this IW4L_GAMES.
# IW4L_GAMES=C:\Program Files (x86)\Steam\steamapps\common

# Bridge address. RimWorld connects, the IW4L side listens.
# RWMW2_BRIDGE_ADDR=127.0.0.1:47820
