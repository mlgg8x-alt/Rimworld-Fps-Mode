#version 450
// RimVision for RimWorld 1.7: port of Recovery/Rim3D/PreviewSky from the original Unity shader bundle.
// Generated by shadersrc/build_shaders.py; edit the source there.

layout(set = 2, binding = 0) uniform MaterialUniforms
{
    vec4 _Zenith;                // @color @default = vec4(0.22, 0.43, 0.68, 1.0)
    vec4 _Horizon;               // @color @default = vec4(0.76, 0.82, 0.86, 1.0)
    vec4 _SunDirection;          // @default = vec4(0.0, 1.0, 0.0, 0.0)
    vec4 _CloudColor;            // @color @default = vec4(0.91, 0.94, 0.98, 1.0)
    vec4 _CloudOffset;           // @default = vec4(0.0, 0.0, 0.0, 0.0)
    float _Daylight;             // @default = 1.0
    float _Overcast;             // @default = 0.0
    float _Night;                // @default = 0.0
    float _Rim3DFogDistanceScale; // global

} u;

#ifdef RIM3D_BANDS
// Keep source map coordinates for textures/light maps; stack only the projected position.
vec3 rim3DBandPosition(vec3 p)
{
    if (u._Rim3DBands.x <= 0.0) return p;
    float band = clamp(floor((p.z + (u._Rim3DBands.x - u._Rim3DBands.y) * 0.5) / u._Rim3DBands.x), 0.0, u._Rim3DBandCount - 1.0);
#ifdef RIM3D_BAND_VERTEX
    if (inBandOwner.x > 0.5) band = inBandOwner.x - 1.0;
#endif
    float delta = band - u._Rim3DBands.z;
    return p + vec3(0.0, delta * u._Rim3DBands.w, -delta * u._Rim3DBands.x);
}
bool rim3DBandVisible(vec3 p)
{
    return u._Rim3DBands.x <= 0.0 || (p.z >= 0.0 && p.z < u._Rim3DBandCount * u._Rim3DBands.x && mod(p.z, u._Rim3DBands.x) <= u._Rim3DBands.y + 0.001);
}
#endif
// Waylith stores textures top row first; Unity UVs start at the bottom.
vec2 flipUv(vec2 uv) { return vec2(uv.x, 1.0 - uv.y); }
vec4 tex2D(sampler2D s, vec2 uv) { return texture(s, flipUv(uv)); }

float insideMap(vec2 uv)
{
    return (all(greaterThanEqual(uv, vec2(0.0))) && all(lessThan(uv, vec2(1.0)))) ? 1.0 : 0.0;
}

// RimVision's distance fog; weight blends from the clear-air defaults to the weather's (x linear, y quadratic, z start).
float fogVisibility(float dist, float weight, vec4 weatherFog)
{
    vec3 p = mix(vec3(8.0, 0.012, 0.00012), weatherFog.zxy, weight);
    dist *= clamp(u._Rim3DFogDistanceScale, 0.0, 1.0);
    float d = max(dist - p.x, 0.0);
    return exp(-d * p.y - d * d * p.z);
}

layout(location = 0) in vec3 vDirection;

layout(location = 0) out vec4 outColor;

layout(set = 2, binding = 1) uniform sampler2D _CloudNoise; // @default = gray

float starHash(vec3 c)
{
    vec3 q = fract(c * 0.1031);
    q += dot(q, q.yzx + 33.33);
    return fract((q.x + q.y) * q.z);
}

void main()
{
    float invLength = inversesqrt(dot(vDirection, vDirection));
    vec3 d = vDirection * invLength;
    float up = max(d.y, 0.0);
    float gradient = pow(min(up, 1.0), 0.55);
    vec3 sky = mix(u._Horizon.rgb, u._Zenith.rgb, gradient);
    vec3 color = mix(sky, u._Horizon.rgb * (1.0 - gradient * 0.2), u._Overcast * 0.8);
    float horizonFade = smoothstep(0.0, 1.0, clamp(d.y * 12.5, 0.0, 1.0));

    vec3 S = normalize(u._SunDirection.xyz);
    float sunCos = dot(d, S);
    float sunGlow = pow(clamp(sunCos, 0.0, 1.0), 18.0) * u._Daylight;
    color += sunGlow * vec3(0.18, 0.126, 0.063) * (1.0 - u._Overcast);

    // Sun disc, antialiased by the screen-space change of the angle.
    float width = max(abs(dFdx(sunCos)) + abs(dFdy(sunCos)), 0.00004);
    float lo = 0.99965 - width;
    float disc = clamp((sunCos - lo) / ((0.99965 + width) - lo), 0.0, 1.0);
    disc = disc * disc * (3.0 - 2.0 * disc) * u._Daylight;
    color += disc * horizonFade * vec3(1.0, 0.92, 0.72);

    if (u._Night > 0.001)
    {
        vec3 p = d * 115.0;
        vec3 cell = floor(p);
        float h0 = starHash(cell);
        vec3 center = vec3(starHash(cell + 17.1), starHash(cell + 43.7), starHash(cell + 91.3));
        float starBrightness = center.x * 0.65 + 0.45;
        center = center * 0.6 + 0.2;
        float offset = length(fract(p) - center);
        float radius = h0 * 0.09 + 0.08;
        float blur = max(length(abs(dFdx(p)) + abs(dFdy(p))) * 0.5, 0.015);
        float inner = max(radius - blur, 0.0);
        float edge = clamp((offset - inner) / ((radius + blur) - inner), 0.0, 1.0);
        float star = 1.0 - edge * edge * (3.0 - 2.0 * edge);
        star *= (h0 >= 0.965 ? 1.0 : 0.0) * starBrightness * min(radius / blur, 1.0);
        color += star * u._Night * horizonFade * vec3(0.8, 0.88, 1.0);

        // Moon opposite the sun, with a soft halo.
        float moonLo = 0.9995 - width;
        float moon = clamp((-sunCos - moonLo) / ((0.9995 + width) - moonLo), 0.0, 1.0);
        moon = moon * moon * (3.0 - 2.0 * moon);
        float halo = pow(clamp(-sunCos, 0.0, 1.0), 64.0) * 0.025;
        color += (moon * 0.75 + halo) * u._Night * horizonFade * vec3(0.65, 0.73, 0.88);
    }

    // Two layers of clouds projected onto a dome.
    vec2 dome = d.xz / (sqrt(up * up + 0.04) + up);
    float cloudFade = clamp((vDirection.y * invLength - 0.015) * 8.0, 0.0, 1.0);
    cloudFade = cloudFade * cloudFade * (3.0 - 2.0 * cloudFade);
    vec4 cloudUv = dome.xyxy * vec4(0.28, 0.28, 0.6076, 0.6076) + u._CloudOffset;
    float noise = tex2D(_CloudNoise, cloudUv.xy).x * 0.75 + tex2D(_CloudNoise, cloudUv.zw).x * 0.25;
    float c = clamp((noise - (0.52 - 0.35 * u._Overcast)) * 6.25, 0.0, 1.0);
    c = c * c * (3.0 - 2.0 * c);
    float cover = mix(c, 1.0, u._Overcast * u._Overcast) * cloudFade;
    float shade = clamp((noise - 0.3) * 2.222222, 0.0, 1.0);
    shade = shade * shade * (3.0 - 2.0 * shade) * 0.4 + 0.6;
    vec3 cloud = shade * u._CloudColor.rgb * (1.0 - 0.35 * u._Overcast);
    outColor = vec4(mix(color, cloud, cover), 1.0);
}
