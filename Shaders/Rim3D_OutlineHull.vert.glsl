#version 450
// RimVision for RimWorld 1.7: port of Recovery/Rim3D/OutlineHull from the original Unity shader bundle.
// Generated by shadersrc/build_shaders.py; edit the source there.
#define RIM3D_BANDS
#define RIM3D_BAND_VERTEX
layout(location = 6) in vec4 inBandOwner; // @vertex TexCoord3 optional @default = vec4(0.0, 0.0, 0.0, 0.0)

layout(push_constant) uniform Push { mat4 modelMatrix; } push;

layout(set = 0, binding = 0) uniform VertexUniforms
{
    mat4 ViewProj;
} uVertex;

layout(set = 2, binding = 0) uniform MaterialUniforms
{
    mat4 _Rim3DOutlineView;           // global
    mat4 _Rim3DOutlineProjection;     // global
    vec4 _MainTex_ST;            // @default = vec4(0.0, 0.0, 1.0, 1.0)
    vec4 _Color;                 // @color @default = vec4(1.0, 1.0, 1.0, 1.0)
    vec4 _SurfaceScale;          // @default = vec4(1.0, 1.0, 0.0, 0.0)
    vec4 _Rim3DOutlineCameraPosition;     // global
    vec4 _Rim3DOutlinePositionCorrection; // global
    vec4 _Rim3DRoofMapSize;               // global
    vec4 _Rim3DWeatherFog;                // global
    float _Opaque;               // @default = 1.0
    float _WeaponVolume;         // @default = 0.0
    float _SurfaceTile;          // @default = 0.0
    float _WallSurface;          // @default = 0.0
    float _SurfaceRepeat;        // @default = 0.0
    float _Rim3DOutlineFirstPerson;   // @default = 0.0
    float _Rim3DOutlineWidth;         // global
    float _Rim3DOutlineWorldPerPixel; // global
    float _Rim3DOutlineNear;          // global
    float _Rim3DRoofHeight;           // global
    float _Rim3DFogDistanceScale; // global

    vec4 _Rim3DBands; // global
    float _Rim3DBandCount; // global

} u;

#ifdef RIM3D_BANDS
// Keep source map coordinates for textures/light maps; stack only the projected position.
vec3 rim3DBandPosition(vec3 p)
{
    if (u._Rim3DBands.x <= 0.0) return p;
    float band = clamp(floor((p.z + (u._Rim3DBands.x - u._Rim3DBands.y) * 0.5) / u._Rim3DBands.x), 0.0, u._Rim3DBandCount - 1.0);
#ifdef RIM3D_BAND_VERTEX
    if (inBandOwner.x > 0.5) band = inBandOwner.x - 1.0;
#endif
    float delta = band - u._Rim3DBands.z;
    return p + vec3(0.0, delta * u._Rim3DBands.w, -delta * u._Rim3DBands.x);
}
bool rim3DBandVisible(vec3 p)
{
    return u._Rim3DBands.x <= 0.0 || (p.z >= 0.0 && p.z < u._Rim3DBandCount * u._Rim3DBands.x && mod(p.z, u._Rim3DBands.x) <= u._Rim3DBands.y + 0.001);
}
#endif
// Waylith stores textures top row first; Unity UVs start at the bottom.
vec2 flipUv(vec2 uv) { return vec2(uv.x, 1.0 - uv.y); }
vec4 tex2D(sampler2D s, vec2 uv) { return texture(s, flipUv(uv)); }

float insideMap(vec2 uv)
{
    return (all(greaterThanEqual(uv, vec2(0.0))) && all(lessThan(uv, vec2(1.0)))) ? 1.0 : 0.0;
}

// RimVision's distance fog; weight blends from the clear-air defaults to the weather's (x linear, y quadratic, z start).
float fogVisibility(float dist, float weight, vec4 weatherFog)
{
    vec3 p = mix(vec3(8.0, 0.012, 0.00012), weatherFog.zxy, weight);
    dist *= clamp(u._Rim3DFogDistanceScale, 0.0, 1.0);
    float d = max(dist - p.x, 0.0);
    return exp(-d * p.y - d * d * p.z);
}

layout(location = 0) in vec3 inPosition; // @vertex Position required
layout(location = 1) in vec3 inNormal;   // @vertex Normal optional @default = vec4(0.0, 1.0, 0.0, 0.0)
layout(location = 2) in vec4 inColor;    // @vertex Color optional @default = vec4(1.0, 1.0, 1.0, 1.0)
layout(location = 3) in vec4 inUv0;      // @vertex TexCoord0 optional @default = vec4(0.0, 0.0, 0.0, 0.0)
layout(location = 5) in vec4 inUv2;      // @vertex TexCoord2 optional @default = vec4(0.0, 0.0, 0.0, 0.0)

layout(location = 0) out vec4 vUvDistAlpha; // uv, camera distance, vertex alpha
layout(location = 1) out vec4 vWorldSide;   // world position, outline side
layout(location = 2) out vec3 vNormal;

void main()
{
    if (u._Rim3DOutlineFirstPerson > 0.5)
    {
        mat3 model = mat3(push.modelMatrix);
        vec3 world = (push.modelMatrix * vec4(inPosition, 1.0)).xyz;
        vec3 centerWorld = (push.modelMatrix * vec4(inUv2.xyz, 1.0)).xyz;
        vec4 baseClip = uVertex.ViewProj * vec4(world, 1.0);
        float depth = max(baseClip.w, u._Rim3DOutlineNear);
        float width = depth * u._Rim3DOutlineWidth * u._Rim3DOutlineWorldPerPixel;
        float radius = max(max(length(model[0]), length(model[1])), length(model[2])) * abs(inUv2.w);
        vec3 expanded = centerWorld + (world - centerWorld) * (1.0 + width / max(radius, 0.0001));
        vec4 clip = uVertex.ViewProj * vec4(expanded, 1.0);
        clip.z = mix(clip.w, clip.z, 0.001);
        gl_Position = inUv2.w == 0.0 ? vec4(0.0, 0.0, 0.0, 1.0) : clip;
        vUvDistAlpha = vec4(inUv0.xy * u._MainTex_ST.zw + u._MainTex_ST.xy, depth, inColor.a);
        vWorldSide = vec4(world, sign(inUv2.w));
        vNormal = normalize(transpose(inverse(model)) * inNormal);
        return;
    }
    // TEXCOORD2 holds the hull centre offset (xyz) and the signed outline weight (w).
    mat3 m = mat3(push.modelMatrix);
    float scale = max(max(length(m[1]), length(m[2])), length(m[0])) * abs(inUv2.w);
    scale = max(scale, 0.0001);
    vec3 sourceWorld = (push.modelMatrix * vec4(inPosition, 1.0)).xyz;
    vec3 sourceCenter = (push.modelMatrix * vec4(inUv2.xyz, 1.0)).xyz;
    vec3 world = rim3DBandPosition(sourceWorld);
    vec3 center = sourceCenter + (world - sourceWorld);
    vec3 correction = u._Rim3DOutlinePositionCorrection.xyz;
    vec4 baseClip = uVertex.ViewProj * vec4(world - correction, 1.0);
    float depth = max(baseClip.w, u._Rim3DOutlineNear);
    float worldWidth = depth * (6.0 / max(depth, 6.0)) * u._Rim3DOutlineWidth * u._Rim3DOutlineWorldPerPixel;
    vWorldSide.xyz = sourceWorld;
    vUvDistAlpha.z = length(world - u._Rim3DOutlineCameraPosition.xyz - correction);
#ifdef RIM3D_OUTLINE_DEPTH
    // Screen-space outline: push the vertex away from the centre in clip space.
    vec4 centerClip = uVertex.ViewProj * vec4(center - correction, 1.0);
    vec4 clip = baseClip;
    vec2 dir = clip.xy - centerClip.xy * (clip.w / centerClip.w);
    clip.xy += dir * (worldWidth / scale);
#else
    // Hull outline: scale the shell up around its centre by the wanted world width.
    float grow = worldWidth / scale + 1.0;
    vec3 expanded = center + (world - center) * grow;
    vec4 clip = uVertex.ViewProj * vec4(expanded - correction, 1.0);
#endif
    // Use the engine projection and the same stacked position as the visible mesh.
    gl_Position = inUv2.w == 0.0 ? vec4(0.0, 0.0, 0.0, 1.0) : clip;
    vUvDistAlpha.xy = u._SurfaceTile > 0.5 ? inUv0.xy : inUv0.xy * u._MainTex_ST.zw + u._MainTex_ST.xy;
    vUvDistAlpha.w = inColor.a;
    vWorldSide.w = sign(inUv2.w);
    vNormal = normalize(transpose(inverse(m)) * inNormal);
}
