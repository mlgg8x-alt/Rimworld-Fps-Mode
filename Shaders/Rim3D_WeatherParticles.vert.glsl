#version 450
// RimVision for RimWorld 1.7: port of Recovery/Rim3D/WeatherParticles from the original Unity shader bundle.
// Generated by shadersrc/build_shaders.py; edit the source there.
#define RIM3D_BANDS
#define RIM3D_BAND_VERTEX
layout(location = 6) in vec4 inBandOwner; // @vertex TexCoord3 optional @default = vec4(0.0, 0.0, 0.0, 0.0)

layout(push_constant) uniform Push { mat4 modelMatrix; } push;

layout(set = 0, binding = 0) uniform VertexUniforms
{
    mat4 ViewProj;
} uVertex;

layout(set = 2, binding = 0) uniform MaterialUniforms
{
    vec4 _Volume;                // @default = vec4(18.0, 12.0, 0.0, 1.0)
    vec4 _Rates;                 // @default = vec4(0.0, 0.0, 0.0, 0.0)
    vec4 _Wind;                  // @default = vec4(0.6, 0.25, 1.0, 0.0)
    vec4 _Tint;                  // @color @default = vec4(1.0, 1.0, 1.0, 1.0)
    vec4 _Rim3DCameraPositionCorrection; // global
    vec4 _Rim3DWorldSpaceCameraPos;      // global
    vec4 _Rim3DCameraRight;              // global
    vec4 _Rim3DCameraUp;                 // global
    vec4 _Rim3DRoofMapSize;              // global
    vec4 _Rim3DWeatherFog;               // global
    float _WeatherTime;          // @default = 0.0
    float _Rim3DMapGroundY;      // global
    float _Rim3DRoofHeight;      // global
    float _Rim3DFogDistanceScale; // global

    vec4 _Rim3DBands; // global
    float _Rim3DBandCount; // global

} u;

#ifdef RIM3D_BANDS
// Keep source map coordinates for textures/light maps; stack only the projected position.
vec3 rim3DBandPosition(vec3 p)
{
    if (u._Rim3DBands.x <= 0.0) return p;
    float band = clamp(floor((p.z + (u._Rim3DBands.x - u._Rim3DBands.y) * 0.5) / u._Rim3DBands.x), 0.0, u._Rim3DBandCount - 1.0);
#ifdef RIM3D_BAND_VERTEX
    if (inBandOwner.x > 0.5) band = inBandOwner.x - 1.0;
#endif
    float delta = band - u._Rim3DBands.z;
    return p + vec3(0.0, delta * u._Rim3DBands.w, -delta * u._Rim3DBands.x);
}
bool rim3DBandVisible(vec3 p)
{
    return u._Rim3DBands.x <= 0.0 || (p.z >= 0.0 && p.z < u._Rim3DBandCount * u._Rim3DBands.x && mod(p.z, u._Rim3DBands.x) <= u._Rim3DBands.y + 0.001);
}
#endif
// Waylith stores textures top row first; Unity UVs start at the bottom.
vec2 flipUv(vec2 uv) { return vec2(uv.x, 1.0 - uv.y); }
vec4 tex2D(sampler2D s, vec2 uv) { return texture(s, flipUv(uv)); }

float insideMap(vec2 uv)
{
    return (all(greaterThanEqual(uv, vec2(0.0))) && all(lessThan(uv, vec2(1.0)))) ? 1.0 : 0.0;
}

// RimVision's distance fog; weight blends from the clear-air defaults to the weather's (x linear, y quadratic, z start).
float fogVisibility(float dist, float weight, vec4 weatherFog)
{
    vec3 p = mix(vec3(8.0, 0.012, 0.00012), weatherFog.zxy, weight);
    dist *= clamp(u._Rim3DFogDistanceScale, 0.0, 1.0);
    float d = max(dist - p.x, 0.0);
    return exp(-d * p.y - d * d * p.z);
}

layout(location = 0) in vec3 inPosition; // @vertex Position required
layout(location = 3) in vec4 inUv0;      // @vertex TexCoord0 optional @default = vec4(0.0, 0.0, 0.0, 0.0)

layout(location = 0) out vec2 vUv;
layout(location = 1) out vec3 vWorldPos;
layout(location = 2) out vec4 vKindFade;   // rain, snow, dust flags; alpha
layout(location = 3) out vec3 vShapeAgeRnd; // geometry kind, splash age, random

layout(set = 2, binding = 1) uniform sampler2D _Rim3DRoofMask; // @default = black

void hide(float kind, float rnd)
{
    gl_Position = vec4(0.0, 0.0, 0.0, 1.0);
    vKindFade = vec4(0.0);
    vWorldPos = vec3(0.0);
    vShapeAgeRnd = vec3(kind, 0.0, rnd);
    vUv = vec2(0.0);
}

// Wraps a particle's seed position into the volume that follows the camera.
vec2 wrapToVolume(vec2 seedXz)
{
    vec2 span = vec2(u._Volume.x + u._Volume.x);
    vec2 w = fract((seedXz - push.modelMatrix[3].xz) / span + 0.5);
    return w * span - u._Volume.x;
}

float edgeFade(vec2 local)
{
    float f = clamp((max(abs(local.y), abs(local.x)) - u._Volume.x * 0.75) / (u._Volume.x * 0.25), 0.0, 1.0);
    return 1.0 - f * f * (3.0 - 2.0 * f);
}

void main()
{
    // Each particle picks rain, snow or dust in proportion to the current rates.
    vec3 w = clamp(u._Rates.xyz * vec3(0.85, 0.3, 0.067), 0.0, 1.0);
    float total = max(w.x + w.y + w.z, 0.0001);
    float c1 = w.x / total;
    float c2 = (w.x + w.y) / total;
    float pick = inUv0.w;
    float isRain = pick >= c1 ? 0.0 : 1.0;
    float isDust = pick >= c2 ? 1.0 : 0.0;
    float isSnow = pick >= c2 ? 0.0 : (pick >= c1 ? 1.0 : 0.0);
    float band = isRain * pick / max(c1, 0.0001)
        + isSnow * (pick - c1) / max(c2 - c1, 0.0001)
        + isDust * (pick - c2) / max(1.0 - c2, 0.0001);
    float active = min(total, 1.0) >= band ? 1.0 : 0.0;
    float kind = inPosition.z;
    active *= kind > 0.5 ? isRain : 1.0;
    float rnd = fract(dot(inUv0.xz, vec2(37.0, 19.0)));
    if (active < 0.5)
    {
        hide(kind, rnd);
        return;
    }

    float ownRate = clamp(dot(u._Rates.xyz, vec3(isRain, isSnow, isDust)) * 0.5, 0.0, 1.0);
    float speed = isRain * (ownRate * 5.0 + 17.0) + isSnow * 1.8 + (pick >= c2 ? 0.65 : 0.0);
    speed *= isRain * (rnd * 0.24 - 0.12) + 1.0;

    if (kind > 0.5)
    {
        // Rain splashes: a ring on the ground (kind 1) or an upright puff (kind 2).
        float age = fract(speed * u._WeatherTime / u._Volume.y - inUv0.y - u._Volume.z / u._Volume.y) * u._Volume.y / speed;
        float ring = kind < 1.5 ? 1.0 : 0.0;
        float life = ring > 0.5 ? 0.24 : 0.16;
        float alive = age >= life ? 0.0 : active;
        if (alive < 0.5)
        {
            hide(kind, rnd);
            return;
        }
        vShapeAgeRnd = vec3(kind, age / life, rnd);
        vec2 local = wrapToVolume(inUv0.xz * 8192.0);
        vec2 worldXz = local + push.modelMatrix[3].xz;
        vec2 mapUv = worldXz / u._Rim3DRoofMapSize.xy;
        float open = insideMap(mapUv) * (1.0 - textureLod(_Rim3DRoofMask, flipUv(mapUv), 0.0).x) * alive;
        float size = rnd * 0.08 + 0.16;
        vec3 offset;
        if (ring > 0.5)
            offset = vec3(size * inPosition.x, 0.0, size * inPosition.y);
        else
            offset = u._Rim3DCameraRight.xyz * inPosition.x * size + vec3(0.0, size * (inPosition.y + 0.5) * 0.7, 0.0);
        vec3 localPos = vec3(local.x, offset.y - u._Volume.z, local.y) + vec3(offset.x, 0.025, offset.z);
        vWorldPos = vec3(worldXz.x, offset.y + u._Rim3DMapGroundY, worldXz.y) + vec3(offset.x, 0.025, offset.z);
        vec3 rel = localPos + push.modelMatrix[3].xyz - u._Rim3DWorldSpaceCameraPos.xyz - u._Rim3DCameraPositionCorrection.xyz;
        gl_Position = uVertex.ViewProj * vec4(rel + u._Rim3DWorldSpaceCameraPos.xyz, 1.0);
        vUv = inPosition.xy + 0.5;
        vKindFade = vec4(1.0, 0.0, 0.0, open * edgeFade(vec2(local.x, local.y)));
        return;
    }

    // Falling particles: rain streaks along the fall direction, snow and dust as camera-facing flakes.
    float height = fract(inUv0.y - speed * u._WeatherTime / u._Volume.y) * u._Volume.y;
    vec2 wind = u._Wind.z * u._Wind.xy;
    float drift = isSnow + (pick >= c2 ? 2.0 : 0.0);
    float lead = (height + u._Volume.z) * (pick >= c1 ? 0.0 : 1.5) / speed;
    float windTime = u._WeatherTime * drift - lead;
    vec2 sway = sin(inUv0.yz * 31.0 + u._WeatherTime * 0.7) * (isDust + isSnow) * 0.65;
    vec2 local = wrapToVolume(wind * windTime + sway + inUv0.xz * 8192.0);
    vec3 localPos = vec3(local.x, height, local.y);
    vec3 world = localPos + push.modelMatrix[3].xyz;
    vec2 mapUv = world.xz / u._Rim3DRoofMapSize.xy;
    float inside = insideMap(mapUv);
    float roof = textureLod(_Rim3DRoofMask, flipUv(mapUv), 0.0).x;
    vec2 size = (ownRate * vec2(0.01, 0.32) + vec2(0.018, 0.48)) * isRain;
    size = size * (rnd * vec2(0.35, 0.5) + vec2(0.8, 0.7)) + isSnow * 0.075;
    size = (size + (pick >= c2 ? 0.055 : 0.0)) * u._Volume.w;
    float underRoof = world.y >= size.y * 0.5 + u._Rim3DRoofHeight + 0.03 ? 0.0 : 1.0;
    float visible = active * inside * (1.0 - roof * underRoof);

    vec3 fall = normalize(vec3(-wind.x * 1.5, speed, -wind.y * 1.5));
    vec3 along = mix(u._Rim3DCameraUp.xyz, fall, isRain);
    vec3 offset = u._Rim3DCameraRight.xyz * inPosition.x * size.x + along * inPosition.y * size.y;
    vWorldPos = world + offset;
    gl_Position = uVertex.ViewProj * vec4(rim3DBandPosition(vWorldPos) - u._Rim3DCameraPositionCorrection.xyz, 1.0);
    vUv = inPosition.xy + 0.5;
    float aboveGround = clamp((world.y - u._Rim3DMapGroundY) * 3.0, 0.0, 1.0);
    vKindFade = vec4(isRain, isSnow, isDust, edgeFade(local) * visible * aboveGround);
    vShapeAgeRnd = vec3(kind, 0.0, rnd);
}
