#version 450
// RimVision for RimWorld 1.7: port of Recovery/Rim3D/PreviewSurface from the original Unity shader bundle.
// Generated by shadersrc/build_shaders.py; edit the source there.
#define RIM3D_BANDS

layout(set = 2, binding = 0) uniform MaterialUniforms
{
    vec4 _MainTex_ST;              // @default = vec4(0.0, 0.0, 1.0, 1.0)
    vec4 _Color;                   // @color @default = vec4(1.0, 1.0, 1.0, 1.0)
    vec4 _ColorTwo;                // @color @default = vec4(1.0, 1.0, 1.0, 1.0)
    vec4 _PollutionColor;          // @color @default = vec4(1.0, 1.0, 1.0, 0.0)
    vec4 _PollutionTint;           // @color @default = vec4(1.0, 1.0, 1.0, 1.0)
    vec4 _PollutionScale;          // @default = vec4(1.0, 1.0, 0.0, 0.0)
    vec4 _PollutionScroll;         // @default = vec4(0.0, 0.0, 0.0, 0.0)
    vec4 _SurfaceScale;            // @default = vec4(1.0, 1.0, 0.0, 0.0)
    float _Wetness;                // @default = 0.0
    vec4 _Rim3DCameraPositionCorrection; // global
    vec4 _Rim3DViewRight;          // global
    vec4 _Rim3DRoofMapSize;        // global
    vec4 _Rim3DAmbientColor;       // global
    vec4 _Rim3DIndoorAmbientColor; // global
    vec4 _Rim3DFogColor;           // global
    vec4 _Rim3DIndoorFogColor;     // global
    vec4 _Rim3DSunColor;           // global
    vec4 _Rim3DSunDirection;       // global
    vec4 _Rim3DWeatherFog;         // global
    vec4 _Rim3DWorldSpaceCameraPos;  // global
    float _UseMask;                // @default = 0.0
    float _WeaponVolume;           // @default = 0.0
    float _Ghost;                  // @default = 0.0
    float _Opaque;                 // @default = 1.0
    float _SurfaceOpacity;         // @default = 1.0
    float _Unlit;                  // @default = 0.0
    float _Billboard;              // @default = 0.0
    float _Foliage;                // @default = 0.0
    float _Ground;                 // @default = 0.0
    float _SnowGround;             // @default = 0.0
    float _Pollution;              // @default = 0.0
    float _PollutionBlend;         // @default = 0.0
    float _TerrainEdge;            // @default = 0.0
    float _TerrainRough;           // @default = 0.0
    float _FlatItem;               // @default = 0.0
    float _GroundDecal;            // @default = 0.0
    float _SurfaceTile;            // @default = 0.0
    float _WallSurface;            // @default = 0.0
    float _WallBevel;              // @default = 0.0
    float _SurfaceRepeat;          // @default = 0.0
    float _Rim3DMapGroundY;        // global
    float _Rim3DRoofHeight;        // global
    float _Rim3DTime;              // global, seconds (Unity _Time.y)
    float _Rim3DShaftLightEnabled; // global
    float _Rim3DFogDistanceScale; // global

    vec4 _Rim3DBands; // global
    float _Rim3DBandCount; // global

} u;

#ifdef RIM3D_BANDS
// Keep source map coordinates for textures/light maps; stack only the projected position.
vec3 rim3DBandPosition(vec3 p)
{
    if (u._Rim3DBands.x <= 0.0) return p;
    float band = clamp(floor((p.z + (u._Rim3DBands.x - u._Rim3DBands.y) * 0.5) / u._Rim3DBands.x), 0.0, u._Rim3DBandCount - 1.0);
#ifdef RIM3D_BAND_VERTEX
    if (inBandOwner.x > 0.5) band = inBandOwner.x - 1.0;
#endif
    float delta = band - u._Rim3DBands.z;
    return p + vec3(0.0, delta * u._Rim3DBands.w, -delta * u._Rim3DBands.x);
}
bool rim3DBandVisible(vec3 p)
{
    return u._Rim3DBands.x <= 0.0 || (p.z >= 0.0 && p.z < u._Rim3DBandCount * u._Rim3DBands.x && mod(p.z, u._Rim3DBands.x) <= u._Rim3DBands.y + 0.001);
}
#endif
// Waylith stores textures top row first; Unity UVs start at the bottom.
vec2 flipUv(vec2 uv) { return vec2(uv.x, 1.0 - uv.y); }
vec4 tex2D(sampler2D s, vec2 uv) { return texture(s, flipUv(uv)); }

float insideMap(vec2 uv)
{
    return (all(greaterThanEqual(uv, vec2(0.0))) && all(lessThan(uv, vec2(1.0)))) ? 1.0 : 0.0;
}

// RimVision's distance fog; weight blends from the clear-air defaults to the weather's (x linear, y quadratic, z start).
float fogVisibility(float dist, float weight, vec4 weatherFog)
{
    vec3 p = mix(vec3(8.0, 0.012, 0.00012), weatherFog.zxy, weight);
    dist *= clamp(u._Rim3DFogDistanceScale, 0.0, 1.0);
    float d = max(dist - p.x, 0.0);
    return exp(-d * p.y - d * d * p.z);
}

layout(location = 0) in vec2 vUv;
layout(location = 1) in vec3 vNormal;
layout(location = 2) in vec3 vWorldPos;
layout(location = 3) in vec4 vColor;

layout(location = 0) out vec4 outColor;

layout(set = 2, binding = 1) uniform sampler2D _MainTex;                  // @default = white
layout(set = 2, binding = 2) uniform sampler2D _MaskTex;                  // @default = black
layout(set = 2, binding = 3) uniform sampler2D _Rim3DRoofMask;            // @default = black
layout(set = 2, binding = 4) uniform sampler2D _Rim3DGameLightMap;        // @default = black
layout(set = 2, binding = 5) uniform sampler2D _Rim3DModelLightPositions; // @default = black
layout(set = 2, binding = 6) uniform sampler2D _Rim3DShorelineMask;       // @default = black
layout(set = 2, binding = 7) uniform sampler2D _PollutedTex;              // @default = white
layout(set = 2, binding = 8) uniform sampler2D _PollutionTex;             // @default = black
layout(set = 2, binding = 9) uniform sampler2D _Rim3DSnowDepth;           // @default = black
layout(set = 2, binding = 10) uniform sampler2D _Rim3DSnowTexture;        // @default = white
layout(set = 2, binding = 11) uniform sampler2D _AlphaAddTex;             // @default = gray
layout(set = 2, binding = 12) uniform sampler2D _Rim3DShaftLightPositions; // @default = black
layout(set = 2, binding = 13) uniform sampler2D _Rim3DShaftLightColors;    // @default = black

void main()
{
    if (!rim3DBandVisible(vWorldPos)) discard;
    vec3 P = vWorldPos;

    // Wall surfaces use world-space UVs picked by the dominant normal axis.
    vec2 uv = vUv;
    if (u._WallSurface > 0.5)
    {
        vec3 an = abs(vNormal);
        uv = an.y > 0.5 ? P.xz : (an.x > 0.5 ? P.zy : P.xy);
    }
    if (u._SurfaceTile > 0.5)
    {
        vec2 s = uv * u._SurfaceScale.xy;
        if (u._SurfaceRepeat < 0.5)
            s = fract(s);
        uv = s * u._MainTex_ST.zw + u._MainTex_ST.xy;
    }

    float weaponTint = vColor.a >= 0.25 ? 0.0 : u._WeaponVolume;
    vec4 tex = tex2D(_MainTex, uv);
    // Extruded weapon edges retain the actual adjacent sprite pixel; filtering
    // across transparent padding otherwise makes every side a dark fringe.
    if (u._WeaponVolume > 0.5 && vColor.a >= 0.25 && vColor.a < 0.75) {
        ivec2 size = textureSize(_MainTex, 0);
        tex = texelFetch(_MainTex, clamp(ivec2(flipUv(uv) * vec2(size)), ivec2(0), size - 1), 0);
    }
    if (u._WeaponVolume < 0.5 || vColor.a >= 0.75)
    {
        float a = tex.a * u._Color.a;
        if (u._Opaque * (1.0 - a) + a - 0.25 < 0.0)
            discard;
    }
    tex.rgb = mix(tex.rgb, vec3(1.0), weaponTint);

    vec4 mask = tex2D(_MaskTex, uv);
    vec3 tint = mix(vec3(1.0), u._Color.rgb, mask.r);
    tint = mix(tint, u._ColorTwo.rgb, mask.g);
    tint = mix(u._Color.rgb, tint, u._UseMask);
    tint = mix(tint, vec3(1.0), weaponTint);

    float flatSurface = max(u._FlatItem, u._Ground);
    vec3 N = flatSurface > 0.5 ? vec3(0.0, 1.0, 0.0) : normalize(vNormal);
    vec3 L = normalize(u._Rim3DSunDirection.xyz);
    float diffuse = clamp(dot(N, L), 0.0, 1.0) * 0.7 + 0.3;
    diffuse = mix(diffuse, clamp(u._Rim3DSunDirection.y, 0.0, 1.0) * 0.35 + 0.65, u._Unlit);
    float hemi = clamp(N.y * 0.5 + 0.5, 0.0, 1.0) * 0.38 + 0.62;

    // Roof shading: is the sun ray, or the point straight up, covered by a roof?
    float belowRoof = P.y >= u._Rim3DRoofHeight ? 0.0 : 1.0;
    float rayLength = max(u._Rim3DRoofHeight - P.y, 0.0) / max(L.y, 0.05);
    float bevel = (abs(N.x) >= 0.5 ? 1.0 : 0.0) * u._WallBevel * (abs(N.z) >= 0.5 ? 1.0 : 0.0);
    float offset = (1.0 - flatSurface) * u._Opaque * (bevel * 0.07 + 0.02);
    vec2 samplePos = N.xz * offset + P.xz;
    vec2 sunUv = (L.xz * rayLength + samplePos) / u._Rim3DRoofMapSize.xy;
    float sunRoof = insideMap(sunUv) * tex2D(_Rim3DRoofMask, sunUv).x;
    vec2 upUv = samplePos / u._Rim3DRoofMapSize.xy;
    float roofAbove = insideMap(upUv) * tex2D(_Rim3DRoofMask, upUv).x;
    vec4 shaftPosition = vec4(0.0);
    vec4 shaftGlow = vec4(0.0);
    if (u._Rim3DShaftLightEnabled > 0.5 && insideMap(upUv) > 0.5)
    {
        shaftPosition = tex2D(_Rim3DShaftLightPositions, upUv);
        shaftGlow = tex2D(_Rim3DShaftLightColors, upUv);
        // Portal holes transmit the upper floor's light through the cone below,
        // rather than classifying a complete square floor tile as outdoors.
        roofAbove = max(roofAbove, shaftGlow.a);
    }
    float indoor = roofAbove * belowRoof;
    float outdoor = 1.0 - belowRoof * roofAbove;
    float sun = (1.0 - belowRoof * sunRoof) * outdoor;
    float ambientScale = indoor * -0.68 + 1.0;
    vec3 ambient = mix(u._Rim3DAmbientColor.rgb, u._Rim3DIndoorAmbientColor.rgb, indoor);
    vec3 lit = hemi * ambient * ambientScale + diffuse * u._Rim3DSunColor.rgb * sun;
    lit += u._Rim3DSunColor.rgb * u._Foliage * sun * 0.08;
    vec3 unlitLight = ambient * ambientScale + sun * u._Rim3DSunColor.rgb * 0.38;
    vec3 light = mix(lit, unlitLight, u._Unlit);

    // Colony light sources from the game's glow grid.
    vec2 lightUv = (N.xz * 0.12 + P.xz) / u._Rim3DRoofMapSize.xy;
    float lightInside = insideMap(lightUv);
    // GlowGrid is cell-resolution. Sample a small tent footprint in world
    // units so isolated upper-floor lamps do not expose square texel edges.
    // Keep the native occlusion field and floor's source-map coordinates.
    vec2 glowStep = vec2(0.45) / u._Rim3DRoofMapSize.xy;
    vec3 glow = tex2D(_Rim3DGameLightMap, lightUv).rgb * 0.5;
    glow += tex2D(_Rim3DGameLightMap, lightUv + vec2(glowStep.x, 0.0)).rgb * 0.125;
    glow += tex2D(_Rim3DGameLightMap, lightUv - vec2(glowStep.x, 0.0)).rgb * 0.125;
    glow += tex2D(_Rim3DGameLightMap, lightUv + vec2(0.0, glowStep.y)).rgb * 0.125;
    glow += tex2D(_Rim3DGameLightMap, lightUv - vec2(0.0, glowStep.y)).rgb * 0.125;
    float heightFalloff = exp2(max(P.y - u._Rim3DMapGroundY - 1.0, 0.0) * -0.259685);
    vec4 lightPos = tex2D(_Rim3DModelLightPositions, lightUv);
    vec3 source = lightPos.xyz / max(lightPos.w, 0.0001);
    source.y += u._Rim3DMapGroundY;
    vec3 toLight = normalize(source - P + vec3(0.0, 0.0001, 0.0));
    float lightFacing = clamp(lightPos.w, 0.0, 1.0) * ((clamp(dot(N, toLight), 0.0, 1.0) - 1.0) * 0.85) + 1.0;
    vec3 glowLight = min(glow * 3.6, vec3(1.35)) * lightInside * heightFalloff;
    light = glowLight * lightFacing + light;

    float holeY = u._Rim3DRoofHeight - 0.06;
    if (shaftPosition.z > 0.0 && shaftPosition.w > 0.0 && P.y >= u._Rim3DMapGroundY - 0.03 && P.y < holeY)
    {
        float beamHeight = max(holeY - u._Rim3DMapGroundY, 0.1);
        float down = clamp((holeY - P.y) / beamHeight, 0.0, 1.0);
        vec2 radius = shaftPosition.zw + vec2(0.8 * down);
        float radial = length((P.xz - shaftPosition.xy) / radius);
        float pool = 1.0 - smoothstep(0.45, 1.0, radial);
        vec3 fromHole = normalize(vec3(shaftPosition.x, holeY, shaftPosition.y) - P + vec3(0.0,0.0001,0.0));
        float facing = max(dot(N, fromHole), 0.0);
        // Same lighting accumulator as colony lamps: texture, normal, indoor
        // shading and distance fog remain part of the receiving surface.
        light += shaftGlow.rgb * pool * facing * 0.95;
    }

    vec3 albedo = tex.rgb * tint;

    if (u._Ground > 0.5 && u._Pollution > 0.5)
    {
        float amount = tex2D(_Rim3DShorelineMask, P.xz / u._Rim3DRoofMapSize.xy).y;
        if (amount > 0.001)
        {
            vec3 base = tint * tex2D(_PollutedTex, uv).rgb * u._PollutionTint.rgb;
            vec2 overlayUv = uv * u._PollutionScale.xy + u._PollutionScroll.xy * u._Rim3DTime;
            vec4 overlay = tex2D(_PollutionTex, overlayUv) * u._PollutionColor;
            vec3 sum = base + overlay.rgb;
            vec3 softLight = base * base * (1.0 - 2.0 * overlay.rgb) + base * 2.0 * overlay.rgb;
            vec3 blended = u._PollutionBlend > 0.5 ? clamp(sum, 0.0, 1.0) : clamp(sum - 1.0, 0.0, 1.0);
            blended = u._PollutionBlend > 1.5 ? softLight : blended;
            vec3 polluted = mix(base, blended, clamp(overlay.a, 0.0, 1.0));
            float s = clamp(amount, 0.0, 1.0);
            albedo = mix(albedo, polluted, s * s * (3.0 - 2.0 * s));
        }
    }

    if (u._SnowGround > 0.5 && u._Ground > 0.5)
    {
        float depth = tex2D(_Rim3DSnowDepth, P.xz / u._Rim3DRoofMapSize.xy).x;
        if (depth > 0.01)
        {
            vec3 snow = (tex2D(_Rim3DSnowTexture, P.xz * 0.125).rgb * 0.14 + 0.86) * vec3(0.9, 0.94, 0.98);
            float s = clamp((depth - 0.01) * 2.272727, 0.0, 1.0);
            albedo = mix(albedo, snow, s * s * (3.0 - 2.0 * s));
        }
    }

    vec3 color = light * albedo * vColor.rgb;

    if (u._Wetness > 0.0 && u._Ground > 0.5)
    {
        // Preserve marshy soil's terrain/pollution texture. Patchy still-water
        // reflections sit on the same ground plane, without changing walkability.
        float snow = tex2D(_Rim3DSnowDepth, P.xz / u._Rim3DRoofMapSize.xy).x;
        float pools = sin(P.x * 0.73 + sin(P.z * 0.41)) * sin(P.z * 0.67 + sin(P.x * 0.37)) * 0.5 + 0.5;
        float wet = smoothstep(0.43, 0.76, pools) * u._Wetness * (1.0 - smoothstep(0.0, 0.1, snow));
        vec3 V = normalize(u._Rim3DWorldSpaceCameraPos.xyz + u._Rim3DCameraPositionCorrection.xyz - rim3DBandPosition(P) + vec3(0.0, 0.0001, 0.0));
        float facing = 1.0 - clamp(dot(N, V), 0.0, 1.0);
        float reflection = (0.06 + 0.22 * pow(facing, 5.0)) * wet * outdoor;
        vec3 sky = u._Rim3DFogColor.rgb * 0.55 + u._Rim3DAmbientColor.rgb * 0.25;
        color = mix(color * (1.0 - wet * 0.12), sky, reflection);
        vec3 H = normalize(L + V + vec3(0.0, 0.0001, 0.0));
        color += pow(clamp(dot(N, H), 0.0, 1.0), 64.0) * wet * u._Rim3DSunColor.rgb * sun * 0.35;
    }

    // Distance fog; weather fog only applies outdoors.
    float weatherFog = outdoor * u._Rim3DWeatherFog.w;
    vec3 fogColor = mix(u._Rim3DIndoorFogColor.rgb, u._Rim3DFogColor.rgb, weatherFog);
    float dist = length(rim3DBandPosition(P) - u._Rim3DWorldSpaceCameraPos.xyz - u._Rim3DCameraPositionCorrection.xyz);
    float fog = 1.0 - fogVisibility(dist, weatherFog, u._Rim3DWeatherFog);

    float alpha = u._Ghost > 0.5 ? tex.a * u._Ghost : u._SurfaceOpacity;
    if (u._GroundDecal > 0.5) {
        // Faint filth must still respect its texture alpha. The ghost threshold
        // is intended for other surfaces and made low-opacity decals solid cards.
        alpha = tex.a * clamp(u._Ghost, 0.0, 1.0) * u._SurfaceOpacity;
        vec2 border = min(vUv, vec2(1.0) - vUv);
        vec2 feather = vec2(1.5) / vec2(textureSize(_MainTex, 0));
        alpha *= smoothstep(0.0, feather.x, border.x) * smoothstep(0.0, feather.y, border.y);
        if (alpha < 0.001) discard;
    }
    if (u._TerrainEdge > 0.5)
    {
        float n = (tex2D(_AlphaAddTex, uv * 4.0).x - 0.5) * 2.4 * vColor.a * (1.0 - vColor.a);
        float edge = clamp(n * u._TerrainRough + vColor.a, 0.0, 1.0);
        if (alpha * edge - 0.001 < 0.0)
            discard;
        alpha *= edge;
    }
    outColor = vec4(mix(color, fogColor, fog), alpha);
}
