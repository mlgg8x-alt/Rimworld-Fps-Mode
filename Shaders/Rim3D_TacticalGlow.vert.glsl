#version 450
// RimVision for RimWorld 1.7: port of Recovery/Rim3D/TacticalGlow from the original Unity shader bundle.
// Generated by shadersrc/build_shaders.py; edit the source there.
#define RIM3D_BANDS
#define RIM3D_BAND_VERTEX
layout(location = 6) in vec4 inBandOwner; // @vertex TexCoord3 optional @default = vec4(0.0, 0.0, 0.0, 0.0)

layout(push_constant) uniform Push { mat4 modelMatrix; } push;

layout(set = 0, binding = 0) uniform VertexUniforms
{
    mat4 ViewProj;
} uVertex;

layout(set = 2, binding = 0) uniform MaterialUniforms
{
    vec4 _MainTex_ST; // @default = vec4(0.0, 0.0, 1.0, 1.0)
    vec4 _Color; // @color @default = vec4(0.25, 0.9, 0.65, 0.65)
    vec4 _Rim3DCameraPositionCorrection; // global
    vec4 _Rim3DViewRight; // global
    float _Billboard; // @default = 0.0
    float _Outline; // @default = 0.0
    float _GlowPixels; // @default = 2.5
    float _Phase; // @default = 0.0
    float _Rim3DFogDistanceScale; // global

    vec4 _Rim3DBands; // global
    float _Rim3DBandCount; // global

} u;

#ifdef RIM3D_BANDS
// Keep source map coordinates for textures/light maps; stack only the projected position.
vec3 rim3DBandPosition(vec3 p)
{
    if (u._Rim3DBands.x <= 0.0) return p;
    float band = clamp(floor((p.z + (u._Rim3DBands.x - u._Rim3DBands.y) * 0.5) / u._Rim3DBands.x), 0.0, u._Rim3DBandCount - 1.0);
#ifdef RIM3D_BAND_VERTEX
    if (inBandOwner.x > 0.5) band = inBandOwner.x - 1.0;
#endif
    float delta = band - u._Rim3DBands.z;
    return p + vec3(0.0, delta * u._Rim3DBands.w, -delta * u._Rim3DBands.x);
}
bool rim3DBandVisible(vec3 p)
{
    return u._Rim3DBands.x <= 0.0 || (p.z >= 0.0 && p.z < u._Rim3DBandCount * u._Rim3DBands.x && mod(p.z, u._Rim3DBands.x) <= u._Rim3DBands.y + 0.001);
}
#endif
// Waylith stores textures top row first; Unity UVs start at the bottom.
vec2 flipUv(vec2 uv) { return vec2(uv.x, 1.0 - uv.y); }
vec4 tex2D(sampler2D s, vec2 uv) { return texture(s, flipUv(uv)); }

float insideMap(vec2 uv)
{
    return (all(greaterThanEqual(uv, vec2(0.0))) && all(lessThan(uv, vec2(1.0)))) ? 1.0 : 0.0;
}

// RimVision's distance fog; weight blends from the clear-air defaults to the weather's (x linear, y quadratic, z start).
float fogVisibility(float dist, float weight, vec4 weatherFog)
{
    vec3 p = mix(vec3(8.0, 0.012, 0.00012), weatherFog.zxy, weight);
    dist *= clamp(u._Rim3DFogDistanceScale, 0.0, 1.0);
    float d = max(dist - p.x, 0.0);
    return exp(-d * p.y - d * d * p.z);
}

layout(location = 0) in vec3 inPosition; // @vertex Position required
layout(location = 2) in vec4 inColor; // @vertex Color optional @default = vec4(1.0)
layout(location = 3) in vec4 inUv0; // @vertex TexCoord0 optional @default = vec4(0.0)
layout(location = 4) in vec4 inUv1; // @vertex TexCoord1 optional @default = vec4(0.0)
layout(location = 0) out vec2 vUv;
layout(location = 1) out vec4 vColor;
layout(location = 2) out vec3 vSource;
void main()
{
    vec3 pos = inPosition;
    if (u._Billboard > 0.5) {
        vec2 d = inPosition.xy - inUv1.xy;
        pos = inUv1.xyz + u._Rim3DViewRight.xyz * d.x + vec3(0.0, d.y, 0.0);
    }
    vec3 world = (push.modelMatrix * vec4(pos, 1.0)).xyz;
    vSource = world;
    vec4 clip = uVertex.ViewProj * vec4(rim3DBandPosition(world) - u._Rim3DCameraPositionCorrection.xyz, 1.0);
    // A tiny reversed-depth bias prevents coplanar sprite/ground flicker; walls still occlude.
    clip.z += clip.w * 0.000002;
    gl_Position = clip;
    vUv = inUv0.xy * u._MainTex_ST.zw + u._MainTex_ST.xy;
    vColor = inColor;
}
