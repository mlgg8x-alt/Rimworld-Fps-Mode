#version 450
// RimVision for RimWorld 1.7: port of Recovery/Rim3D/GroundShadow from the original Unity shader bundle.
// Generated by shadersrc/build_shaders.py; edit the source there.
#define RIM3D_BANDS

layout(set = 2, binding = 0) uniform MaterialUniforms
{
    vec4 _MainTex_ST;            // @default = vec4(0.0, 0.0, 1.0, 1.0)
    vec4 _Color;                 // @color @default = vec4(1.0, 1.0, 1.0, 1.0)
    vec4 _ProjectionDirection;   // @default = vec4(0.4, -0.7, 0.4, 0.0)
    vec4 _ShadowRight;           // @default = vec4(1.0, 0.0, 0.0, 0.0)
    vec4 _Rim3DCameraPositionCorrection; // global
    vec4 _Rim3DWorldSpaceCameraPos;      // global
    vec4 _Rim3DRoofMapSize;              // global
    vec4 _Rim3DWeatherFog;               // global
    float _Opaque;               // @default = 1.0
    float _Billboard;            // @default = 0.0
    float _GroundY;              // @default = -9999.988
    float _ShadowLevelsDown;     // @default = 0.0
    float _Rim3DRoofHeight;      // global
    float _Rim3DMapGroundY;      // global
    float _Rim3DShadowOpacity;   // global
    float _Rim3DFogDistanceScale; // global

    vec4 _Rim3DBands; // global
    float _Rim3DBandCount; // global

} u;

#ifdef RIM3D_BANDS
// Keep source map coordinates for textures/light maps; stack only the projected position.
vec3 rim3DBandPosition(vec3 p)
{
    if (u._Rim3DBands.x <= 0.0) return p;
    float band = clamp(floor((p.z + (u._Rim3DBands.x - u._Rim3DBands.y) * 0.5) / u._Rim3DBands.x), 0.0, u._Rim3DBandCount - 1.0);
#ifdef RIM3D_BAND_VERTEX
    if (inBandOwner.x > 0.5) band = inBandOwner.x - 1.0;
#endif
    float delta = band - u._Rim3DBands.z;
    return p + vec3(0.0, delta * u._Rim3DBands.w, -delta * u._Rim3DBands.x);
}
bool rim3DBandVisible(vec3 p)
{
    return u._Rim3DBands.x <= 0.0 || (p.z >= 0.0 && p.z < u._Rim3DBandCount * u._Rim3DBands.x && mod(p.z, u._Rim3DBands.x) <= u._Rim3DBands.y + 0.001);
}
#endif
// Waylith stores textures top row first; Unity UVs start at the bottom.
vec2 flipUv(vec2 uv) { return vec2(uv.x, 1.0 - uv.y); }
vec4 tex2D(sampler2D s, vec2 uv) { return texture(s, flipUv(uv)); }

float insideMap(vec2 uv)
{
    return (all(greaterThanEqual(uv, vec2(0.0))) && all(lessThan(uv, vec2(1.0)))) ? 1.0 : 0.0;
}

// RimVision's distance fog; weight blends from the clear-air defaults to the weather's (x linear, y quadratic, z start).
float fogVisibility(float dist, float weight, vec4 weatherFog)
{
    vec3 p = mix(vec3(8.0, 0.012, 0.00012), weatherFog.zxy, weight);
    dist *= clamp(u._Rim3DFogDistanceScale, 0.0, 1.0);
    float d = max(dist - p.x, 0.0);
    return exp(-d * p.y - d * d * p.z);
}

layout(location = 0) in vec2 vUv;
layout(location = 1) in vec3 vGroundPos;
layout(location = 2) flat in float vSourceBand;

layout(location = 0) out vec4 outColor;

layout(set = 2, binding = 1) uniform sampler2D _MainTex;       // @default = white
layout(set = 2, binding = 2) uniform sampler2D _Rim3DRoofMask; // @default = black
layout(set = 2, binding = 3) uniform sampler2D _Rim3DShorelineMask; // @default = white

bool floorAt(vec2 point)
{
    ivec2 size = textureSize(_Rim3DShorelineMask, 0);
    ivec2 cell = ivec2(floor(point));
    if (any(lessThan(cell, ivec2(0))) || any(greaterThanEqual(cell, size))) return false;
    return texelFetch(_Rim3DShorelineMask, ivec2(cell.x, size.y - 1 - cell.y), 0).b > 0.5;
}

void main()
{
    if (!rim3DBandVisible(vGroundPos)) discard;
    if (u._Rim3DBands.x > 0.0)
    {
        if (vSourceBand - u._ShadowLevelsDown < 0.0 || !floorAt(vGroundPos.xz)) discard;
        vec2 ray = u._ProjectionDirection.xz / max(-u._ProjectionDirection.y, 0.1);
        // A lower-floor projection is visible only through openings in every floor
        // above the receiver, tested along the same sun ray used by the vertices.
        for (int level = 1; level <= int(u._ShadowLevelsDown); level++)
        {
            vec2 above = vGroundPos.xz - float(level) * u._Rim3DBands.w * ray;
            above.y += float(level) * u._Rim3DBands.x;
            if (floorAt(above)) discard;
        }
    }
    // No sun shadows under roofs: the roof already shades the ground.
    float rise = max(u._Rim3DRoofHeight - u._Rim3DMapGroundY, 0.0);
    vec2 sunUv = (vGroundPos.xz - rise * u._ProjectionDirection.xz / max(-u._ProjectionDirection.y, 0.05)) / u._Rim3DRoofMapSize.xy;
    float sunRoof = insideMap(sunUv) * tex2D(_Rim3DRoofMask, sunUv).x;
    vec2 upUv = vGroundPos.xz / u._Rim3DRoofMapSize.xy;
    float roofAbove = insideMap(upUv) * tex2D(_Rim3DRoofMask, upUv).x;
    if (0.5 - max(sunRoof, roofAbove) < 0.0)
        discard;

    vec4 tex = tex2D(_MainTex, vUv);
    float a = tex.a * u._Color.a;
    float coverage = u._Opaque * (1.0 - a) + a;
    if (coverage - 0.15 < 0.0)
        discard;
    float shade = coverage * u._Rim3DShadowOpacity;

    float dist = length(rim3DBandPosition(vGroundPos) - u._Rim3DWorldSpaceCameraPos.xyz - u._Rim3DCameraPositionCorrection.xyz);
    float visibility = fogVisibility(dist, u._Rim3DWeatherFog.w, u._Rim3DWeatherFog);
    outColor = vec4(vec3(1.0 - shade * visibility), 1.0);
}
