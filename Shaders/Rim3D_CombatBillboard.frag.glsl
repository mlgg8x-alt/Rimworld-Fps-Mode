#version 450
// RimVision for RimWorld 1.7: port of Recovery/Rim3D/CombatBillboard from the original Unity shader bundle.
// Generated by shadersrc/build_shaders.py; edit the source there.
#define RIM3D_BANDS

layout(set = 2, binding = 0) uniform MaterialUniforms
{
    vec4 _Color;                 // @color @default = vec4(1.0, 1.0, 1.0, 1.0)
    vec4 _Rim3DCameraPositionCorrection; // global
    vec4 _Rim3DWorldSpaceCameraPos;      // global
    vec4 _Rim3DCameraRight;              // global
    vec4 _Rim3DCameraUp;                 // global
    vec4 _Rim3DWeatherFog;               // global
    float _AlphaBoost;           // @default = 1.0
    float _BlastMode;            // @default = 0.0
    float _BlastAge;             // @default = 0.0
    float _BlastSeed;            // @default = 0.0
    float _Rim3DFogDistanceScale; // global

    vec4 _Rim3DBands; // global
    float _Rim3DBandCount; // global

} u;

#ifdef RIM3D_BANDS
// Keep source map coordinates for textures/light maps; stack only the projected position.
vec3 rim3DBandPosition(vec3 p)
{
    if (u._Rim3DBands.x <= 0.0) return p;
    float band = clamp(floor((p.z + (u._Rim3DBands.x - u._Rim3DBands.y) * 0.5) / u._Rim3DBands.x), 0.0, u._Rim3DBandCount - 1.0);
#ifdef RIM3D_BAND_VERTEX
    if (inBandOwner.x > 0.5) band = inBandOwner.x - 1.0;
#endif
    float delta = band - u._Rim3DBands.z;
    return p + vec3(0.0, delta * u._Rim3DBands.w, -delta * u._Rim3DBands.x);
}
bool rim3DBandVisible(vec3 p)
{
    return u._Rim3DBands.x <= 0.0 || (p.z >= 0.0 && p.z < u._Rim3DBandCount * u._Rim3DBands.x && mod(p.z, u._Rim3DBands.x) <= u._Rim3DBands.y + 0.001);
}
#endif
// Waylith stores textures top row first; Unity UVs start at the bottom.
vec2 flipUv(vec2 uv) { return vec2(uv.x, 1.0 - uv.y); }
vec4 tex2D(sampler2D s, vec2 uv) { return texture(s, flipUv(uv)); }

float insideMap(vec2 uv)
{
    return (all(greaterThanEqual(uv, vec2(0.0))) && all(lessThan(uv, vec2(1.0)))) ? 1.0 : 0.0;
}

// RimVision's distance fog; weight blends from the clear-air defaults to the weather's (x linear, y quadratic, z start).
float fogVisibility(float dist, float weight, vec4 weatherFog)
{
    vec3 p = mix(vec3(8.0, 0.012, 0.00012), weatherFog.zxy, weight);
    dist *= clamp(u._Rim3DFogDistanceScale, 0.0, 1.0);
    float d = max(dist - p.x, 0.0);
    return exp(-d * p.y - d * d * p.z);
}

layout(location = 0) in vec2 vUv;
layout(location = 1) in vec3 vWorldPos;

layout(location = 0) out vec4 outColor;

layout(set = 2, binding = 1) uniform sampler2D _MainTex; // @default = white

float hash21(vec2 i)
{
    return fract(sin(dot(i, vec2(127.1, 311.7))) * 43758.546875);
}

float valueNoise(vec2 q)
{
    vec2 i = floor(q);
    vec2 f = fract(q);
    vec2 w = f * f * (3.0 - 2.0 * f);
    float a = mix(hash21(i), hash21(i + vec2(1.0, 0.0)), w.x);
    float b = mix(hash21(i + vec2(0.0, 1.0)), hash21(i + vec2(1.0, 1.0)), w.x);
    return mix(a, b, w.y);
}

void main()
{
    if (!rim3DBandVisible(vWorldPos)) discard;
    vec3 rgb;
    float alpha;
    if (u._BlastMode > 1.5)
    {
        // Soft round glow.
        float g = max(1.0 - length(vUv * 2.0 - 1.0), 0.0);
        g *= g;
        rgb = (g * 2.0 + 1.0) * u._Color.rgb;
        alpha = g * u._Color.a;
    }
    else if (u._BlastMode > 0.5)
    {
        // Procedural explosion: hot core that cools into smoke as it ages.
        vec2 p = vUv * 2.0 - 1.0;
        float n1 = valueNoise(p * 3.0 + vec2(u._BlastSeed, u._BlastAge * -0.8));
        float n2 = valueNoise(p * 7.0 + vec2(u._BlastSeed * 1.7, u._BlastAge * -1.36));
        float n = n1 * 0.65 + n2 * 0.35;
        float r = length(p);
        float shape = clamp(((n - 0.5) * 0.38 + r - 0.62) * 2.777778, 0.0, 1.0);
        shape = 1.0 - shape * shape * (3.0 - 2.0 * shape);
        float life = clamp(1.0 - u._BlastAge * 1.538462, 0.0, 1.0);
        float heat = clamp((1.0 - r) * life + (n - 0.5) * 0.6, 0.0, 1.0);
        heat = clamp((heat - 0.25) * 1.666667, 0.0, 1.0);
        heat = heat * heat * (3.0 - 2.0 * heat);
        vec3 hot = heat * vec3(1.3, 1.38, 0.335) + vec3(1.1, 0.12, 0.015);
        vec3 smoke = n * vec3(0.235, 0.215, 0.185) + vec3(0.085, 0.075, 0.065);
        float burn = min(life * 2.222222, 1.0);
        burn = burn * burn * (3.0 - 2.0 * burn);
        rgb = mix(smoke, hot * u._Color.rgb, burn);
        alpha = shape * u._Color.a * (life * 0.3 + 0.7);
    }
    else
    {
        vec4 tex = tex2D(_MainTex, vUv);
        rgb = tex.rgb * u._Color.rgb;
        alpha = clamp(tex.a * u._AlphaBoost, 0.0, 1.0) * u._Color.a;
    }
    float dist = length(rim3DBandPosition(vWorldPos) - u._Rim3DWorldSpaceCameraPos.xyz - u._Rim3DCameraPositionCorrection.xyz);
    float visibility = fogVisibility(dist, u._Rim3DWeatherFog.w, u._Rim3DWeatherFog);
    if (alpha * visibility - 0.003 < 0.0)
        discard;
    outColor = vec4(rgb, visibility * alpha);
}
