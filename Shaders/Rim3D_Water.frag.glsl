#version 450
// RimVision for RimWorld 1.7: port of Recovery/Rim3D/Water from the original Unity shader bundle.
// Generated by shadersrc/build_shaders.py; edit the source there.
#define RIM3D_BANDS

layout(set = 2, binding = 0) uniform MaterialUniforms
{
    vec4 _Color;                 // @color @default = vec4(1.0, 1.0, 1.0, 1.0)
    vec4 _ShallowColor;          // @color @default = vec4(0.17, 0.39, 0.38, 1.0)
    vec4 _DeepColor;             // @color @default = vec4(0.055, 0.19, 0.25, 1.0)
    vec4 _Rim3DCameraPositionCorrection; // global
    vec4 _Rim3DWorldSpaceCameraPos;      // global
    vec4 _Rim3DRoofMapSize;              // global
    vec4 _Rim3DWeatherFog;               // global
    vec4 _Rim3DAmbientColor;             // global
    vec4 _Rim3DIndoorAmbientColor;       // global
    vec4 _Rim3DFogColor;                 // global
    vec4 _Rim3DIndoorFogColor;           // global
    vec4 _Rim3DSunColor;                 // global
    vec4 _Rim3DSunDirection;             // global
    float _Depth;                // @default = 0.4
    float _FlowSpeed;            // @default = 0.16
    float _RippleStrength;       // @default = 0.12
    float _WaveHeight;           // @default = 0.09
    float _Rim3DRoofHeight;      // global
    float _Rim3DTime;            // global
    float _Rim3DFogDistanceScale; // global

    vec4 _Rim3DBands; // global
    float _Rim3DBandCount; // global

} u;

#ifdef RIM3D_BANDS
// Keep source map coordinates for textures/light maps; stack only the projected position.
vec3 rim3DBandPosition(vec3 p)
{
    if (u._Rim3DBands.x <= 0.0) return p;
    float band = clamp(floor((p.z + (u._Rim3DBands.x - u._Rim3DBands.y) * 0.5) / u._Rim3DBands.x), 0.0, u._Rim3DBandCount - 1.0);
#ifdef RIM3D_BAND_VERTEX
    if (inBandOwner.x > 0.5) band = inBandOwner.x - 1.0;
#endif
    float delta = band - u._Rim3DBands.z;
    return p + vec3(0.0, delta * u._Rim3DBands.w, -delta * u._Rim3DBands.x);
}
bool rim3DBandVisible(vec3 p)
{
    return u._Rim3DBands.x <= 0.0 || (p.z >= 0.0 && p.z < u._Rim3DBandCount * u._Rim3DBands.x && mod(p.z, u._Rim3DBands.x) <= u._Rim3DBands.y + 0.001);
}
#endif
// Waylith stores textures top row first; Unity UVs start at the bottom.
vec2 flipUv(vec2 uv) { return vec2(uv.x, 1.0 - uv.y); }
vec4 tex2D(sampler2D s, vec2 uv) { return texture(s, flipUv(uv)); }

float insideMap(vec2 uv)
{
    return (all(greaterThanEqual(uv, vec2(0.0))) && all(lessThan(uv, vec2(1.0)))) ? 1.0 : 0.0;
}

// RimVision's distance fog; weight blends from the clear-air defaults to the weather's (x linear, y quadratic, z start).
float fogVisibility(float dist, float weight, vec4 weatherFog)
{
    vec3 p = mix(vec3(8.0, 0.012, 0.00012), weatherFog.zxy, weight);
    dist *= clamp(u._Rim3DFogDistanceScale, 0.0, 1.0);
    float d = max(dist - p.x, 0.0);
    return exp(-d * p.y - d * d * p.z);
}

layout(location = 0) in vec3 vWorldPos;

layout(location = 0) out vec4 outColor;

layout(set = 2, binding = 1) uniform sampler2D _Rim3DShorelineMask; // @default = black
layout(set = 2, binding = 2) uniform sampler2D _Rim3DRoofMask;      // @default = black
layout(set = 2, binding = 3) uniform sampler2D _Rim3DGameLightMap;  // @default = black

void main()
{
    if (!rim3DBandVisible(vWorldPos)) discard;
    vec3 P = vWorldPos;
    vec3 L = normalize(u._Rim3DSunDirection.xyz);
    vec2 mapUv = P.xz / u._Rim3DRoofMapSize.xy;
    float shoreRaw = tex2D(_Rim3DShorelineMask, mapUv).x;
    float depthBlend = smoothstep(0.0, 1.0, clamp((shoreRaw - 0.5) * 2.222222, 0.0, 1.0));

#ifndef RIM3D_SIMPLE_WATER
    // Ripples, faded out where they would alias.
    float flow = u._FlowSpeed * u._Rim3DTime;
    float a0 = dot(P.xz, vec2(1.7, 0.8)) - u._Rim3DTime * u._FlowSpeed;
    float a1 = dot(P.xz, vec2(-0.9, 2.1)) + flow * 0.73;
    float a2 = dot(P.xz, vec2(3.2, 2.6)) - flow * 1.19;
    vec3 fade = max(1.0 - (abs(dFdx(vec3(a1, a2, a0))) + abs(dFdy(vec3(a1, a2, a0)))) * 0.45, 0.0);
    vec3 s = sin(vec3(a1, a2, a0));
    vec3 sf = s * fade;
    vec2 ripple;
    ripple.x = s.z * fade.z + sf.x * -0.55 + sf.y * 0.3;
    ripple.y = s.x * fade.x + sf.z * 0.47 + sf.y * 0.24;
    float shimmer = sf.x * sf.z * 0.055 + 1.0;

    float t = u._Rim3DTime;
    vec3 phase = vec3(
        dot(P.xz, vec2(0.85, 0.38)) - t * 1.05,
        dot(P.xz, vec2(-0.48, 1.3)) - t * 1.32,
        dot(P.xz, vec2(1.9, 1.45)) + t * 1.76);
    vec3 ws = sin(phase) * u._WaveHeight;
    vec3 wc = cos(phase) * u._WaveHeight * vec3(0.58, 0.28, 0.14);
    float shore = smoothstep(0.0, 1.0, clamp((shoreRaw - 0.75) * 4.0, 0.0, 1.0)) * 0.5;
    float waveHeight = (ws.x * 0.58 + ws.y * 0.28 + ws.z * 0.14) * shore;
    float slopeX = dot(wc, vec3(0.85, -0.48, 1.9)) * shore;
    float slopeZ = dot(wc, vec3(0.38, 1.3, 1.45)) * shore;
    vec3 N = normalize(vec3(ripple.x * u._RippleStrength - slopeX, 1.0, ripple.y * u._RippleStrength - slopeZ));
    float brightness = waveHeight * 0.65 + shimmer;
#else
    vec3 N = vec3(0.0, 1.0, 0.0);
    float brightness = 1.0;
#endif

    float diffuse = clamp(dot(N, L), 0.0, 1.0) * 0.7 + 0.3;
    float rayLength = max(u._Rim3DRoofHeight - P.y, 0.0) / max(L.y, 0.05);
    vec2 sunUv = (L.xz * rayLength + P.xz) / u._Rim3DRoofMapSize.xy;
    float sunRoof = insideMap(sunUv) * tex2D(_Rim3DRoofMask, sunUv).x;
    float belowRoof = P.y >= u._Rim3DRoofHeight ? 0.0 : 1.0;
    float roofAbove = insideMap(mapUv) * tex2D(_Rim3DRoofMask, mapUv).x;
    float outdoor = 1.0 - belowRoof * roofAbove;
    float indoor = belowRoof * roofAbove;
    float sun = (1.0 - belowRoof * sunRoof) * outdoor;
    float sunUp = clamp(L.y * 8.0, 0.0, 1.0);
    vec3 ambient = mix(u._Rim3DAmbientColor.rgb, u._Rim3DIndoorAmbientColor.rgb, indoor);
    vec3 light = ambient * (indoor * -0.68 + 1.0) + diffuse * u._Rim3DSunColor.rgb * sun;
    light += min(tex2D(_Rim3DGameLightMap, mapUv).rgb * 3.6, vec3(1.35));

    vec3 water = mix(u._ShallowColor.rgb, u._DeepColor.rgb, depthBlend * u._Depth) * u._Color.rgb * brightness;
    vec3 base = light * water;

    vec3 toEye = u._Rim3DWorldSpaceCameraPos.xyz + u._Rim3DCameraPositionCorrection.xyz - rim3DBandPosition(P);
    float dist = length(toEye);
    vec3 V = toEye / max(dist, 0.001);
    float reflectY = clamp(N.y * (2.0 * dot(V, N)) - V.y, 0.0, 1.0);
    vec3 sky = mix(u._Rim3DFogColor.rgb * 0.8, u._Rim3DAmbientColor.rgb * 0.38 + u._Rim3DFogColor.rgb * 0.45, reflectY);
    float facing = 1.0 - clamp(dot(N, V), 0.0, 1.0);
    float fresnel = (facing * facing * facing * facing * facing * 0.68 + 0.06) * outdoor;
    vec3 color = mix(base, sky, fresnel);

    vec3 H = normalize(L + V + vec3(0.0, 0.0001, 0.0));
    float power = min(dist * 0.025, 1.0) * -72.0 + 96.0;
    float spec = pow(clamp(dot(N, H), 0.0, 1.0), power);
    color += spec * u._Rim3DSunColor.rgb * sun * 0.55 * sunUp;

    float weatherFog = outdoor * u._Rim3DWeatherFog.w;
    vec3 fogColor = mix(u._Rim3DIndoorFogColor.rgb, u._Rim3DFogColor.rgb, weatherFog);
    float fog = 1.0 - fogVisibility(dist, weatherFog, u._Rim3DWeatherFog);
    outColor = vec4(mix(color, fogColor, fog), depthBlend);
}
