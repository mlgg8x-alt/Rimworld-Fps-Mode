+/// A wind turbine `span` cells across: its tower, nacelle and hub, and three blades as runs
+/// of small boxes out from the hub, one straight up.
+fn wind_turbine(span: f32) -> Vec<Local> {
+    let block = 1.0 / (span * CELL as f32);
+    let (hub, reach) = (7.0, 4.8);
+    let mut parts = vec![
+        [0.5 - 0.25 * block, 0.0, 0.42, 0.5 + 0.25 * block, hub, 0.58],
+        [0.5 - 0.45 * block, hub - 0.4, 0.3, 0.5 + 0.45 * block, hub + 0.4, 0.82],
+        [0.5 - 0.3 * block, hub - 0.25, 0.82, 0.5 + 0.3 * block, hub + 0.25, 0.9],
+    ];
+    for angle in [90.0_f32, 210.0, 330.0] {
+        let (cos, sin) = (angle.to_radians().cos(), angle.to_radians().sin());
+        let steps = 10;
+        for i in 0..steps {
+            let r = (i as f32 + 0.5) / steps as f32 * reach;
+            let half = 0.28 * (1.0 - 0.6 * i as f32 / steps as f32);
+            let (u, y) = (0.5 + r * cos * block, hub + r * sin);
+            parts.push([u - half * block, y - half, 0.84, u + half * block, y + half, 0.88]);
+        }
+    }
+    parts
+}
