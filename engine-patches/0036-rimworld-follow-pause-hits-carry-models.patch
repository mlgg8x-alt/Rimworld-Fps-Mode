+/// M18: while RimWorld is paused the MW2 player is held still (the input obeys
+/// `frame::RimHold`), and RimWorld hears when MW2's Escape menu opens and closes, so its
+/// minimap window hides from in front of the menu.
+fn hold_and_menu(
+    floor: Res<FlatFloor>,
+    link: Option<Res<RimworldLink>>,
+    outbox: Option<Res<RimworldOutbox>>,
+    hud_input: Option<Res<frame::HudInputView>>,
+    mut hold: ResMut<frame::RimHold>,
+    mut told: Local<Option<bool>>,
+) {
+    let connected = floor.active && link.as_deref().is_some_and(|link| link.connected);
+    let paused = connected && link.as_deref().is_some_and(|link| link.paused);
+    if hold.paused != paused {
+        hold.paused = paused;
+        println!("[rimworld] RimWorld {}: the player is {}", if paused { "paused" } else { "running" }, if paused { "held still" } else { "free" });
+    }
+    if !connected {
+        *told = None;
+        return;
+    }
+    let open = hud_input.is_some_and(|input| input.script_menu_open);
+    if *told != Some(open)
+        && let Some(outbox) = outbox.as_deref()
+        && outbox.send(&BridgeMessage::Menu { open })
+    {
+        *told = Some(open);
+    }
+}
