+/// RimWorld's path cost of every cell (M17), in [`Terrain`]'s order: ticks a pawn takes on
+/// top of its own to walk into it; [`Costs::IMPASSABLE`] where pawns cannot go.
+#[derive(Debug, Clone, PartialEq)]
+pub struct Costs {
+    pub size: [i32; 2],
+    pub cells: Vec<u16>,
+}
+
+impl Costs {
+    pub const IMPASSABLE: u16 = 1001;
+
+    /// From `costs`' characters: `'0'` plus the cost.
+    pub fn new(size: [i32; 2], cells: &str) -> Self {
+        Self { size, cells: cells.chars().map(|c| (u32::from(c).saturating_sub(u32::from('0'))).min(u32::from(Self::IMPASSABLE)) as u16).collect() }
+    }
+
+    /// The cost of cell `(x, z)`; none off the map.
+    pub fn at(&self, x: i32, z: i32) -> Option<u16> {
+        let [sx, sz] = self.size;
+        if !(0..sx).contains(&x) || !(0..sz).contains(&z) {
+            return None;
+        }
+        self.cells.get((z * sx + x) as usize).copied()
+    }
+}
