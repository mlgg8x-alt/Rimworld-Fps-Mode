+/// Which soldier slot dresses each of `people`: the one they had, else a free one, while
+/// there are `slots`; the rest wear the kit as it is.
+fn dress_slots<'a>(had: &HashMap<String, usize>, people: impl Iterator<Item = &'a String>, slots: usize) -> HashMap<String, usize> {
+    let mut people: Vec<&String> = people.collect();
+    people.sort();
+    let mut dress: HashMap<String, usize> = people
+        .iter()
+        .filter_map(|id| had.get(*id).filter(|slot| **slot < slots).map(|slot| ((*id).clone(), *slot)))
+        .collect();
+    let mut free = (0..slots).filter(|slot| !dress.values().any(|taken| taken == slot)).collect::<Vec<_>>().into_iter();
+    for id in people {
+        if dress.contains_key(id) {
+            continue;
+        }
+        let Some(slot) = free.next() else { break };
+        dress.insert(id.clone(), slot);
+    }
+    dress
+}
