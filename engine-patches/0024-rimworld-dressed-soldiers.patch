+                link.looks = Some(Arc::new(looks.into_iter().map(|look| (look.id.clone(), look)).collect()));
+                link.looks_revision += 1;
+            }
             // Messages for RimWorld, not for the engine.
             BridgeEvent::Received(_) => {}
         }
diff --git a/crates/rimworld_world/src/dress.rs b/crates/rimworld_world/src/dress.rs
new file mode 100644
index 0000000..cb3e882
--- /dev/null
+++ b/crates/rimworld_world/src/dress.rs
@@ -0,0 +1,361 @@
+//! M7: MW2 soldiers in RimWorld people's colours.
+//!
+//! Each person RimWorld describes in `looks` gets one of the soldier slots the loader made
+//! ([`assets::rimworld_soldiers`]): a copy of the soldier kit whose colour maps are pictures
+//! of their own. A slot's pictures are the MW2 originals repainted part by part: skin where
+//! the original shows skin (face, hands, and anything bare), each body part in the colour
+//! of the outermost thing the person wears over it, as RimWorld draws it, keeping MW2's
+//! shading, folds and seams.
+use std::collections::HashMap;
+use std::sync::Arc;
+
+use assets::rimworld_soldiers::{BodyPart, LABEL_SIZE, SlotSource, SoldierSlots, slot_image};
+use bevy::asset::RenderAssetUsages;
+use bevy::prelude::*;
+use bevy::render::render_resource::{Extent3d, TextureDimension, TextureFormat};
+use rimworld_bridge::{LookState, RimworldLink};
+
+use crate::FlatFloor;
+
+/// Slots repainted a frame, at most: a repaint goes through every texel of a soldier.
+const REPAINTS_PER_FRAME: usize = 2;
+/// Pictures larger than this a side are repainted at half size (or less) to keep it quick.
+const MAX_SIDE: u32 = 1024;
+
+/// The RimWorld body part groups that cover each part, most specific first.
+fn groups(part: BodyPart) -> &'static [&'static str] {
+    match part {
+        BodyPart::Head => &["FullHead", "UpperHead"],
+        BodyPart::Torso | BodyPart::None => &["Torso"],
+        BodyPart::Arms => &["Arms", "Shoulders"],
+        BodyPart::Hands => &["Hands"],
+        BodyPart::Legs => &["Legs"],
+        BodyPart::Feet => &["Feet"],
+    }
+}
+
+/// What a part of a person shows: worn colour, bare skin, or MW2's own (boots, when
+/// RimWorld has none).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) enum Cover {
+    Worn([u8; 3]),
+    Skin,
+    Original,
+}
+
+/// The colour of the outermost thing `look` wears over `part`, else what shows there.
+/// `colour_of` gives a worn thing's colour as RimWorld draws it (its picture's mean),
+/// falling back to its stated colour.
+pub(crate) fn cover(look: &LookState, part: BodyPart, colour_of: &dyn Fn(i32) -> Option<[u8; 3]>) -> Cover {
+    let worn = look
+        .wear
+        .iter()
+        .rev()
+        .find(|wear| wear.parts.iter().any(|group| groups(part).contains(&group.as_str())));
+    match worn {
+        Some(wear) => Cover::Worn(colour_of(wear.tex).unwrap_or(wear.color)),
+        None => match part {
+            // Under no hat: hair, or a bald head.
+            BodyPart::Head => look.hair.map_or(Cover::Skin, Cover::Worn),
+            BodyPart::Feet => Cover::Original,
+            _ => Cover::Skin,
+        },
+    }
+}
+
+fn luma(p: &[u8]) -> f32 {
+    (0.299 * f32::from(p[0]) + 0.587 * f32::from(p[1]) + 0.114 * f32::from(p[2])) / 255.0
+}
+
+/// Whether a texel looks like skin: warm, somewhat saturated, not dark.
+pub(crate) fn skin_like(p: &[u8]) -> bool {
+    let [r, g, b] = [f32::from(p[0]), f32::from(p[1]), f32::from(p[2])].map(|v| v / 255.0);
+    let max = r.max(g).max(b);
+    let min = r.min(g).min(b);
+    let saturation = if max > 0.0 { (max - min) / max } else { 0.0 };
+    r >= g && g >= b * 0.9 && max > 0.25 && (0.12..=0.7).contains(&saturation) && r - b > 0.06
+}
+
+/// `source` (RGBA, `width` by `height`) repainted for `look`: each texel's part from
+/// `parts` ([`LABEL_SIZE`] square), in its cover's colour times the texel's brightness
+/// over its part's mean, so MW2's shading stays. Skin shows where a head or hand texel
+/// looks like skin, and wherever nothing is worn.
+pub(crate) fn repaint(
+    width: u32,
+    height: u32,
+    source: &[u8],
+    parts: &[u8],
+    head_model: bool,
+    look: &LookState,
+    colour_of: &dyn Fn(i32) -> Option<[u8; 3]>,
+) -> Vec<u8> {
+    let part_at = |x: u32, y: u32| -> BodyPart {
+        let lx = (x * LABEL_SIZE / width.max(1)).min(LABEL_SIZE - 1);
+        let ly = (y * LABEL_SIZE / height.max(1)).min(LABEL_SIZE - 1);
+        match BodyPart::from_u8(parts.get((ly * LABEL_SIZE + lx) as usize).copied().unwrap_or(0)) {
+            BodyPart::None if head_model => BodyPart::Head,
+            BodyPart::None => BodyPart::Torso,
+            part => part,
+        }
+    };
+    let bare = |part: BodyPart, p: &[u8]| matches!(part, BodyPart::Head | BodyPart::Hands) && skin_like(p);
+    // Each kind of texel's mean brightness, so a repaint keeps the picture's shading
+    // around the new colour instead of darkening it.
+    let mut sums: HashMap<(u8, bool), (f32, u32)> = HashMap::new();
+    for y in 0..height {
+        for x in 0..width {
+            let i = ((y * width + x) * 4) as usize;
+            let Some(p) = source.get(i..i + 4) else { continue };
+            let part = part_at(x, y);
+            let entry = sums.entry((part as u8, bare(part, p))).or_default();
+            entry.0 += luma(p);
+            entry.1 += 1;
+        }
+    }
+    let means: HashMap<(u8, bool), f32> =
+        sums.into_iter().map(|(key, (sum, n))| (key, (sum / n.max(1) as f32).max(0.05))).collect();
+    let covers: HashMap<u8, Cover> = [BodyPart::Head, BodyPart::Torso, BodyPart::Arms, BodyPart::Hands, BodyPart::Legs, BodyPart::Feet]
+        .into_iter()
+        .map(|part| (part as u8, cover(look, part, colour_of)))
+        .collect();
+    let mut out = source.to_vec();
+    for y in 0..height {
+        for x in 0..width {
+            let i = ((y * width + x) * 4) as usize;
+            let Some(p) = source.get(i..i + 4) else { continue };
+            let part = part_at(x, y);
+            let skin = bare(part, p);
+            let colour = match (skin, covers.get(&(part as u8)).copied().unwrap_or(Cover::Original)) {
+                (true, _) | (false, Cover::Skin) => look.skin,
+                (false, Cover::Worn(colour)) => colour,
+                (false, Cover::Original) => continue,
+            };
+            let mean = means.get(&(part as u8, skin)).copied().unwrap_or(0.5);
+            let shade = (luma(p) / mean).clamp(0.35, 1.6);
+            for c in 0..3 {
+                out[i + c] = (f32::from(colour[c]) * shade).round().clamp(0.0, 255.0) as u8;
+            }
+        }
+    }
+    out
+}
+
+/// The mean colour of a picture's solid texels.
+pub(crate) fn solid_mean(rgba: &[u8]) -> Option<[u8; 3]> {
+    let mut sum = [0u64; 3];
+    let mut n = 0u64;
+    for p in rgba.chunks_exact(4).filter(|p| p[3] >= 128) {
+        for c in 0..3 {
+            sum[c] += u64::from(p[c]);
+        }
+        n += 1;
+    }
+    (n > 0).then(|| sum.map(|total| (total / n) as u8))
+}
+
+/// Halves a picture until its sides fit [`MAX_SIDE`].
+fn fit(width: u32, height: u32, rgba: Vec<u8>) -> (u32, u32, Vec<u8>) {
+    let (mut w, mut h, mut pixels) = (width, height, rgba);
+    while w.max(h) > MAX_SIDE && w > 1 && h > 1 {
+        let (nw, nh) = (w / 2, h / 2);
+        let mut next = vec![0u8; (nw * nh * 4) as usize];
+        for y in 0..nh {
+            for x in 0..nw {
+                for c in 0..4 {
+                    let at = |dx: u32, dy: u32| u32::from(pixels[(((y * 2 + dy) * w + x * 2 + dx) * 4 + c) as usize]);
+                    next[((y * nw + x) * 4 + c) as usize] = ((at(0, 0) + at(1, 0) + at(0, 1) + at(1, 1)) / 4) as u8;
+                }
+            }
+        }
+        (w, h, pixels) = (nw, nh, next);
+    }
+    (w, h, pixels)
+}
+
+/// Each MW2 original by image name, decoded once (`width, height, RGBA`); `None` when it
+/// could not be.
+type Originals = HashMap<String, Option<Arc<(u32, u32, Vec<u8>)>>>;
+
+/// What the dressing remembers between frames.
+#[derive(Default)]
+pub(crate) struct Wardrobe {
+    /// The image handles' generation the paint went on; a new match starts over.
+    generation: Option<String>,
+    /// What each slot was last painted for.
+    painted: HashMap<usize, String>,
+    /// Each MW2 original, decoded once; `None` when it could not be.
+    originals: Originals,
+    /// Each RimWorld apparel picture's mean colour.
+    apparel: HashMap<i32, Option<[u8; 3]>>,
+}
+
+/// A look's fingerprint, so a slot is repainted only when what it shows changed.
+fn fingerprint(look: &LookState) -> String {
+    format!("{:?}{:?}{:?}", look.skin, look.hair, look.wear.iter().map(|w| (&w.def, w.color, w.tex, &w.parts)).collect::<Vec<_>>())
+}
+
+/// Repaints the slots of people whose look changed (a few a frame).
+pub(crate) fn dress_soldiers(
+    floor: Res<FlatFloor>,
+    link: Option<Res<RimworldLink>>,
+    handles: Option<Res<assets::image_handles::RuntimeImageHandles>>,
+    mut images: ResMut<Assets<Image>>,
+    mut wardrobe: Local<Wardrobe>,
+) {
+    let (Some(link), Some(handles)) = (link, handles) else { return };
+    let Some(slots) = assets::rimworld_soldiers::soldier_slots() else { return };
+    let generation = format!("{:?}", handles.generation_id);
+    if wardrobe.generation.as_ref() != Some(&generation) {
+        wardrobe.painted.clear();
+        wardrobe.originals.clear();
+        wardrobe.generation = Some(generation);
+    }
+    let Some(looks) = link.looks.as_deref() else { return };
+    let textures = link.textures.clone();
+    let mut repaints = 0;
+    let mut dressed: Vec<(&String, &usize)> = floor.dress.iter().collect();
+    dressed.sort();
+    for (pawn, &slot) in dressed {
+        if repaints >= REPAINTS_PER_FRAME {
+            break;
+        }
+        let Some(look) = looks.get(pawn) else { continue };
+        let print = fingerprint(look);
+        if wardrobe.painted.get(&slot) == Some(&print) {
+            continue;
+        }
+        repaints += 1;
+        let Wardrobe { originals, apparel, .. } = &mut *wardrobe;
+        // Apparel pictures this look needs, read first.
+        for wear in &look.wear {
+            apparel.entry(wear.tex).or_insert_with(|| {
+                let textures = textures.as_ref()?;
+                let name = textures.names.get(usize::try_from(wear.tex).ok()?)?;
+                let picture = image::open(format!("{}/{name}.png", textures.dir)).ok()?.to_rgba8();
+                solid_mean(picture.as_raw())
+            });
+        }
+        let colour_of = |tex: i32| apparel.get(&tex).copied().flatten();
+        paint_slot(&slots, slot, look, &colour_of, originals, &handles, &mut images);
+        wardrobe.painted.insert(slot, print);
+    }
+}
+
+fn paint_slot(
+    slots: &SoldierSlots,
+    slot: usize,
+    look: &LookState,
+    colour_of: &dyn Fn(i32) -> Option<[u8; 3]>,
+    originals: &mut Originals,
+    handles: &assets::image_handles::RuntimeImageHandles,
+    images: &mut Assets<Image>,
+) {
+    for source in &slots.sources {
+        let Some(original) = original_of(source, originals) else { continue };
+        let name = slot_image(slot, source);
+        let Some(handle) = handles
+            .material_names
+            .iter()
+            .position(|known| *known == name || known.ends_with(&name))
+            .and_then(|index| handles.material_images.get(index)?.clone())
+        else {
+            diag::warn!(Zone, "rimworld: no picture {name} to dress a soldier in");
+            continue;
+        };
+        let (width, height, pixels) = &*original;
+        let painted = repaint(*width, *height, pixels, &source.parts, source.head, look, colour_of);
+        let image = Image::new(
+            Extent3d { width: *width, height: *height, depth_or_array_layers: 1 },
+            TextureDimension::D2,
+            painted,
+            TextureFormat::Rgba8UnormSrgb,
+            RenderAssetUsages::RENDER_WORLD,
+        );
+        let _ = images.insert(handle.id(), image);
+    }
+}
+
+/// The MW2 picture a slot source repaints, decoded once (from the zone at load, else from
+/// the game's archives by name).
+fn original_of(
+    source: &SlotSource,
+    originals: &mut Originals,
+) -> Option<Arc<(u32, u32, Vec<u8>)>> {
+    originals
+        .entry(source.image.clone())
+        .or_insert_with(|| {
+            let (width, height, rgba) = match source.rgba.as_deref() {
+                Some(decoded) => decoded.clone(),
+                None => {
+                    let games = asset_transport::games_root_from_env().ok()?;
+                    match asset_material::decode_ui_image(&games.0, &source.image) {
+                        Ok(Some(decoded)) => decoded,
+                        other => {
+                            diag::warn!(Zone, "rimworld: soldier picture {} could not be read: {other:?}", source.image);
+                            return None;
+                        }
+                    }
+                }
+            };
+            Some(Arc::new(fit(width, height, rgba)))
+        })
+        .clone()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use rimworld_bridge::WearState;
+
+    fn wear(parts: &[&str], color: [u8; 3]) -> WearState {
+        WearState {
+            def: "Apparel".into(),
+            color,
+            tex: -1,
+            layer: "OnSkin".into(),
+            parts: parts.iter().map(|part| (*part).to_owned()).collect(),
+        }
+    }
+
+    fn look() -> LookState {
+        LookState {
+            id: "Human1".into(),
+            skin: [220, 180, 150],
+            hair: Some([40, 30, 20]),
+            wear: vec![wear(&["Torso", "Shoulders", "Arms"], [200, 0, 0]), wear(&["Legs"], [0, 0, 200]), wear(&["Torso"], [0, 200, 0])],
+        }
+    }
+
+    #[test]
+    fn the_outermost_cover_shows() {
+        let none = |_: i32| None;
+        assert_eq!(cover(&look(), BodyPart::Torso, &none), Cover::Worn([0, 200, 0]), "the jacket over the shirt");
+        assert_eq!(cover(&look(), BodyPart::Arms, &none), Cover::Worn([200, 0, 0]), "the shirt's sleeves");
+        assert_eq!(cover(&look(), BodyPart::Legs, &none), Cover::Worn([0, 0, 200]));
+        assert_eq!(cover(&look(), BodyPart::Hands, &none), Cover::Skin, "no gloves");
+        assert_eq!(cover(&look(), BodyPart::Head, &none), Cover::Worn([40, 30, 20]), "hair under no hat");
+        assert_eq!(cover(&look(), BodyPart::Feet, &none), Cover::Original);
+        assert_eq!(cover(&look(), BodyPart::Torso, &|_| Some([1, 2, 3])), Cover::Worn([1, 2, 3]), "as drawn");
+    }
+
+    #[test]
+    fn a_repaint_takes_the_cover_colour_and_keeps_shading() {
+        // Two torso texels of a 2 by 1 picture, one darker.
+        let source = [100, 100, 100, 255, 50, 50, 50, 255];
+        let parts = vec![BodyPart::Torso as u8; (LABEL_SIZE * LABEL_SIZE) as usize];
+        let out = repaint(2, 1, &source, &parts, false, &look(), &|_| None);
+        assert_eq!(&out[0..4], &[0, 255, 0, 255], "brighter than the mean");
+        assert!(out[5] < 200 && out[5] > 100, "darker stays darker: {}", out[5]);
+        assert_eq!(out[4], 0);
+    }
+
+    #[test]
+    fn skin_shows_on_hands_and_faces() {
+        assert!(skin_like(&[210, 160, 130, 255]));
+        assert!(!skin_like(&[90, 110, 70, 255]), "olive drab");
+        let source = [210, 160, 130, 255];
+        let parts = vec![BodyPart::Hands as u8; (LABEL_SIZE * LABEL_SIZE) as usize];
+        let out = repaint(1, 1, &source, &parts, false, &look(), &|_| None);
+        assert_eq!(&out[0..3], &[220, 180, 150]);
+    }
+}
