+/// A model composed under another name than its geometry's (a retextured copy, see
+/// `MapXModelSceneCatalog::retexture`) wears that name's materials, not the original's.
+fn materials_by_composed_name(
+    catalog: &asset_world::MapXModelSceneCatalog,
+    state: &xmodel_runtime::DObjSemanticState,
+    skels: &[&asset_model::ModelSkel],
+    surfaces: &[PosedModelSurface],
+    materials: &mut [Option<assets::MaterialIndex>],
+) {
+    let renamed = |model: usize| {
+        let name = &state.composition.models.get(model)?.model;
+        (skels.get(model)?.name != *name).then(|| asset_world::MapXModelAssetKey(name.clone()))
+    };
+    for (surface, material) in surfaces.iter().zip(materials.iter_mut()) {
+        if let Some(key) = renamed(usize::from(surface.model)) {
+            *material = catalog.surface_material(&key, surface.surface_index);
+        }
+    }
+}
