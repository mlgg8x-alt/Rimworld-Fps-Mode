+/// Players who carry only the guns they were given: the Minecraft map's
+/// extra guns (see `item::sustain_block_world_arsenal`) skip them.
+static OWN_GUNS_ONLY: RwLock<Vec<u32>> = RwLock::new(Vec::new());
+
+pub fn set_own_guns_only(clients: Vec<u32>) {
+    if let Ok(mut held) = OWN_GUNS_ONLY.write() {
+        *held = clients;
+    }
+}
+
+pub(crate) fn own_guns_only(client: u32) -> bool {
+    OWN_GUNS_ONLY.read().is_ok_and(|held| held.contains(&client))
+}
