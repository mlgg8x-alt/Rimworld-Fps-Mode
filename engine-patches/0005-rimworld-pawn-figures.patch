+/// A pawn's figure as it should look now, standing on its RimWorld cell.
+fn figure_of(pawn: &PawnState, size: i32) -> Figure {
+    Figure {
+        x: pawn.x,
+        z: size as f32 - pawn.z,
+        yaw: pawn.rot,
+        kind: match pawn.kind.as_deref() {
+            Some("humanlike") => Kind::Humanlike,
+            Some("animal") => Kind::Animal,
+            Some("mech") => Kind::Mech,
+            _ => Kind::Other,
+        },
+        side: match pawn.faction.as_str() {
+            "player" => SideColour::Player,
+            "hostile" => SideColour::Hostile,
+            _ => SideColour::Neutral,
+        },
+        downed: pawn.downed,
+    }
+}
+
+/// Moves each figure towards its pawn, adds new pawns and drops gone ones.
+fn follow_pawns(figures: &mut HashMap<String, Figure>, pawns: &[PawnState], size: i32, dt: f32) {
+    figures.retain(|id, _| pawns.iter().any(|pawn| &pawn.id == id));
+    let step = 1.0 - (-FIGURE_FOLLOW * dt).exp();
+    for pawn in pawns {
+        let target = figure_of(pawn, size);
+        match figures.get_mut(&pawn.id) {
+            Some(figure) if (figure.x - target.x).hypot(figure.z - target.z) < FIGURE_JUMP => {
+                let (x, z) = (figure.x + (target.x - figure.x) * step, figure.z + (target.z - figure.z) * step);
+                *figure = Figure { x, z, ..target };
+            }
+            _ => {
+                figures.insert(pawn.id.clone(), target);
+            }
+        }
+    }
+}
+
+/// Every figure's boxes, as MinecraftOSS entity vertices and indices.
+fn figure_mesh<'a>(figures: impl Iterator<Item = &'a Figure>) -> (Vec<u8>, Vec<u32>) {
+    let (mut vertices, mut indices) = (Vec::new(), Vec::new());
+    for figure in figures {
+        let body = match (figure.side, figure.kind) {
+            (SideColour::Player, _) => [0.22, 0.45, 0.95],
+            (SideColour::Hostile, _) => [0.90, 0.16, 0.14],
+            (SideColour::Neutral, Kind::Animal) => [0.62, 0.47, 0.30],
+            (SideColour::Neutral, _) => [0.95, 0.80, 0.25],
+        };
+        let skin = [0.93, 0.78, 0.62];
+        let dark = [0.12, 0.12, 0.14];
+        let mut put = |forward: f32, right: f32, y: f32, [w, d, h]: [f32; 3], colour: [f32; 3]| {
+            add_box(&mut vertices, &mut indices, figure, [forward, right, y], [w, d, h], colour);
+        };
+        match (figure.kind, figure.downed) {
+            // Lying along its facing, head first.
+            (Kind::Humanlike, true) => {
+                put(-0.2, 0.0, 0.0, [0.5, 1.2, 0.3], body);
+                put(0.6, 0.0, 0.0, [0.36, 0.36, 0.3], skin);
+            }
+            // About an MW2 soldier's height: a body, a head and a visor showing the facing.
+            (Kind::Humanlike, false) => {
+                put(0.0, 0.0, 0.0, [0.5, 0.3, 1.45], body);
+                put(0.0, 0.0, 1.45, [0.36, 0.36, 0.36], skin);
+                put(0.2, 0.0, 1.58, [0.24, 0.06, 0.08], dark);
+            }
+            (Kind::Animal, downed) => {
+                let h = if downed { 0.3 } else { 0.6 };
+                put(0.0, 0.0, 0.0, [0.5, 0.9, h], body);
+                put(0.55, 0.0, h * 0.6, [0.3, 0.3, 0.3], body);
+            }
+            (Kind::Mech, downed) => {
+                let h = if downed { 0.4 } else { 1.6 };
+                let grey = body.map(|c| c * 0.5);
+                put(0.0, 0.0, 0.0, [0.8, 0.8, h], grey);
+                put(0.42, 0.0, h * 0.75, [0.3, 0.06, 0.1], [1.0, 0.2, 0.1]);
+            }
+            (Kind::Other, _) => put(0.0, 0.0, 0.0, [0.5, 0.5, 0.5], body),
+        }
+    }
+    (bytemuck::cast_slice(&vertices).to_vec(), indices)
+}
+
+/// A box on a figure: centred `forward` and `right` blocks from it along its
+/// facing, from height `y`, `[width, depth, height]` blocks, all six faces.
+fn add_box(
+    vertices: &mut Vec<Vertex>,
+    indices: &mut Vec<u32>,
+    figure: &Figure,
+    [forward, right, y]: [f32; 3],
+    [w, d, h]: [f32; 3],
+    colour: [f32; 3],
+) {
+    // Facing north (block -Z) at yaw 0, turning clockwise seen from above.
+    let yaw = figure.yaw.to_radians();
+    let (ahead, side) = ([yaw.sin(), -yaw.cos()], [yaw.cos(), yaw.sin()]);
+    let at = |f: f32, r: f32, up: f32| {
+        [
+            figure.x + ahead[0] * (forward + f) + side[0] * (right + r),
+            y + up,
+            figure.z + ahead[1] * (forward + f) + side[1] * (right + r),
+        ]
+    };
+    let (hw, hd) = (w / 2.0, d / 2.0);
+    // Faces as four (forward, right, up) corners, with Minecraft's shades.
+    let faces: [([[f32; 3]; 4], f32); 6] = [
+        ([[-hd, -hw, h], [hd, -hw, h], [hd, hw, h], [-hd, hw, h]], 1.0),
+        ([[-hd, -hw, 0.0], [-hd, hw, 0.0], [hd, hw, 0.0], [hd, -hw, 0.0]], 0.5),
+        ([[hd, -hw, 0.0], [hd, hw, 0.0], [hd, hw, h], [hd, -hw, h]], 0.8),
+        ([[-hd, hw, 0.0], [-hd, -hw, 0.0], [-hd, -hw, h], [-hd, hw, h]], 0.8),
+        ([[-hd, -hw, 0.0], [hd, -hw, 0.0], [hd, -hw, h], [-hd, -hw, h]], 0.6),
+        ([[hd, hw, 0.0], [-hd, hw, 0.0], [-hd, hw, h], [hd, hw, h]], 0.6),
+    ];
+    let uv = [(TILE_WHITE as f32 + 0.5) / TILES as f32, 0.5];
+    for (corners, shade) in faces {
+        let base = vertices.len() as u32;
+        for [f, r, up] in corners {
+            vertices.push(Vertex {
+                position: at(f, r, up),
+                uv,
+                color: [colour[0] * shade, colour[1] * shade, colour[2] * shade, 1.0],
+                sky_light: 15.0,
+                block_light: 0.0,
+            });
+        }
+        indices.extend([base, base + 1, base + 2, base, base + 2, base + 3]);
+    }
+}
