+/// The floor's blocks: its size and, once RimWorld has sent it, its terrain.
+#[derive(Clone, Copy)]
+struct Lay<'a> {
+    size: i32,
+    terrain: Option<&'a Terrain>,
+}
+
+impl Lay<'_> {
+    /// The terrain code at block cell `(x, z)`; `None` off the floor. Before RimWorld's
+    /// terrain arrives, and past the edge of a map smaller than the floor, it is soil.
+    fn code(&self, x: i32, z: i32) -> Option<u8> {
+        let inside = |v: i32| (0..self.size).contains(&v);
+        if !inside(x) || !inside(z) {
+            return None;
+        }
+        Some(self.terrain.and_then(|t| t.at(x, self.size - 1 - z)).unwrap_or(terrain::SOIL))
+    }
+
+    fn cell(&self, x: i32, y: i32, z: i32) -> Cell {
+        let size = self.size;
+        let around = |v: i32| (-1..=size).contains(&v);
+        match self.code(x, z) {
+            None if around(x) && around(z) && (-1..WALL_HEIGHT).contains(&y) => Cell::Wall,
+            None => Cell::Air,
+            Some(_) if y == -1 && self.terrain.is_none() => Cell::Floor,
+            Some(code) if y == -1 => Cell::Ground(code),
+            Some(code) if column(code).contains(&y) => Cell::Column(code),
+            Some(_) => Cell::Air,
+        }
+    }
+}
