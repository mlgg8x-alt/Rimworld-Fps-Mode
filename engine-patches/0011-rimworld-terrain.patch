+/// One pixel of a terrain code's tile: its colour, a little uneven, with a
+/// pattern for what it is. Ground tiles keep a faint line on their west and
+/// north edges, so RimWorld's cells still show.
+fn terrain_pixel(code: u8, [r, g, b]: [u8; 3], x: u32, y: u32) -> [u8; 3] {
+    // A fixed hash per pixel, so every build looks the same.
+    let noise = ((x.wrapping_mul(73) ^ y.wrapping_mul(151) ^ u32::from(code).wrapping_mul(29)).wrapping_mul(2_654_435_761) >> 28) as i32 - 8;
+    let pattern = match code {
+        terrain::FLOOR if y % 4 == 0 => -26,
+        terrain::WALL if y % 4 == 0 || (x + if (y / 4) % 2 == 0 { 0 } else { 4 }) % 8 == 0 => -40,
+        terrain::COVER if y % 5 == 0 => -30,
+        terrain::TREE if x % 3 == 0 => -22,
+        terrain::DOOR if x % 5 == 0 => -24,
+        terrain::ROCK => noise * 2,
+        _ if !column(code).is_empty() => 0,
+        _ if x == 0 || y == 0 => -14,
+        _ => 0,
+    };
+    let shade = |c: u8| (i32::from(c) + noise + pattern).clamp(0, 255) as u8;
+    [shade(r), shade(g), shade(b)]
