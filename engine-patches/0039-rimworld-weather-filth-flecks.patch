+/// A RimWorld fleck as it lives on in MW2 (M21): as it started, and how old it is in game
+/// seconds.
+#[derive(Clone, Debug, PartialEq)]
+struct FleckLive {
+    fleck: rimworld_bridge::FleckState,
+    age: f32,
+}
+
+impl FleckLive {
+    fn life(&self) -> f32 {
+        let f = &self.fleck;
+        f.fade_in.max(0.0) + f.solid.max(0.0) + f.fade_out.max(0.0)
+    }
+
+    /// How much of it shows now, 0 to 1: fading in, solid, fading out.
+    fn shown(&self) -> f32 {
+        let f = &self.fleck;
+        if self.age < f.fade_in {
+            return self.age / f.fade_in.max(1e-3);
+        }
+        let out = self.age - f.fade_in.max(0.0) - f.solid.max(0.0);
+        if out > 0.0 { 1.0 - out / f.fade_out.max(1e-3) } else { 1.0 }.clamp(0.0, 1.0)
+    }
+}
+
+/// Most flecks alive at once (M21); the oldest go first.
+const MAX_FLECKS: usize = 600;
+
+/// Ages every fleck `dt` game seconds and drops those whose time is up.
+fn age_flecks(flecks: &mut Vec<FleckLive>, dt: f32) {
+    for fleck in flecks.iter_mut() {
+        fleck.age += dt;
+    }
+    flecks.retain(|fleck| fleck.age < fleck.life());
+    if flecks.len() > MAX_FLECKS {
+        let extra = flecks.len() - MAX_FLECKS;
+        flecks.drain(..extra);
+    }
+}
+
+/// Filth further than this from the eye is not drawn, nor more than so many (M21).
+const FILTH_REACH: f32 = 60.0 * CELL as f32;
+const MAX_FILTH: usize = 1200;
+/// Rain and snow fall this far around the eye, from this high above the ground, in blocks.
+const WEATHER_REACH: f32 = 26.0;
+const WEATHER_TOP: f32 = 22.0;
+/// Drops at RimWorld's rain rate 1 and flakes at its snow rate 1.
+const RAIN_DROPS: f32 = 700.0;
+const SNOW_FLAKES: f32 = 600.0;
+/// Blocks a second rain and snow fall.
+const RAIN_SPEED: f32 = 24.0;
+const SNOW_SPEED: f32 = 2.2;
+
+/// The see-through things on the floor (M21): RimWorld's filth lying where it lies, its
+/// flecks flying, growing and fading, and its rain and snow falling where no roof keeps them
+/// off, as MinecraftOSS translucent entity vertices and indices.
+fn effect_mesh(floor: &FlatFloor, filth: &[rimworld_bridge::FilthState], weather: rimworld_bridge::Weather) -> (Vec<u8>, Vec<u32>) {
+    let (mut vertices, mut indices) = (Vec::new(), Vec::new());
+    let size = floor.size;
+    let eye = floor.eye.map(|eye| Vec3::new(eye[0] as f32, eye[1] as f32, eye[2] as f32));
+    let cell = CELL as f32;
+    // Filth, flat on the ground, the nearest first.
+    let mut near: Vec<(f32, &rimworld_bridge::FilthState, Vec3)> = filth
+        .iter()
+        .map(|splotch| {
+            let at = rimworld_block(size, splotch.x, 0.0, splotch.z);
+            (eye.map_or(0.0, |eye| Vec2::new(eye.x - at.x, eye.z - at.z).length()), splotch, at)
+        })
+        .filter(|(distance, ..)| *distance <= FILTH_REACH)
+        .collect();
+    near.sort_by(|a, b| a.0.total_cmp(&b.0));
+    for (_, splotch, at) in near.into_iter().take(MAX_FILTH) {
+        let Some((tex, bounds)) = u16::try_from(splotch.tex).ok().and_then(|tex| Some((tex, *floor.cutouts.get(&tex)?))) else {
+            continue;
+        };
+        let across = splotch.size.clamp(0.1, 6.0) * cell;
+        let (w, h) = ((bounds[2] - bounds[0]) * across, (bounds[3] - bounds[1]) * across);
+        add_card(&mut vertices, &mut indices, [at.x, at.z], None, tex, bounds, [w, h], false, Some(splotch.rot), 0.01, WHITE);
+    }
+    // Flecks.
+    let eye_xz = eye.map(|eye| [f64::from(eye.x), f64::from(eye.y), f64::from(eye.z)]);
+    for live in &floor.flecks {
+        let f = &live.fleck;
+        let Some((tex, bounds)) = u16::try_from(f.tex).ok().and_then(|tex| Some((tex, *floor.cutouts.get(&tex)?))) else {
+            continue;
+        };
+        let t = live.age;
+        let at = rimworld_block(size, f.x + f.vx * t, 0.0, f.z + f.vz * t);
+        let across = (f.size + f.grow * t).clamp(0.02, 12.0) * cell;
+        let (w, h) = ((bounds[2] - bounds[0]) * across, (bounds[3] - bounds[1]) * across);
+        let colour = [f.color[0], f.color[1], f.color[2], f.color[3] * live.shown()];
+        if f.flat {
+            add_card(&mut vertices, &mut indices, [at.x, at.z], None, tex, bounds, [w, h], false, Some(f.rot + f.spin * t), 0.03, colour);
+        } else {
+            let lift = ((f.y + f.vy * t) * cell - h / 2.0).max(0.0);
+            add_card(&mut vertices, &mut indices, [at.x, at.z], eye_xz, tex, bounds, [w, h], false, None, lift, colour);
+        }
+    }
+    if let Some(eye) = eye {
+        add_weather(&mut vertices, &mut indices, floor.lay(), eye, weather, floor.weather_time);
+    }
+    (bytemuck::cast_slice(&vertices).to_vec(), indices)
+}
+
+/// A number from 0 to 1 that `i` and `salt` always give.
+fn scatter(i: u32, salt: u32) -> f32 {
+    let mut h = i.wrapping_mul(0x9E37_79B9) ^ salt.wrapping_mul(0x85EB_CA6B);
+    h ^= h >> 15;
+    h = h.wrapping_mul(0x2C1B_3C6D);
+    h ^= h >> 12;
+    h = h.wrapping_mul(0x297A_2D39);
+    h ^= h >> 15;
+    (h >> 8) as f32 / (1u32 << 24) as f32
+}
+
+/// Rain streaks and snowflakes around `eye` (block space) as RimWorld's `weather` has them,
+/// `t` seconds in: each stays put in the world as the eye moves (they wrap around it), and
+/// none falls where a roof or the mountain is overhead.
+fn add_weather(vertices: &mut Vec<Vertex>, indices: &mut Vec<u32>, lay: Lay<'_>, eye: Vec3, weather: rimworld_bridge::Weather, t: f32) {
+    let roofed = |p: Vec3| lay.detail.is_some_and(|detail| detail.roof_at(p.x.floor() as i32, p.z.floor() as i32) != roof::NONE);
+    let span = WEATHER_REACH * 2.0;
+    let place = |i: u32, salt: u32, fall: f32| {
+        let wrap = |v: f32, centre: f32| centre + (v - centre + WEATHER_REACH).rem_euclid(span) - WEATHER_REACH;
+        let x = wrap(scatter(i, salt) * span * 40.0, eye.x);
+        let z = wrap(scatter(i, salt + 1) * span * 40.0, eye.z);
+        let top = WEATHER_TOP.max(eye.y + 8.0);
+        let y = top - (t * fall + scatter(i, salt + 2) * top).rem_euclid(top);
+        Vec3::new(x, y, z)
+    };
+    let wind = weather.wind.clamp(0.0, 3.0);
+    let drops = (weather.rain.clamp(0.0, 2.5) * RAIN_DROPS) as u32;
+    let slant = Vec3::new(0.12 * wind, -1.0, 0.05 * wind).normalize();
+    for i in 0..drops {
+        let head = place(i, 11, RAIN_SPEED);
+        if roofed(head) {
+            continue;
+        }
+        let tail = head - slant * 0.9;
+        add_streak(vertices, indices, head, tail, 0.018, [0.72, 0.78, 0.88, 0.45], eye);
+    }
+    let flakes = (weather.snow.clamp(0.0, 2.5) * SNOW_FLAKES) as u32;
+    for i in 0..flakes {
+        let mut at = place(i, 29, SNOW_SPEED);
+        let sway = t * 0.9 + scatter(i, 31) * 6.3;
+        at.x += sway.sin() * 0.35 + wind * 0.4 * (t * 0.3 + scatter(i, 37)).fract();
+        at.z += sway.cos() * 0.25;
+        if roofed(at) {
+            continue;
+        }
+        add_streak(vertices, indices, at + Vec3::Y * 0.05, at - Vec3::Y * 0.05, 0.05, [1.0, 1.0, 1.0, 0.9], eye);
+    }
+}
+
+/// A flat strip from `a` to `b`, `half` wide each way, turned to face `eye`, plain `colour`.
+fn add_streak(vertices: &mut Vec<Vertex>, indices: &mut Vec<u32>, a: Vec3, b: Vec3, half: f32, colour: [f32; 4], eye: Vec3) {
+    let along = b - a;
+    let side = along.cross(eye - a).normalize_or(Vec3::X) * half;
+    let uv = tile_uv(TILE_WHITE, [0.0, 0.0], [0.5, 0.5]);
+    let base = vertices.len() as u32;
+    for p in [a - side, a + side, b + side, b - side] {
+        vertices.push(Vertex { position: p.to_array(), uv, color: colour, sky_light: 15.0, block_light: 0.0 });
+    }
+    indices.extend([base, base + 1, base + 2, base, base + 2, base + 3]);
+}
