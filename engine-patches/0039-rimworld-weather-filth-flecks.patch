+/// How far one sees in `weather` with `clear` blocks of sight on a clear day, and how murky
+/// it is, 0 clear to 1 thick fog.
+fn murk(clear: f32, weather: rimworld_bridge::Weather) -> (f32, f32) {
+    let fog = weather.fog.clamp(0.0, 1.0);
+    let wet = (weather.rain.max(weather.snow) / 1.5).clamp(0.0, 1.0);
+    let sight = clear.min(clear + (FOG_SIGHT - clear) * fog).min(clear + (RAIN_SIGHT.min(clear) - clear) * wet);
+    (sight.max(4.0), fog.max(wet * 0.6))
+}
