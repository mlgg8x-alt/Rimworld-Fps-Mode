+/// The floor seen from above, north (block -Z) up, wall included: the
+/// floor's colours, a grid line every 10 cells and the middle cell.
+fn minimap(size: i32) -> Image {
+    let across = size + 2;
+    let mut pixels = Vec::with_capacity((MINIMAP_PIXELS * MINIMAP_PIXELS * 4) as usize);
+    let block = |p: u32| (p as i64 * i64::from(across) / i64::from(MINIMAP_PIXELS)) as i32 - 1;
+    let line = |v: i32| (v - size / 2).rem_euclid(MAJOR_LINE) == 0;
+    for py in 0..MINIMAP_PIXELS {
+        for px in 0..MINIMAP_PIXELS {
+            let (x, z) = (block(px), block(py));
+            // The first pixel row or column of a cell carries its line.
+            let first_x = px == 0 || block(px - 1) != x;
+            let first_z = py == 0 || block(py - 1) != z;
+            let rgb = match cell_at(size, x, -1, z) {
+                Cell::Wall => [104, 110, 120],
+                _ if x == size / 2 && z == size / 2 => [224, 122, 40],
+                _ if (first_x && line(x)) || (first_z && line(z)) => [118, 110, 96],
+                _ => [182, 172, 150],
+            };
+            pixels.extend_from_slice(&[rgb[0], rgb[1], rgb[2], 255]);
+        }
+    }
+    Image::new(
+        Extent3d { width: MINIMAP_PIXELS, height: MINIMAP_PIXELS, depth_or_array_layers: 1 },
+        TextureDimension::D2,
+        pixels,
+        TextureFormat::Rgba8UnormSrgb,
+        RenderAssetUsages::default(),
+    )
+}
