+/// Names of the other maps' models the RimWorld floor takes, by part of the
+/// name: plants, cover and furniture RimWorld things are drawn with.
+/// `RWMW2_EXTRA_MODELS` adds more, comma separated; `*` takes every model.
+const WANTED_MODELS: &[&str] = &[
+    "foliage", "tree", "palm", "cact", "bush", "shrub", "sandbag", "barrier", "crate", "barrel",
+    "chair", "table", "bed", "couch", "sofa", "shelf", "lamp", "fence",
+];
+
+/// The parts of names [`absorb_other_map_models`] takes; empty for every model.
+fn wanted_models() -> Vec<String> {
+    let extra = std::env::var("RWMW2_EXTRA_MODELS").unwrap_or_else(|_| String::new());
+    let extra: Vec<String> =
+        extra.split(',').map(|part| part.trim().to_ascii_lowercase()).filter(|part| !part.is_empty()).collect();
+    if extra.iter().any(|part| part == "*") {
+        return Vec::new();
+    }
+    WANTED_MODELS.iter().map(|part| (*part).to_owned()).chain(extra).collect()
+}
+
+/// Keeps only the `wanted` models (all when it is empty) and the materials and
+/// images they use. Returns the old material index to the new one.
+fn keep_wanted(
+    scenes: &mut asset_world::MapXModelSceneCatalog,
+    materials: &mut asset_material::MaterialCatalog,
+    wanted: &[String],
+) -> Vec<usize> {
+    if !wanted.is_empty() {
+        let names: std::collections::BTreeSet<String> = scenes
+            .iter()
+            .map(|(key, _)| key.0.clone())
+            .filter(|name| {
+                let name = name.to_ascii_lowercase();
+                wanted.iter().any(|part| name.contains(part.as_str()))
+            })
+            .collect();
+        scenes.retain_names(&names);
+    }
+    let mut used = vec![false; materials.materials.len()];
+    for (_, asset) in scenes.iter() {
+        if let asset_world::MapXModelSceneAsset::Iw4(skel) = asset {
+            for slot in skel.surface_materials.iter().flatten() {
+                if let Some(flag) = used.get_mut(slot.get()) {
+                    *flag = true;
+                }
+            }
+        }
+    }
+    let mut old_to_new = vec![0; used.len()];
+    let kept: Vec<_> = std::mem::take(&mut materials.materials)
+        .into_iter()
+        .enumerate()
+        .filter(|(index, _)| used[*index])
+        .enumerate()
+        .map(|(new, (old, material))| {
+            old_to_new[old] = new;
+            material
+        })
+        .collect();
+    materials.materials = kept;
+    // Only the images those materials use, so only theirs are decoded.
+    let mut image_new = vec![None; materials.images.len()];
+    let mut images = Vec::new();
+    let all_images = std::mem::take(&mut materials.images);
+    let mut all_images: Vec<Option<_>> = all_images.into_iter().map(Some).collect();
+    for material in &mut materials.materials {
+        for texture in &mut material.textures {
+            texture.image = texture.image.and_then(|old| {
+                if image_new[old].is_none() {
+                    image_new[old] = Some(images.len());
+                    images.push(all_images.get_mut(old)?.take()?);
+                }
+                image_new[old]
+            });
+        }
+    }
+    materials.images = images;
+    old_to_new
+}
