+/// The first material id taken from the other MW2 maps on the RimWorld floor:
+/// those get their shader pipelines when first drawn, not while the map loads.
+/// `u32::MAX` when there are none.
+static LAZY_MATERIALS_FROM: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(u32::MAX);
+
+pub fn set_lazy_materials_from(first: u32) {
+    LAZY_MATERIALS_FROM.store(first, std::sync::atomic::Ordering::Relaxed);
+}
+
+/// Whether material `id` gets its pipelines only once something draws it.
+pub fn lazy_material(id: u16) -> bool {
+    u32::from(id) >= LAZY_MATERIALS_FROM.load(std::sync::atomic::Ordering::Relaxed)
+}
+
 pub fn is_flat(zone: &str) -> bool {
     zone.eq_ignore_ascii_case(FLAT_ZONE)
 }
