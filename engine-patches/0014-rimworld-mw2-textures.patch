+/// Where in the atlas a point of a face lands: `tile`, in the part for the block whose
+/// corner is at texture position `start`, `local` of the way across that block.
+fn tile_uv(tile: u32, start: [f32; 2], local: [f32; 2]) -> [f32; 2] {
+    let rows = TILES / TILE_COLUMNS;
+    let corner = [tile % TILE_COLUMNS, tile / TILE_COLUMNS];
+    let inset = 0.5 / BLOCK_PIXELS as f32;
+    let at = |i: usize, count: u32| {
+        let part = (start[i] as i32).rem_euclid(SPAN as i32) as f32;
+        let within = (part + local[i].clamp(inset, 1.0 - inset)) / SPAN as f32;
+        (corner[i] as f32 + within) / count as f32
+    };
+    [at(0, TILE_COLUMNS), at(1, rows)]
+}
+
+/// The floor's tiles, and their mip levels down to a pixel a tile. Built once: MW2's
+/// textures take a moment to decode.
+fn atlas() -> Arc<Atlas> {
+    static ATLAS: std::sync::OnceLock<Arc<Atlas>> = std::sync::OnceLock::new();
+    Arc::clone(ATLAS.get_or_init(|| {
+        let minecraft = assets::minecraft_map::root()
+            .map(|root| root.join("resourcepacks/local/minecraft-26.3/assets/minecraft/textures/block"));
+        let games = asset_transport::games_root_from_env().ok();
+        if games.is_none() {
+            diag::warn!(Zone, "rimworld: no MW2 games folder (IW4L_GAMES), so no MW2 textures on the floor");
+        }
+        let mw2 = |name: &str| mw2_texture(games.as_ref()?, name);
+        Arc::new(atlas_from(minecraft.as_deref(), &mw2))
+    }))
+}
+
+/// One of MW2's textures by image name, as RGBA, from the game's `.iwd` files.
+fn mw2_texture(games: &asset_transport::GamesRoot, name: &str) -> Option<RgbaImage> {
+    match asset_material::decode_ui_image(&games.0, name) {
+        Ok(Some((width, height, rgba))) => RgbaImage::from_raw(width, height, rgba),
+        Ok(None) => {
+            diag::warn!(Zone, "rimworld: MW2 texture {name} not found; using the next best");
+            None
+        }
+        Err(error) => {
+            diag::warn!(Zone, "rimworld: MW2 texture {name}: {error}; using the next best");
+            None
+        }
+    }
 }
 
