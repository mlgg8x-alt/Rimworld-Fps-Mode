+    fn textures_run_on_across_blocks() {
+        let mut mesh = SectionMesh::default();
+        let lay = Lay { size: 250, terrain: None };
+        add_block(&mut mesh, lay, [5, -1, 9], Cell::Ground(terrain::SAND));
+        add_block(&mut mesh, lay, [6, -1, 9], Cell::Ground(terrain::SAND));
+        let tile = terrain_tile(terrain::SAND);
+        let width = (TILE * TILE_COLUMNS) as f32;
+        let left = tile_x(tile) as f32 / width;
+        // Pixels across the tile, to the nearest one (each block is inset half a pixel).
+        let span = |vertices: &[SectionVertex]| {
+            let us = vertices.iter().map(|v| ((v.uv[0] - left) * width).floor() as u32);
+            (us.clone().min().unwrap(), us.max().unwrap())
+        };
+        // Block x 5 is the second of each four in the tile, x 6 the third: one run, no seam.
+        assert_eq!(span(&mesh.vertices[..4]), (BLOCK_PIXELS, 2 * BLOCK_PIXELS - 1));
+        assert_eq!(span(&mesh.vertices[4..]), (2 * BLOCK_PIXELS, 3 * BLOCK_PIXELS - 1));
+    }
