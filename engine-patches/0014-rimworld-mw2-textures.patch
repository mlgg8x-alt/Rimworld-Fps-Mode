+/// A block of leaves from a picture of one branch: copies of it at half size, turned four
+/// ways, over each other and wrapping round, so the block is full of branches.
+fn foliage(branch: &RgbaImage) -> RgbaImage {
+    let side = TILE;
+    let half = image::imageops::resize(branch, side / 2, side / 2, image::imageops::FilterType::Triangle);
+    let turns = [
+        half.clone(),
+        image::imageops::rotate90(&half),
+        image::imageops::rotate180(&half),
+        image::imageops::rotate270(&half),
+    ];
+    let mut out = RgbaImage::new(side, side);
+    let (h, q) = (side / 2, side / 4);
+    let stamps = [(0, 0), (h, 0), (0, h), (h, h), (q, q), (h + q, q), (q, h + q), (h + q, h + q)];
+    for (n, (ox, oy)) in stamps.into_iter().enumerate() {
+        let stamp = &turns[(n * 3 + n / 4) % 4];
+        for (x, y, p) in stamp.enumerate_pixels() {
+            let (tx, ty) = ((ox + x) % side, (oy + y) % side);
+            if p[3] >= 128 && out.get_pixel(tx, ty)[3] < 128 {
+                out.put_pixel(tx, ty, *p);
+            }
+        }
+    }
+    out
+}
