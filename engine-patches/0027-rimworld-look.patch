+/// Whether RimWorld's own pictures are used for its people and its plants, rather than MW2's
+/// soldiers and tree models: both on unless the environment says otherwise.
+fn rimworld_pictures() -> (bool, bool) {
+    static ON: std::sync::OnceLock<(bool, bool)> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        let on = |name: &str| !matches!(std::env::var(name).map(|v| v.trim().to_lowercase()).as_deref(), Ok("0" | "off" | "false"));
+        let (people, plants) = (on("RWMW2_RIMWORLD_PAWNS"), on("RWMW2_RIMWORLD_PLANTS"));
+        diag::info!(Zone, "rimworld: RimWorld's own pictures for people {people}, for plants {plants}");
+        println!("[rimworld] RimWorld's own pictures: people {people}, plants {plants}");
+        (people, plants)
+    })
+}
+
+/// How many cells across RimWorld draws each kind of plant fully grown, and how little of
+/// that a seedling is.
+fn plant_cells(kind: &str) -> f32 {
+    match kind {
+        "pine" | "oak" | "birch" | "palm" => 2.6,
+        "dead" => 2.2,
+        "cactus" => 1.2,
+        "grass" => 0.8,
+        _ => 1.1,
+    }
+}
+const PLANT_LEAST: f32 = 0.35;
+/// Cells of grass a side between one grass picture and the next, and how far grass is drawn.
+const GRASS_STEP: i32 = 2;
+const GRASS_REACH: f32 = 60.0;
+
+/// Which of a kind's RimWorld pictures stands on cell `(x, z)`.
+fn plant_picture(art: &HashMap<String, Vec<i32>>, kind: &str, x: i32, z: i32) -> Option<u16> {
+    let pictures = art.get(kind).filter(|list| !list.is_empty())?;
+    let picture = pictures[(cell_hash(x, z, 7) * pictures.len() as f32) as usize % pictures.len()];
+    u16::try_from(picture).ok()
+}
+
+/// Everything that grows, as RimWorld's own picture of it standing on its cell: every tree
+/// and bush RimWorld sent, sized by how grown it is, and a scattering of grass over the
+/// grassy cells near the eye (RimWorld has no grass floor: it is ground with grass on it).
+fn add_plants(vertices: &mut Vec<Vertex>, indices: &mut Vec<u32>, cards: &Cards, size: i32) {
+    let Some(art) = cards.plant_art else { return };
+    let cell = CELL as f32;
+    let mut stand = |x: f32, z: f32, tex: u16, cells: f32| {
+        let Some(bounds) = cards.cutouts.get(&tex).copied() else { return };
+        let (w, h) = (bounds[2] - bounds[0], bounds[3] - bounds[1]);
+        let scale = cells * cell / w.max(h).max(1e-3);
+        let at = rimworld_block(size, x, 0.0, z);
+        add_card(vertices, indices, [at.x, at.z], cards.eye, tex, bounds, [w * scale, h * scale], false, false);
+    };
+    for plant in cards.plants {
+        let Some(tex) = plant_picture(art, &plant.kind, plant.x, plant.z) else { continue };
+        let grown = PLANT_LEAST + (1.0 - PLANT_LEAST) * plant.growth.clamp(0.0, 1.0);
+        stand(plant.x as f32 + 0.5, plant.z as f32 + 0.5, tex, plant_cells(&plant.kind) * grown);
+    }
+    // Grass, on the grassy cells around the eye.
+    let (Some(lay), Some(eye)) = (cards.lay, cards.eye) else { return };
+    let here = |p: f64| (p / f64::from(CELL)) as i32;
+    let (ex, ez) = (here(eye[0]), size - here(eye[2]));
+    let reach = GRASS_REACH as i32;
+    for z in (ez - reach..=ez + reach).step_by(GRASS_STEP as usize) {
+        for x in (ex - reach..=ex + reach).step_by(GRASS_STEP as usize) {
+            if lay.code(x * CELL, (size - 1 - z) * CELL) != Some(terrain::GRASS) {
+                continue;
+            }
+            let Some(tex) = plant_picture(art, "grass", x, z) else { continue };
+            let (jx, jz) = (cell_hash(x, z, 11), cell_hash(x, z, 13));
+            stand(x as f32 + jx, z as f32 + jz, tex, plant_cells("grass"));
+        }
+    }
+}
