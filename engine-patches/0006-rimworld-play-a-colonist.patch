+/// The local player plays `pawn`, a drafted colonist: put on it when they start
+/// or drift too far from it, and their moves sent to RimWorld.
+fn play_colonist(
+    floor: &mut FlatFloor,
+    authority: &mut net::AuthorityWorld,
+    local: sim::ClientId,
+    pawn: Option<&PawnState>,
+    outbox: Option<&RimworldOutbox>,
+    dt: f32,
+) {
+    let (Some(pawn), Some(ps)) = (pawn, authority.0.player(local)) else {
+        floor.playing = None;
+        return;
+    };
+    let [x, z] = floor.map_to_rimworld(ps.origin);
+    let yaw = (90.0 - ps.viewangles[1]).rem_euclid(360.0);
+    let starting = floor.playing.as_deref() != Some(pawn.id.as_str());
+    if starting || (x - pawn.x).hypot(z - pawn.z) > PLAYER_SNAP {
+        let mut at = floor.rimworld_to_map(pawn.x, pawn.z);
+        at[2] = 1.0;
+        if !authority.0.teleport(local, at) {
+            return;
+        }
+        if starting {
+            floor.playing = Some(pawn.id.clone());
+            floor.since_move = 0.0;
+        }
+        return;
+    }
+    floor.since_move += dt;
+    if floor.since_move < MOVE_SECONDS {
+        return;
+    }
+    floor.since_move = 0.0;
+    if let Some(outbox) = outbox {
+        outbox.send(&BridgeMessage::PlayerMove { pawn: pawn.id.clone(), x, z, yaw });
+    }
+}
