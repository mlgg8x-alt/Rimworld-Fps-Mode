+impl RimworldOutbox {
+    /// Writes one message; false when RimWorld isn't connected or the write failed.
+    pub fn send(&self, message: &Message) -> bool {
+        let Ok(mut stream) = self.0.lock() else { return false };
+        let Some(writer) = stream.as_mut() else { return false };
+        if writer.write_all(message.to_line().as_bytes()).is_ok() {
