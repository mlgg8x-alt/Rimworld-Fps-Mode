+    #[test]
+    fn people_hold_their_weapon_and_swing_it_in_melee() {
+        let mut cutouts = HashMap::new();
+        for tex in [1u16, 2, 3, 9] {
+            cutouts.insert(tex, [0.0, 0.0, 1.0, 1.0]);
+        }
+        // Seen from the south.
+        let eye = [10.5 * C as f64, 2.0, (250.0 - 2.0) as f64 * C as f64];
+        let cards = Cards { cutouts: &cutouts, eye: Some(eye), ..no_cards() };
+        let sword = rimworld_bridge::Held { tex: 9, size: [1.0, 1.0], aim: Some(90.0), turn: 0.0, reach: 0.0, melee: true };
+        let raider = PawnState {
+            art: Some([1, 2, 3]),
+            draw: Some([2.0, 2.0]),
+            faction: "hostile".into(),
+            held: Some(sword.clone()),
+            ..pawn("r", 10.5, 10.5)
+        };
+        let mut figures = HashMap::new();
+        follow_pawns(&mut figures, std::slice::from_ref(&raider), 250, 0.016);
+        let mesh = |figures: &HashMap<String, Figure>| {
+            let (bytes, indices) = figure_mesh(figures.values(), &[], &[], &cards, 250);
+            (bytemuck::cast_slice::<u8, Vertex>(&bytes).to_vec(), indices.len() / 12)
+        };
+        let (vertices, cards_drawn) = mesh(&figures);
+        assert_eq!(cards_drawn, 2, "the raider and their sword");
+        // Aiming east, seen from the south: the sword is held out to the right, level.
+        let sword_quad = &vertices[4..8];
+        let mid = |quad: &[Vertex]| quad.iter().map(|v| Vec3::from_array(v.position)).sum::<Vec3>() / 4.0;
+        assert!(mid(sword_quad).x > figures["r"].x + 0.2, "{:?}", mid(sword_quad));
+        assert!((sword_quad[0].position[1] - sword_quad[1].position[1]).abs() < 1e-3, "level");
+        // Aiming west: mirrored, held out to the left.
+        let west = PawnState { held: Some(rimworld_bridge::Held { aim: Some(270.0), ..sword.clone() }), ..raider.clone() };
+        follow_pawns(&mut figures, std::slice::from_ref(&west), 250, 0.016);
+        let (vertices, _) = mesh(&figures);
+        assert!(mid(&vertices[4..8]).x < figures["r"].x - 0.2);
+        assert!(vertices[4].uv[0] > vertices[5].uv[0], "mirrored");
+        // A melee attack: it swings, lunging, and is still again after the swing.
+        let attacked = PawnState { swings: Some(1), ..raider.clone() };
+        follow_pawns(&mut figures, std::slice::from_ref(&attacked), 250, 0.016);
+        assert_eq!(figures["r"].swing, SWING_SECONDS);
+        follow_pawns(&mut figures, std::slice::from_ref(&attacked), 250, SWING_SECONDS / 2.0);
+        assert!(swing_lunge(figures["r"].swing) > 0.9);
+        let (vertices, _) = mesh(&figures);
+        assert!(mid(&vertices[0..4]).x > figures["r"].x + 0.3, "lunged towards its target");
+        follow_pawns(&mut figures, std::slice::from_ref(&attacked), 250, SWING_SECONDS);
+        assert_eq!(figures["r"].swing, 0.0);
+        assert_eq!(swing_angle(SWING_SECONDS), SWING_RAISED);
+        assert_eq!(swing_angle(1e-6).round(), SWING_STRUCK);
+        // Downed: nothing in its hands.
