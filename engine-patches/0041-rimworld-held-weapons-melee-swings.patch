+/// Seconds a melee swing takes (M23), how far the swinger lunges at its target, in cells, and
+/// the hands' height, of the picture's.
+const SWING_SECONDS: f32 = 0.4;
+const LUNGE_CELLS: f32 = 0.5;
+const HANDS: f32 = 0.42;
+/// A held weapon's angle at the start of a swing, raised, and at its end, struck down, in
+/// degrees from where it aims.
+const SWING_RAISED: f32 = 80.0;
+const SWING_STRUCK: f32 = -60.0;
+/// Blocks a held weapon sits towards the eye from the body, so the two never fight.
+const HELD_FRONT: f32 = 0.06;
+
+/// Where `figure` points what it holds, degrees clockwise from north: where RimWorld says it
+/// aims or attacks, else forward and to its right, as RimWorld carries a weapon (143 degrees
+/// facing east).
+fn aim_of(figure: &Figure) -> f32 {
+    figure.held.as_ref().and_then(|held| held.aim).unwrap_or(figure.yaw + 53.0)
+}
+
+/// A heading as a block-space direction on the ground, `[east, south]`.
+fn compass(degrees: f32) -> [f32; 2] {
+    let r = degrees.to_radians();
+    [r.sin(), -r.cos()]
+}
+
+/// How far into its lunge a swing `left` seconds from its end is, 0 to 1 and back.
+fn swing_lunge(left: f32) -> f32 {
+    if left <= 0.0 {
+        return 0.0;
+    }
+    (std::f32::consts::PI * (1.0 - left / SWING_SECONDS)).sin().max(0.0)
+}
+
+/// How far a swing `left` seconds from its end has brought the weapon down: from
+/// [`SWING_RAISED`] to [`SWING_STRUCK`] degrees, eased; 0 when not swinging.
+fn swing_angle(left: f32) -> f32 {
+    if left <= 0.0 {
+        return 0.0;
+    }
+    let t = (1.0 - left / SWING_SECONDS).clamp(0.0, 1.0);
+    let eased = t * t * (3.0 - 2.0 * t);
+    SWING_RAISED + (SWING_STRUCK - SWING_RAISED) * eased
+}
+
+/// The weapon in `figure`'s hands (M23), drawn as RimWorld draws it from above, turned to
+/// the view: RimWorld's picture standing at the hands, pointing where the pawn aims as that
+/// looks from `eye` (towards the eye points it down, away from it up), mirrored to point
+/// left as RimWorld mirrors it to point west, and turned by the weapon's own offset. In a
+/// melee swing it comes down from raised to struck.
+#[allow(clippy::too_many_arguments)]
+fn add_held(
+    vertices: &mut Vec<Vertex>,
+    indices: &mut Vec<u32>,
+    figure: &Figure,
+    [x, z]: [f32; 2],
+    card: &Card,
+    held: &rimworld_bridge::Held,
+    eye: [f64; 3],
+    cutouts: &HashMap<u16, [f32; 4]>,
+    color: [f32; 4],
+) {
+    let Some(tex) = u16::try_from(held.tex).ok() else { return };
+    let Some(&[u0, v0, u1, v1]) = cutouts.get(&tex) else { return };
+    let to_eye = Vec3::new(eye[0] as f32 - x, 0.0, eye[2] as f32 - z).normalize_or(Vec3::Z);
+    // The view's right, seen from the eye.
+    let right = Vec3::new(to_eye.z, 0.0, -to_eye.x);
+    let [dx, dz] = compass(aim_of(figure));
+    let aim = Vec3::new(dx, 0.0, dz);
+    let toward = aim.dot(to_eye);
+    let rest = if held.aim.is_some() { 0.0 } else { 0.35 };
+    let seen = Vec2::new(aim.dot(right), -0.45 * toward - rest);
+    let seen = if seen.length() < 1e-3 { Vec2::X } else { seen.normalize() };
+    // As RimWorld would draw it aiming that way on its map, up the screen being north.
+    let mut angle = seen.x.atan2(seen.y).to_degrees().rem_euclid(360.0);
+    let lifted = swing_angle(figure.swing);
+    angle = if angle < 180.0 { angle - lifted } else { angle + lifted }.rem_euclid(360.0);
+    let flip = angle > 200.0 && angle < 340.0;
+    let turn = if flip { angle - 270.0 - held.turn } else { angle - 90.0 + held.turn };
+    let (sin, cos) = turn.to_radians().sin_cos();
+    // Clockwise on the screen: the picture's right goes down, its top goes right.
+    let across = right * cos - Vec3::Y * sin;
+    let up = right * sin + Vec3::Y * cos;
+    let width = held.size[0] * card.per_cell * (u1 - u0);
+    let height = held.size[1] * card.per_cell * (v1 - v0);
+    let reach = (0.4 + held.reach).max(0.0) * card.per_cell;
+    let front = if toward < -0.3 { -HELD_FRONT } else { HELD_FRONT };
+    let lift = if figure.bed { BED_TOP } else { 0.0 };
+    let centre = Vec3::new(x, lift + card.height * HANDS, z) + aim * reach + to_eye * front;
+    let (u0, u1) = if flip { (u1, u0) } else { (u0, u1) };
+    let corners = [(-0.5, -0.5, [u0, v1]), (0.5, -0.5, [u1, v1]), (0.5, 0.5, [u1, v0]), (-0.5, 0.5, [u0, v0])];
+    let base = vertices.len() as u32;
+    for (a, b, uv) in corners {
+        let p = centre + across * (a * width) + up * (b * height);
+        vertices.push(Vertex { position: p.to_array(), uv: small_uv(tex, uv), color, sky_light: 15.0, block_light: 0.0 });
+    }
+    indices.extend([base, base + 1, base + 2, base, base + 2, base + 3]);
+    indices.extend([base, base + 2, base + 1, base, base + 3, base + 2]);
+}
