+/// Where a bullet flying from `from` to `to` first meets a wall, rock or the floor's edge,
+/// if it does. As in RimWorld, a wall next to the shooter's cell does not stop it: a pawn
+/// leans out past a corner to shoot.
+fn first_wall(lay: Lay<'_>, from: Vec3, to: Vec3) -> Option<Vec3> {
+    let cell = |p: Vec3| (p.x.floor() as i32, p.z.floor() as i32);
+    let (start_x, start_z) = cell(from);
+    let length = from.distance(to);
+    let steps = (length / TRACER_STEP).ceil() as i32;
+    (1..=steps).map(|i| from.lerp(to, i as f32 / steps as f32)).find(|&p| {
+        let (x, z) = cell(p);
+        if (x - start_x).abs() <= 1 && (z - start_z).abs() <= 1 {
+            return false;
+        }
+        match lay.code(x, z) {
+            None => true,
+            Some(code @ (terrain::ROCK | terrain::WALL)) => column(code).contains(&(p.y.floor() as i32)),
+            Some(_) => false,
+        }
+    })
+}
