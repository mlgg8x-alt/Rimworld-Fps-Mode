+/// A thin square beam from `a` to `b`, in block space.
+fn add_segment(vertices: &mut Vec<Vertex>, indices: &mut Vec<u32>, a: Vec3, b: Vec3, half: f32, colour: [f32; 3]) {
+    let length = a.distance(b);
+    if length < 1e-3 {
+        return;
+    }
+    let ahead = (b - a) / length;
+    // Right and up as for a figure: ahead x up is right, right x ahead is up.
+    let right = ahead.cross(Vec3::Y).try_normalize().unwrap_or(Vec3::X);
+    let up = right.cross(ahead);
+    let middle = (a + b) / 2.0;
+    let at = |f: f32, r: f32, u: f32| (middle + ahead * f + right * r + up * (u - half)).to_array();
+    push_box(vertices, indices, at, [length / 2.0, half, half * 2.0], colour);
+}
