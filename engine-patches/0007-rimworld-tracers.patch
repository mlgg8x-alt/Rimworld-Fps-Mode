+/// A RimWorld bullet in flight across the floor, in block space.
+#[derive(Clone, Debug, PartialEq)]
+struct Tracer {
+    from: Vec3,
+    to: Vec3,
+    /// Blocks per second, and blocks its head has flown so far.
+    speed: f32,
+    flown: f32,
+}
+
+impl Tracer {
+    fn new(shot: &rimworld_bridge::Shot, size: i32) -> Self {
+        let block = |[x, y, z]: [f32; 3]| Vec3::new(x, y, size as f32 - z);
+        Self {
+            from: block(shot.from),
+            to: block(shot.to),
+            speed: shot.speed.unwrap_or(TRACER_SPEED).clamp(10.0, 500.0),
+            flown: 0.0,
+        }
+    }
+
+    /// The part of the path the tracer covers now, tail then head, or `None` once it has landed.
+    fn streak(&self) -> Option<(Vec3, Vec3)> {
+        let length = self.from.distance(self.to);
+        let tail = (self.flown - TRACER_LENGTH).max(0.0);
+        if tail >= length {
+            return None;
+        }
+        let along = |d: f32| self.from.lerp(self.to, (d / length.max(1e-3)).min(1.0));
+        Some((along(tail), along(self.flown)))
+    }
 }
 
