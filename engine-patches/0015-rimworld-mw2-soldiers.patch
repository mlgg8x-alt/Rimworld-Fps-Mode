+/// MW2's animations a soldier plays, by name: the first the map has of each list, else the
+/// first whose name has all of the words.
+const STAND_CLIPS: (&[&str], &[&str]) = (&["pb_stand_alert", "pb_stand_alert_pistol", "pb_stand_idle"], &["pb_stand"]);
+const RUN_CLIPS: (&[&str], &[&str]) =
+    (&["pb_combatrun_forward_loop", "pb_run_fast", "pb_run_forward", "pb_sprint"], &["pb_", "run", "forward"]);
+const PRONE_CLIPS: (&[&str], &[&str]) = (&["pb_prone_aim", "pb_prone_hold", "pb_prone_crawl"], &["pb_prone"]);
+/// Blocks a second above which a soldier runs.
+const RUN_FROM: f32 = 0.6;
+
+/// One animation: its name and how much of it plays a second.
+#[derive(Clone, Debug, PartialEq)]
+struct Clip {
+    name: String,
+    frequency: f32,
+}
+
+/// What a soldier is doing.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+enum Action {
+    Stand,
+    Run,
+    Prone,
+}
+
+/// A pawn's MW2 soldier: the model entity, and where it stood last frame.
+struct Soldier {
+    entity: Entity,
+    last: [f32; 2],
+}
+
+/// The soldiers on the floor and what they play. Every soldier doing the same thing is at
+/// the same point of its animation, so they share one pose.
+#[derive(Default)]
+struct Soldiers {
+    by_pawn: HashMap<String, Soldier>,
+    next_id: u32,
+    /// The animations, once looked up; `None` inside when the map has no standing one.
+    clips: Option<Option<HashMap<Action, Clip>>>,
+    times: HashMap<Action, (f32, i16)>,
+    revision: u32,
+}
+
+/// The first animation `names` has of `wanted`'s list, else the first with all its words
+/// that is not for a pistol (they hold one hand up).
+fn pick_clip<'a>(names: &[&'a str], (exact, words): (&[&str], &[&str])) -> Option<&'a str> {
+    exact.iter().find_map(|want| names.iter().copied().find(|name| name == want)).or_else(|| {
+        names.iter().copied().find(|name| !name.contains("pistol") && words.iter().all(|word| name.contains(word)))
+    })
+}
+
+/// The soldier model and head for a side, if the map has them: the other side's for raiders.
+fn soldier_kit(bodies: &assets::PreparedBodies, hostile: bool) -> Option<(String, Option<String>)> {
+    let kit = bodies.0.kits().kit(hostile)?;
+    Some((kit.body.clone(), kit.head.clone()))
+}
+
+/// A soldier's model and pose: `body` with `head` on its neck, playing `clip` at `time`.
+fn soldier_state(body: &str, head: Option<&str>, clip: &str, time: f32, revision: u32) -> xmodel_runtime::DObjSemanticState {
+    let mut state = xmodel_runtime::DObjSemanticState::one_leaf(body.to_owned(), clip.to_owned(), 1, revision, time);
+    if let Some(head) = head {
+        state.composition.models.push(xmodel_runtime::DObjModelDescriptor {
+            model: head.to_owned(),
+            parent_model: Some(0),
+            attach_tag: Some(xmodel_runtime::TP_HEAD_ATTACH_TAG.to_owned()),
+            ignore_collision: true,
+        });
+    }
+    state
+}
+
+/// Where a soldier stands and faces: on the floor's top at its figure, turned as RimWorld's
+/// `rot` (clockwise from north), where MW2's yaw 0 is east and grows anticlockwise.
+fn soldier_transform(origin: [f64; 3], figure: &Figure) -> Transform {
+    let at = sim::voxel::to_map(origin, [f64::from(figure.x), 0.0, f64::from(figure.z)]);
+    Transform::from_translation(Vec3::from_array(at)).with_rotation(Quat::from_rotation_z((90.0 - figure.yaw).to_radians()))
+}
+
+/// Puts an MW2 soldier on each person on the floor (not the one the player plays), moves it
+/// with them, and takes it away when they go.
+#[allow(clippy::too_many_arguments)]
+fn place_soldiers(
+    mut commands: Commands,
+    time: Res<Time>,
+    mut floor: ResMut<FlatFloor>,
+    bodies: Option<Res<assets::PreparedBodies>>,
+    xanims: Option<Res<assets::PreparedXAnims>>,
+    catalog: Option<Res<asset_world::MapXModelSceneCatalog>>,
+    mut models: Query<(&mut render_scene::WorldScriptModelInstance, &mut Transform)>,
+    mut soldiers: Local<Soldiers>,
+) {
+    let ready = floor.active && bodies.is_some() && xanims.is_some() && catalog.is_some();
+    if !ready {
+        for (_, soldier) in soldiers.by_pawn.drain() {
+            commands.entity(soldier.entity).despawn();
+        }
+        // A new match may have other animations.
+        soldiers.clips = None;
+        floor.soldiers.clear();
+        return;
+    }
+    let (Some(bodies), Some(xanims), Some(catalog)) = (bodies, xanims, catalog) else {
+        return;
+    };
+    let clips = soldiers
+        .clips
+        .get_or_insert_with(|| {
+            let names: Vec<&str> = xanims.0.names().collect();
+            let mut clips = HashMap::new();
+            for (action, wanted) in [(Action::Stand, STAND_CLIPS), (Action::Run, RUN_CLIPS), (Action::Prone, PRONE_CLIPS)] {
+                let Some(name) = pick_clip(&names, wanted) else { continue };
+                let Some(clip) = xanims.0.clip(asset_core::AssetNamespace::Iw4, name) else { continue };
+                let frames = f32::from(clip.numframes.saturating_sub(1).max(1));
+                clips.insert(action, Clip { name: name.to_owned(), frequency: clip.framerate / frames });
+            }
+            let player: Vec<&&str> = names.iter().filter(|name| name.starts_with("pb_")).collect();
+            diag::info!(Zone, "rimworld: soldier animations {clips:?}, from {} player animations: {player:?}", player.len());
+            clips.contains_key(&Action::Stand).then_some(clips)
+        })
+        .clone();
+    let Some(clips) = clips else {
+        floor.soldiers.clear();
+        return;
+    };
+    // Every soldier's animations, a step on.
+    let dt = time.delta_secs();
+    soldiers.revision = soldiers.revision.wrapping_add(1);
+    for (action, clip) in &clips {
+        let (t, cycles) = soldiers.times.get(action).copied().unwrap_or((0.0, 0));
+        let next = anim_iw4::advance_leaf_time(t, cycles, 1.0, clip.frequency, dt, *action != Action::Prone);
+        soldiers.times.insert(*action, next);
+    }
+    let has = |name: &str| matches!(catalog.get_name(name), Some(asset_world::MapXModelSceneAsset::Iw4(_)));
+    let playing = floor.playing.clone();
+    let mut shown = std::collections::HashSet::new();
+    let origin = floor.origin;
+    for (id, figure) in &floor.figures {
+        if figure.kind != Kind::Humanlike || playing.as_deref() == Some(id.as_str()) {
+            continue;
+        }
+        let Some((body, head)) = soldier_kit(&bodies, figure.side == SideColour::Hostile) else { continue };
+        if !has(&body) {
+            continue;
+        }
+        let head = head.filter(|head| has(head));
+        let transform = soldier_transform(origin, figure);
+        let moved = soldiers
+            .by_pawn
+            .get(id)
+            .map_or(0.0, |soldier| Vec2::from(soldier.last).distance(Vec2::new(figure.x, figure.z)));
+        let speed = if dt > 0.0 { moved / dt } else { 0.0 };
+        let action = match () {
+            _ if figure.downed => Action::Prone,
+            _ if speed > RUN_FROM => Action::Run,
+            _ => Action::Stand,
+        };
+        let action = if clips.contains_key(&action) { action } else { Action::Stand };
+        let clip = &clips[&action];
+        let (anim_time, _) = soldiers.times.get(&action).copied().unwrap_or_default();
+        let state = soldier_state(&body, head.as_deref(), &clip.name, anim_time, soldiers.revision);
+        let model = asset_world::MapXModelAssetKey(body.clone());
+        let [x, y, z] = transform.translation.to_array();
+        let lighting_origin = [x, y, z + 40.0];
+        let existing = soldiers.by_pawn.get(id).map(|soldier| soldier.entity);
+        match existing.and_then(|entity| models.get_mut(entity).ok()) {
+            Some((mut instance, mut place)) => {
+                *place = transform;
+                instance.transform = transform;
+                instance.current_model = model;
+                instance.dobj_state = state;
+                instance.lighting_origin = lighting_origin;
+            }
+            None => {
+                let number = soldiers.next_id;
+                soldiers.next_id = soldiers.next_id.wrapping_add(1);
+                let model_id = render_anim::occupancy::script_model::CLIENT_MODEL_IDS.start
+                    + number % render_anim::occupancy::script_model::CLIENT_MODEL_IDS.len() as u32;
+                let entity = commands
+                    .spawn((
+                        render_anim::occupancy::script_model::ClientSceneModel { id: model_id },
+                        transform,
+                        Visibility::Inherited,
+                        render_scene::WorldScriptModelInstance {
+                            id: asset_world::ScriptModelId::from_source_ordinal(model_id),
+                            authority_owner: None,
+                            current_model: model,
+                            transform,
+                            lighting_origin,
+                            dobj_state: state,
+                            metadata: asset_world::ScriptModelMetadata::default(),
+                            gentity_number: None,
+                        },
+                    ))
+                    .id();
+                if let Some(old) = existing {
+                    commands.entity(old).try_despawn();
+                }
+                soldiers.by_pawn.insert(id.clone(), Soldier { entity, last: [figure.x, figure.z] });
+            }
+        }
+        if let Some(soldier) = soldiers.by_pawn.get_mut(id) {
+            soldier.last = [figure.x, figure.z];
+        }
+        shown.insert(id.clone());
+    }
+    soldiers.by_pawn.retain(|id, soldier| {
+        let keep = shown.contains(id);
+        if !keep {
+            commands.entity(soldier.entity).try_despawn();
+        }
+        keep
+    });
+    floor.soldiers = shown;
+}
