+/// Moves every tracer along its path and drops the ones that have landed. Those that met
+/// the player's `body` on the way stop there: returned as their ids and the part struck.
+/// The `playing` colonist's own bullets pass.
+fn fly_tracers(tracers: &mut Vec<Tracer>, dt: f32, body: Option<&Body>, playing: Option<&str>) -> Vec<(String, &'static str)> {
+    let mut struck = Vec::new();
     for tracer in tracers.iter_mut() {
+        let before = tracer.flown;
         tracer.flown += tracer.speed * dt;
+        let Some(body) = body.filter(|_| tracer.id.is_some() && Some(tracer.shooter.as_str()) != playing) else {
+            continue;
+        };
+        let (a, b) = (tracer.along(before), tracer.along(tracer.flown));
+        if before < tracer.from.distance(tracer.to)
+            && let Some(f) = body.entry(a, b)
+            && let Some(id) = tracer.id.take()
+        {
+            let at = a.lerp(b, f);
+            struck.push((id, body.part(at)));
+            tracer.to = at;
+        }
     }
     tracers.retain(|tracer| tracer.streak().is_some());
+    struck
