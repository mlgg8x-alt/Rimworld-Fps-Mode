+
+impl Body {
+    /// A player standing at map point `feet` whose eye is `view_height` MW2 units above them,
+    /// on a floor whose middle is `origin`.
+    fn of(origin: [f64; 3], feet: [f32; 3], view_height: f32) -> Self {
+        let at = sim::voxel::to_block(origin, feet);
+        let at = Vec3::new(at[0] as f32, at[1] as f32, at[2] as f32);
+        let half = BODY_HALF_WIDTH / BLOCK;
+        let top = at.y + (view_height + BODY_ABOVE_EYE).max(BODY_ABOVE_EYE) / BLOCK;
+        Self {
+            min: Vec3::new(at.x - half, at.y, at.z - half),
+            max: Vec3::new(at.x + half, top, at.z + half),
+            head: at.y + (view_height - HEAD_BELOW_EYE) / BLOCK,
+        }
+    }
