+/// Where a bullet flying from `from` to `to` first meets something solid at its height: rock,
+/// a wall, cover, a machine, a door's lintel, a roof or the floor's edge. Trees let bullets
+/// by, as does anything in the cells beside the shooter's, which they lean out past.
+fn first_block(lay: Lay<'_>, from: Vec3, to: Vec3) -> Option<Vec3> {
+    let block = |p: Vec3| (p.x.floor() as i32, p.y.floor() as i32, p.z.floor() as i32);
+    let start = (from.x.floor() as i32).div_euclid(CELL);
+    let start_z = (from.z.floor() as i32).div_euclid(CELL);
+    let steps = (from.distance(to) / TRACER_STEP).ceil() as i32;
+    (1..=steps).map(|i| from.lerp(to, i as f32 / steps as f32)).find(|&p| {
+        let (x, y, z) = block(p);
+        if (x.div_euclid(CELL) - start).abs() <= 1 && (z.div_euclid(CELL) - start_z).abs() <= 1 {
+            return false;
+        }
+        if lay.code(x, z).is_none() {
+            return true;
+        }
+        match lay.cell(x, y, z) {
+            Cell::Column(code) => code != terrain::TREE,
+            Cell::Wall | Cell::Roof | Cell::Ground(_) | Cell::Floor => true,
+            Cell::Air => false,
+        }
+    })
 }
 
