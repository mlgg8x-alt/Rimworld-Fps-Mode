+/// MW2 models for each RimWorld plant kind, from the stand-in map (Estate's forest has
+/// pines, birches, oaks and bushes): any the map has, one picked per plant for variety,
+/// standing this many blocks high when fully grown. A kind with none the map has borrows
+/// the next kind's (palms and cacti have none in Estate).
+const PLANT_KINDS: [(&str, &[&str], f32); 7] = [
+    ("pine", &["foliage_red_pine_med", "foliage_red_pine_lg", "foliage_red_pine_sm", "foliage_tree_green_pine_lg_a"], 9.0),
+    ("birch", &["foliage_tree_birch_green_1", "foliage_tree_river_birch_xl_a"], 8.0),
+    ("oak", &["foliage_tree_grey_oak_xl_a", "foliage_tree_river_birch_xl_a"], 8.0),
+    ("dead", &["foliage_dead_pine_med", "foliage_dead_pine_lg", "foliage_tree_birch_bare_1", "foliage_tree_birch_bare_2"], 7.0),
+    ("palm", &[], 8.0),
+    ("cactus", &[], 1.6),
+    ("bush", &["foliage_bush_big_mp", "foliage_shrub_group01", "foliage_shrub_greenfan", "foliage_pacific_bushtree01"], 1.4),
+];
+/// The kind a kind with no models borrows from.
+fn plant_fallback(kind: &str) -> Option<&'static str> {
+    match kind {
+        "palm" | "birch" | "dead" => Some("oak"),
+        "oak" => Some("pine"),
+        "cactus" => Some("bush"),
+        _ => None,
+    }
+}
+/// The most plants drawn at once, nearest the view first, out to this many cells; and
+/// seconds between choosing them again.
+const PLANT_MODELS: usize = 500;
+const PLANT_REACH: f32 = 60.0;
+const PLANT_RESELECT_SECONDS: f32 = 0.5;
+/// The part of a full grown plant's height a seedling stands.
+const SEEDLING: f32 = 0.35;
+/// Model ids for plants, apart from the soldiers'.
+const PLANT_IDS_FROM: u32 = 0x2000_0000;
+
+/// A plant drawn as an MW2 model, by its cell.
+struct PlantModel {
+    entity: Entity,
+    model: String,
+    growth: f32,
+}
+
+/// The plants drawn now, and the models each kind may use.
+#[derive(Default)]
+struct Plants {
+    by_cell: HashMap<(i32, i32), PlantModel>,
+    next_id: u32,
+    /// Each kind's models the map has, with each one's height in map units; looked up once.
+    models: Option<HashMap<&'static str, Vec<(&'static str, f32)>>>,
+    revision: u64,
+    since_select: f32,
+    selected_at: Option<[f64; 3]>,
+}
+
+/// A fixed number from 0 to 1 for a cell, so each plant keeps its look.
+fn cell_hash(x: i32, z: i32, salt: u32) -> f32 {
+    let h = (x as u32).wrapping_mul(73_856_093) ^ (z as u32).wrapping_mul(19_349_663) ^ salt.wrapping_mul(83_492_791);
+    (h.wrapping_mul(2_654_435_761) >> 8) as f32 / (1u32 << 24) as f32
+}
+
+/// The model and its height for a plant of `kind` on cell `(x, z)`, among `models`.
+fn plant_model<'a>(models: &'a HashMap<&'static str, Vec<(&'static str, f32)>>, kind: &str, x: i32, z: i32) -> Option<(&'a str, f32, f32)> {
+    let mut kind = kind;
+    for _ in 0..4 {
+        let (_, _, blocks) = PLANT_KINDS.iter().find(|(name, _, _)| *name == kind)?;
+        match models.get(kind).filter(|list| !list.is_empty()) {
+            Some(list) => {
+                let (model, height) = list[(cell_hash(x, z, 1) * list.len() as f32) as usize % list.len()];
+                return Some((model, height, *blocks));
+            }
+            None => kind = plant_fallback(kind)?,
+        }
+    }
+    None
+}
+
+/// Where a plant stands: on its cell's middle, turned and sized for its growth.
+fn plant_transform(origin: [f64; 3], size: i32, plant: &rimworld_bridge::PlantState, height: f32, blocks: f32) -> Transform {
+    let at = sim::voxel::to_map(origin, [f64::from(plant.x) + 0.5, 0.0, f64::from(size - plant.z) - 0.5]);
+    let grown = SEEDLING + (1.0 - SEEDLING) * plant.growth.clamp(0.0, 1.0);
+    let jitter = 0.9 + 0.2 * cell_hash(plant.x, plant.z, 2);
+    let scale = blocks * BLOCK * grown * jitter / height.max(1.0);
+    Transform::from_translation(Vec3::from_array(at))
+        .with_rotation(Quat::from_rotation_z(cell_hash(plant.x, plant.z, 3) * std::f32::consts::TAU))
+        .with_scale(Vec3::splat(scale))
+}
+
+/// A model's height in its own units, from its vertices; `None` for one with none.
+fn model_height(skel: &asset_model::ModelSkel) -> Option<f32> {
+    let (low, high) = skel.positions.iter().fold((f32::MAX, f32::MIN), |(lo, hi), p| (lo.min(p[2]), hi.max(p[2])));
+    (high > low).then_some(high - low)
+}
+
+/// Puts an MW2 tree or bush on each of RimWorld's plants near the view, and takes it away
+/// when it goes. While the map has tree models, trees are not drawn as blocks.
+#[allow(clippy::too_many_arguments)]
+fn place_plants(
+    mut commands: Commands,
+    time: Res<Time>,
+    mut floor: ResMut<FlatFloor>,
+    link: Option<Res<RimworldLink>>,
+    catalog: Option<Res<asset_world::MapXModelSceneCatalog>>,
+    mut models: Query<(&mut render_scene::WorldScriptModelInstance, &mut Transform)>,
+    mut plants: Local<Plants>,
+) {
+    let plants = &mut *plants;
+    let (Some(catalog), true) = (catalog, floor.active) else {
+        for (_, plant) in plants.by_cell.drain() {
+            commands.entity(plant.entity).try_despawn();
+        }
+        plants.models = None;
+        plants.selected_at = None;
+        floor.tree_models = false;
+        return;
+    };
+    let kinds = plants.models.get_or_insert_with(|| {
+        let mut kinds = HashMap::new();
+        for (kind, names, _) in PLANT_KINDS {
+            let found: Vec<(&'static str, f32)> = names
+                .iter()
+                .filter_map(|name| match catalog.get_name(name) {
+                    Some(asset_world::MapXModelSceneAsset::Iw4(skel)) if skel.pose.is_some() => Some((*name, model_height(skel)?)),
+                    _ => None,
+                })
+                .collect();
+            kinds.insert(kind, found);
+        }
+        diag::info!(Zone, "rimworld: plant models {kinds:?}");
+        println!(
+            "[rimworld] MW2 plant models: {}",
+            kinds.values().map(Vec::len).sum::<usize>()
+        );
+        kinds
+    });
+    let has_trees = ["pine", "oak", "birch"].iter().any(|kind| kinds.get(kind).is_some_and(|list| !list.is_empty()));
+    floor.tree_models = has_trees;
+    if !has_trees {
+        return;
+    }
+    let all = link.as_deref().and_then(|link| link.plants.clone().map(|plants| (link.plants_revision, plants)));
+    let Some((revision, all)) = all else {
+        return;
+    };
+    // Choose again when RimWorld's plants change, the view moved, or now and then.
+    plants.since_select += time.delta_secs();
+    let eye = floor.eye.unwrap_or(floor.origin);
+    let moved = plants.selected_at.is_none_or(|at| (at[0] - eye[0]).hypot(at[2] - eye[2]) > 4.0);
+    if revision == plants.revision && !moved && plants.since_select < PLANT_RESELECT_SECONDS {
+        return;
+    }
+    plants.revision = revision;
+    plants.since_select = 0.0;
+    plants.selected_at = Some(eye);
+    let size = floor.size;
+    let distance = |p: &rimworld_bridge::PlantState| {
+        let (bx, bz) = (f64::from(p.x) + 0.5, f64::from(size - p.z) - 0.5);
+        ((bx - eye[0]).hypot(bz - eye[2])) as f32
+    };
+    let mut near: Vec<(f32, &rimworld_bridge::PlantState)> =
+        all.iter().map(|p| (distance(p), p)).filter(|(d, _)| *d <= PLANT_REACH).collect();
+    near.sort_by(|a, b| a.0.total_cmp(&b.0));
+    near.truncate(PLANT_MODELS);
+    let Some(kinds) = plants.models.clone() else { return };
+    let mut keep = std::collections::HashSet::new();
+    for (_, plant) in near {
+        let Some((model, height, blocks)) = plant_model(&kinds, &plant.kind, plant.x, plant.z) else { continue };
+        let cell = (plant.x, plant.z);
+        let transform = plant_transform(floor.origin, size, plant, height, blocks);
+        keep.insert(cell);
+        if let Some(drawn) = plants.by_cell.get_mut(&cell) {
+            if drawn.model == model && (drawn.growth - plant.growth).abs() < 0.01 {
+                continue;
+            }
+            if let Ok((mut instance, mut place)) = models.get_mut(drawn.entity) {
+                // A new composition revision, so the model is composed again.
+                plants.next_id = plants.next_id.wrapping_add(1);
+                *place = transform;
+                instance.transform = transform;
+                instance.current_model = asset_world::MapXModelAssetKey(model.to_owned());
+                instance.dobj_state = xmodel_runtime::DObjSemanticState::bind_pose(model.to_owned(), plants.next_id, 1);
+                drawn.model = model.to_owned();
+                drawn.growth = plant.growth;
+                continue;
+            }
+        }
+        let number = plants.next_id;
+        plants.next_id = plants.next_id.wrapping_add(1);
+        let ids = render_anim::occupancy::script_model::CLIENT_MODEL_IDS;
+        let model_id = ids.start + PLANT_IDS_FROM + number % (ids.len() as u32 - PLANT_IDS_FROM);
+        let [x, y, z] = transform.translation.to_array();
+        let entity = commands
+            .spawn((
+                render_anim::occupancy::script_model::ClientSceneModel { id: model_id },
+                transform,
+                Visibility::Inherited,
+                render_scene::WorldScriptModelInstance {
+                    id: asset_world::ScriptModelId::from_source_ordinal(model_id),
+                    authority_owner: None,
+                    current_model: asset_world::MapXModelAssetKey(model.to_owned()),
+                    transform,
+                    lighting_origin: [x, y, z + 40.0],
+                    dobj_state: xmodel_runtime::DObjSemanticState::bind_pose(model.to_owned(), 1, 1),
+                    metadata: asset_world::ScriptModelMetadata::default(),
+                    gentity_number: None,
+                },
+            ))
+            .id();
+        if let Some(old) = plants.by_cell.insert(cell, PlantModel { entity, model: model.to_owned(), growth: plant.growth }) {
+            commands.entity(old.entity).try_despawn();
+        }
+    }
+    plants.by_cell.retain(|cell, plant| {
+        let kept = keep.contains(cell);
+        if !kept {
+            commands.entity(plant.entity).try_despawn();
+        }
+        kept
+    });
+}
