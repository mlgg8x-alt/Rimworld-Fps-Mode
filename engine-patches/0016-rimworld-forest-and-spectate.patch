+/// The keys that fly the spectating camera this frame.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+struct FlyKeys {
+    forward: f32,
+    right: f32,
+    up: f32,
+    fast: bool,
+}
+
+impl FlyKeys {
+    /// W A S D across, Space up, C or Ctrl down, Shift faster: as MW2's own move keys.
+    fn from_input(keys: &ButtonInput<KeyCode>) -> Self {
+        let axis = |plus: &[KeyCode], minus: &[KeyCode]| {
+            f32::from(u8::from(keys.any_pressed(plus.iter().copied()))) - f32::from(u8::from(keys.any_pressed(minus.iter().copied())))
+        };
+        Self {
+            forward: axis(&[KeyCode::KeyW, KeyCode::ArrowUp], &[KeyCode::KeyS, KeyCode::ArrowDown]),
+            right: axis(&[KeyCode::KeyD, KeyCode::ArrowRight], &[KeyCode::KeyA, KeyCode::ArrowLeft]),
+            up: axis(&[KeyCode::Space], &[KeyCode::KeyC, KeyCode::ControlLeft, KeyCode::ControlRight]),
+            fast: keys.any_pressed([KeyCode::ShiftLeft, KeyCode::ShiftRight]),
+        }
+    }
+}
+
+/// With no colonist to play, the player flies free over the map with nothing in their
+/// hands: the sim stops moving them, and they go wherever the camera does.
+fn spectate(
+    floor: &mut FlatFloor,
+    authority: &mut net::AuthorityWorld,
+    local: sim::ClientId,
+    keys: FlyKeys,
+    look: [i32; 3],
+    dt: f32,
+) {
+    let Some(ps) = authority.0.player(local).copied() else {
+        return;
+    };
+    if !floor.spectating {
+        floor.spectating = true;
+        floor.fly_eye = [ps.origin[0], ps.origin[1], ps.origin[2] + ps.view_height_current.max(FLY_EYE)];
+        floor.fly_pitch_fix = 0.0;
+        floor.armed_with = None;
+        authority.0.set_external_motion(local, true);
+        if let Err(error) = authority.0.set_only_weapon(local, 0) {
+            diag::warn!(World, "RimWorld flat floor: could not empty the player's hands: {error}");
+        }
+        println!("[rimworld] no colonist drafted: spectating (WASD to fly, Space up, C down, Shift faster)");
+    }
+    floor.fly_angles = fly_angles(look, ps.delta_angles, &mut floor.fly_pitch_fix);
+    floor.fly_eye = fly(floor.fly_eye, floor.fly_angles, keys, dt, floor.size as f32 * BLOCK / 2.0);
+    let [x, y, z] = floor.fly_eye;
+    authority.0.set_origin(local, [x, y, z - FLY_EYE]);
+    authority.0.set_viewangles(local, floor.fly_angles);
+    // Anything handed over since (a respawn's loadout) goes again.
+    if ps.weapon != 0 {
+        let _ = authority.0.set_only_weapon(local, 0);
+    }
+}
+
+/// Back from spectating: the sim moves the player again, and [`play_colonist`] puts them on
+/// their colonist.
+fn stop_spectating(floor: &mut FlatFloor, authority: &mut net::AuthorityWorld, local: sim::ClientId) {
+    floor.spectating = false;
+    floor.playing = None;
+    authority.0.set_external_motion(local, false);
+}
+
+/// The spectating view's angles, as the sim turns a player's view: the mouse's look angles
+/// plus the player's `delta_angles`, its pitch held within [`FLY_PITCH`] by `fix`.
+fn fly_angles(look: [i32; 3], delta: [f32; 3], fix: &mut f32) -> [f32; 3] {
+    let wrap = |degrees: f32| (degrees + 180.0).rem_euclid(360.0) - 180.0;
+    let commanded = look.map(|short| short as f32 * 360.0 / 65536.0);
+    let mut pitch = wrap(commanded[0] + delta[0] + *fix);
+    if pitch.abs() > FLY_PITCH {
+        let held = FLY_PITCH.copysign(pitch);
+        *fix += held - pitch;
+        pitch = held;
+    }
+    [pitch, wrap(commanded[1] + delta[1]), 0.0]
+}
+
+/// The camera at `eye` (map space) flown for `dt` seconds by `keys`, looking along `angles`:
+/// forward goes where the view points, up and down straight up and down. It stays above
+/// the floor, below [`FLY_CEILING`], and within `reach` of the middle across.
+fn fly(eye: [f32; 3], angles: [f32; 3], keys: FlyKeys, dt: f32, reach: f32) -> [f32; 3] {
+    let (pitch, yaw) = (angles[0].to_radians(), angles[1].to_radians());
+    let forward = Vec3::new(pitch.cos() * yaw.cos(), pitch.cos() * yaw.sin(), -pitch.sin());
+    let right = Vec3::new(yaw.sin(), -yaw.cos(), 0.0);
+    let way = forward * keys.forward + right * keys.right + Vec3::Z * keys.up;
+    let speed = FLY_SPEED * if keys.fast { FLY_FAST } else { 1.0 };
+    let moved = Vec3::from_array(eye) + way.normalize_or_zero() * speed * dt;
+    let reach = reach + 8.0 * BLOCK;
+    [moved.x.clamp(-reach, reach), moved.y.clamp(-reach, reach), moved.z.clamp(0.5 * BLOCK, FLY_CEILING * BLOCK)]
+}
+
+/// While spectating, the view is the flying camera's, not the player's.
+fn spectate_camera(
+    floor: Res<FlatFloor>,
+    kick: Option<ResMut<render_anim::occupancy::view_kick::SessionViewKick>>,
+    mut cameras: Query<&mut Transform, (With<render_scene::FlyCamera>, Without<render_scene::WorldScriptModelInstance>)>,
+) {
+    if !floor.active || !floor.spectating {
+        return;
+    }
+    let pose = render_scene::WorldCameraPose { origin: floor.fly_eye, angles: floor.fly_angles };
+    if let Some(mut kick) = kick {
+        kick.refdef_vieworg = pose.origin;
+        kick.refdef_view_angles = pose.angles;
+    }
+    let eye = render_scene::transform_from_iw_view(pose);
+    for mut transform in &mut cameras {
+        transform.translation = eye.translation;
+        transform.rotation = eye.rotation;
+    }
+}
