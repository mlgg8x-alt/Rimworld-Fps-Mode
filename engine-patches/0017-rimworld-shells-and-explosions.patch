+/// A mortar shell, grenade or rocket RimWorld fired, in flight across the floor, in block
+/// space: from where to where, how long it takes, how high it goes, and how long it has flown.
+#[derive(Clone, Debug, PartialEq)]
+struct ShellFlight {
+    from: Vec3,
+    to: Vec3,
+    seconds: f32,
+    apex: f32,
+    flown: f32,
+    arc: bool,
+    /// Its incoming whistle has started.
+    whistled: bool,
+}
+
+impl ShellFlight {
+    fn new(shell: &rimworld_bridge::Shell, size: i32) -> Self {
+        let block = |[x, y, z]: [f32; 3]| Vec3::new(x, y, size as f32 - z);
+        let (from, to) = (block(shell.from), block(shell.to));
+        let reach = from.distance(to);
+        // A mortar climbs high and drops; a thrown grenade or a rocket keeps low.
+        let apex = if shell.arc { (reach * 0.4).clamp(8.0, 60.0) } else { (reach * 0.12).clamp(0.3, 4.0) };
+        Self { from, to, seconds: shell.seconds.clamp(0.1, 30.0), apex, flown: 0.0, arc: shell.arc, whistled: false }
+    }
+
+    /// Where it is `t` seconds after leaving.
+    fn at(&self, t: f32) -> Vec3 {
+        let f = (t / self.seconds).clamp(0.0, 1.0);
+        self.from.lerp(self.to, f) + Vec3::Y * self.apex * 4.0 * f * (1.0 - f)
+    }
+
+    /// The streak it draws now, tail then head; `None` once it has landed.
+    fn streak(&self) -> Option<(Vec3, Vec3)> {
+        (self.flown < self.seconds).then(|| (self.at(self.flown - SHELL_STREAK_SECONDS), self.at(self.flown)))
+    }
+}
+
+/// Something for MW2 to show or sound, at a map point.
+#[derive(Clone, Debug, PartialEq)]
+enum Boom {
+    /// A shell about to land.
+    Whistle([f32; 3]),
+    /// An explosion: its radius in map units and RimWorld's damage type.
+    Explosion { at: [f32; 3], radius: f32, damage: String },
+}
+
+/// Flies each shell on for `dt` seconds and drops those that landed. Returns where the
+/// mortar shells now [`WHISTLE_SECONDS`] from landing will land.
+fn fly_shells(shells: &mut Vec<ShellFlight>, dt: f32) -> Vec<Vec3> {
+    let mut whistles = Vec::new();
+    for shell in shells.iter_mut() {
+        shell.flown += dt;
+        if shell.arc && !shell.whistled && shell.seconds - shell.flown <= WHISTLE_SECONDS {
+            shell.whistled = true;
+            whistles.push(shell.to);
+        }
+    }
+    shells.retain(|shell| shell.flown < shell.seconds);
+    whistles
+}
