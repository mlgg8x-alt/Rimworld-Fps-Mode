+/// MW2's weapons whose explosions stand in for RimWorld's, by RimWorld damage type and size:
+/// the first the game has. Big blasts (a mortar shell's) are an airstrike's, smaller ones a
+/// frag grenade's; smoke is a smoke grenade's, EMP a stun grenade's.
+const BIG_BLAST: &[&str] = &["artillery_mp", "stealth_bomb_mp", "ac130_105mm_mp", "frag_grenade_mp"];
+const SMALL_BLAST: &[&str] = &["frag_grenade_mp", "c4_mp", "semtex_mp"];
+const SMOKE_BLAST: &[&str] = &["smoke_grenade_mp", "frag_grenade_mp"];
+const EMP_BLAST: &[&str] = &["concussion_grenade_mp", "flash_grenade_mp", "frag_grenade_mp"];
+/// Cells of radius from which a blast is big.
+const BIG_BLAST_FROM: f32 = 2.5;
+/// MW2 sound aliases for a shell coming in, the first the game has; else the first alias
+/// whose name has "incoming" in it.
+const WHISTLES: &[&str] = &["mortar_incoming", "artillery_incoming", "fast_artillery_round", "mp_artillery_incoming"];
+/// Surface type for blasts, as `weapon_iw4::SURFACE_TYPE_NAMES`: dirt.
+const BLAST_SURFACE: u8 = 6;
+
+/// What the game has to show and sound RimWorld's explosions with, looked up once a match.
+#[derive(Clone, Debug, Default, PartialEq)]
+struct BoomKit {
+    big: Option<u32>,
+    small: Option<u32>,
+    smoke: Option<u32>,
+    emp: Option<u32>,
+    whistle: Option<String>,
+}
+
+/// The first of `names` the game has, as a weapon index.
+fn first_weapon(weapons: &assets::PreparedWeapons, names: &[&str]) -> Option<u32> {
+    names.iter().find_map(|name| weapons.0.resolve_index(name).ok().flatten())
+}
+
+/// The whistle among `aliases`: the first of [`WHISTLES`], else any with "incoming".
+fn pick_whistle<'a>(aliases: &[&'a str]) -> Option<&'a str> {
+    WHISTLES
+        .iter()
+        .find_map(|want| aliases.iter().copied().find(|alias| alias.eq_ignore_ascii_case(want)))
+        .or_else(|| aliases.iter().copied().find(|alias| alias.to_ascii_lowercase().contains("incoming")))
+}
+
+/// The weapon whose explosion shows a RimWorld blast.
+fn blast_weapon(kit: &BoomKit, radius_cells: f32, damage: &str) -> Option<u32> {
+    match damage {
+        "Smoke" => kit.smoke,
+        "EMP" => kit.emp,
+        _ if radius_cells >= BIG_BLAST_FROM => kit.big,
+        _ => kit.small,
+    }
+    .or(kit.small)
+}
+
+/// Shows and sounds RimWorld's explosions as MW2's own (the blast's effect and sound, as a
+/// grenade's or an airstrike's going off; no damage, RimWorld does that), and plays an
+/// incoming whistle where a mortar shell is about to land.
+fn present_booms(
+    mut commands: Commands,
+    mut floor: ResMut<FlatFloor>,
+    weapons: Option<Res<assets::PreparedWeapons>>,
+    bank: Option<Res<audio::SoundBank>>,
+    mut sounds: MessageWriter<audio::AliasCommand>,
+    mut kit: Local<Option<BoomKit>>,
+) {
+    let booms = std::mem::take(&mut floor.booms);
+    let (Some(weapons), true) = (weapons, floor.active) else {
+        *kit = None;
+        return;
+    };
+    let kit = kit.get_or_insert_with(|| {
+        let aliases: Vec<&str> = bank.as_deref().map_or_else(Vec::new, |bank| (0..).map_while(|i| bank.0.name_at(i)).collect());
+        let found = BoomKit {
+            big: first_weapon(&weapons, BIG_BLAST),
+            small: first_weapon(&weapons, SMALL_BLAST),
+            smoke: first_weapon(&weapons, SMOKE_BLAST),
+            emp: first_weapon(&weapons, EMP_BLAST),
+            whistle: pick_whistle(&aliases).map(str::to_owned),
+        };
+        let shell_sounds: Vec<&&str> = aliases
+            .iter()
+            .filter(|alias| ["incoming", "whistle", "artillery", "mortar"].iter().any(|word| alias.to_ascii_lowercase().contains(word)))
+            .collect();
+        diag::info!(World, "rimworld: explosions {found:?}; shell sounds in the bank: {shell_sounds:?}");
+        found
+    });
+    for boom in booms {
+        match boom {
+            Boom::Whistle(at) => {
+                if let Some(alias) = &kit.whistle {
+                    sounds.write(audio::AliasCommand::Play(audio::PlayAlias {
+                        namespace: asset_core::AssetNamespace::Iw4,
+                        alias: alias.clone(),
+                        fallback: None,
+                        origin_inches: Some(at),
+                        snd_ent: None,
+                    }));
+                }
+            }
+            Boom::Explosion { at, radius, damage } => {
+                let Some(weapon) = blast_weapon(kit, radius / BLOCK, &damage) else { continue };
+                commands.trigger(net::EntityExplosion {
+                    entity: Entity::PLACEHOLDER,
+                    event: net::DispatchedEntityEvent {
+                        sequence: sim::EventSequence::default(),
+                        tick: sim::Tick::default(),
+                        event: entity_iw4::EntityEventKind::GRENADE_EXPLODE,
+                        payload: sim::EntityEventPayload {
+                            weapon,
+                            origin: at,
+                            direction: [0.0, 0.0, 1.0],
+                            surf_type: BLAST_SURFACE,
+                            number: -1,
+                            ..Default::default()
+                        },
+                    },
+                });
+            }
+        }
+    }
+}
