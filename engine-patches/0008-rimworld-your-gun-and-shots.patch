+/// Each figure as bullets see it: pawn id, whether it is a standing person
+/// (with a head to hit), and a block-space box around it.
+fn targets(figures: &HashMap<String, Figure>, playing: Option<&str>) -> Vec<(String, bool, [f64; 6])> {
+    let mut targets: Vec<_> = figures
+        .iter()
+        .filter(|(id, _)| Some(id.as_str()) != playing)
+        .map(|(id, figure)| {
+            let (half, height) = match (figure.kind, figure.downed) {
+                (Kind::Humanlike, false) => (0.3, 1.81),
+                (Kind::Humanlike, true) => (0.6, 0.3),
+                (Kind::Animal, false) => (0.45, 0.78),
+                (Kind::Animal, true) => (0.45, 0.3),
+                (Kind::Mech, false) => (0.45, 1.6),
+                (Kind::Mech, true) => (0.45, 0.4),
+                (Kind::Other, _) => (0.25, 0.5),
+            };
+            let (x, z) = (f64::from(figure.x), f64::from(figure.z));
+            let head = figure.kind == Kind::Humanlike && !figure.downed;
+            (id.clone(), head, [x - half, 0.0, z - half, x + half, height, z + half])
+        })
+        .collect();
+    // Steady keys from frame to frame.
+    targets.sort_by(|a, b| a.0.cmp(&b.0));
+    targets
+}
+
+/// The player's bullets among this frame's `sim::voxel` events, as `player_shot`s:
+/// each `Ray` starting at the player's eye, with the target its `MobShot` struck.
+fn player_shots(
+    floor: &FlatFloor,
+    authority: &net::AuthorityWorld,
+    local: sim::ClientId,
+    pawn: &str,
+    events: &[sim::voxel::VoxelEvent],
+) -> Vec<BridgeMessage> {
+    let Some(ps) = authority.0.player(local) else {
+        return Vec::new();
+    };
+    let eye = sim::voxel::to_block(floor.origin, [ps.origin[0], ps.origin[1], ps.origin[2] + ps.view_height_current]);
+    shots_from(floor, eye, authority.0.weapon_script_name(ps.weapon), pawn, events)
+}
+
+/// [`player_shots`] for a player whose eye is at block point `eye`, holding `weapon`.
+fn shots_from(floor: &FlatFloor, eye: [f64; 3], weapon: &str, pawn: &str, events: &[sim::voxel::VoxelEvent]) -> Vec<BridgeMessage> {
+    let mine = |from: &[f64; 3]| (0..3).map(|k| (from[k] - eye[k]).powi(2)).sum::<f64>().sqrt() < OWN_SHOT_REACH;
+    let rimworld = |b: [f64; 3]| [b[0] as f32, b[1] as f32, (f64::from(floor.size) - b[2]) as f32];
+    let mut shots = Vec::new();
+    // A mob hit comes just before its bullet's ray.
+    let mut struck: Option<(u64, f32)> = None;
+    for event in events {
+        match *event {
+            sim::voxel::VoxelEvent::MobShot { key, damage, from } if mine(&from) => struck = Some((key, damage)),
+            sim::voxel::VoxelEvent::Ray { from, to, .. } if mine(&from) => {
+                let hit = struck.take().and_then(|(key, damage)| Some((floor.targets.get(key as usize)?, damage)));
+                let (target, part, damage) = match hit {
+                    Some(((id, head, bounds), damage)) => {
+                        let up = (to[1] - bounds[1]) / (bounds[4] - bounds[1]).max(1e-6);
+                        let part = if *head && up > HEAD_FROM { "head" } else { "body" };
+                        (Some(id.clone()), Some(part.to_owned()), Some(damage))
+                    }
+                    None => (None, None, None),
+                };
+                shots.push(BridgeMessage::PlayerShot {
+                    pawn: pawn.to_owned(),
+                    weapon: weapon.to_owned(),
+                    from: rimworld(from),
+                    to: rimworld(to),
+                    target,
+                    part,
+                    damage,
+                });
+            }
+            _ => {}
+        }
+    }
+    shots
+}
