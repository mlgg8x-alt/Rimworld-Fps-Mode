+    /// Leaves the player holding only `weapon` (0: empty handed), as GSC's
+    /// `takeAllWeapons`, `giveWeapon` and `switchToWeaponImmediate`.
+    pub fn set_only_weapon(&mut self, id: ClientId, weapon: u32) -> Result<(), String> {
+        let mut frame = self.frame();
+        crate::script_player::take_all_weapons(&mut frame, id);
+        if weapon == 0 {
+            return Ok(());
+        }
+        crate::script_player::give_weapon(&mut frame, id, weapon, false)?;
+        crate::script_player::switch_to_weapon_immediate(&mut frame, id, weapon)
+    }
