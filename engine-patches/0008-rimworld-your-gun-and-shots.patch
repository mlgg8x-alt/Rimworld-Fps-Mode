+        assert_eq!(mw2_weapon(Some("Gun_SniperRifle")), Some("cheytac_mp"));
+        assert_eq!(mw2_weapon(Some("Gun_SomeModdedRifle")), Some("m4_mp"));
+        assert_eq!(mw2_weapon(Some("MeleeWeapon_Knife")), None);
+        assert_eq!(mw2_weapon(None), None);
+    }
