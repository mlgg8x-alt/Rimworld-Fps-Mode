+    #[test]
+    fn the_players_bullets_go_to_rimworld_with_what_they_struck() {
+        use sim::voxel::VoxelEvent::{MobShot, Ray};
+        let mut floor = FlatFloor { size: 250, ..Default::default() };
+        follow_pawns(&mut floor.figures, &[pawn("a", 10.5, 239.5)], 250, 0.016);
+        floor.targets = targets(&floor.figures, None);
+        let eye = [20.0, 1.6, 10.5];
+        let events = [
+            // A head shot on "a", then a miss, then someone else's bullet.
+            MobShot { key: 0, damage: 40.0, from: eye },
+            Ray { from: eye, to: [10.8, 1.7, 10.5], damage: 30.0 },
+            Ray { from: eye, to: [0.0, 0.0, 10.5], damage: 30.0 },
+            MobShot { key: 0, damage: 30.0, from: [10.0, 1.6, 30.0] },
+            Ray { from: [10.0, 1.6, 30.0], to: [10.5, 1.0, 10.8], damage: 30.0 },
+        ];
+        let shots = shots_from(&floor, eye, "m4_mp", "me", &events);
+        assert_eq!(shots.len(), 2);
+        let BridgeMessage::PlayerShot { from, to, target, part, damage, .. } = &shots[0] else { panic!() };
+        assert_eq!((*from, *to), ([20.0, 1.6, 239.5], [10.8, 1.7, 239.5]), "RimWorld z grows north");
+        assert_eq!((target.as_deref(), part.as_deref(), *damage), (Some("a"), Some("head"), Some(40.0)));
+        let BridgeMessage::PlayerShot { target, .. } = &shots[1] else { panic!() };
+        assert_eq!(*target, None);
+    }
