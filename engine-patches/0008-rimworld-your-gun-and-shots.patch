+/// The MW2 gun for a RimWorld gun's def name; `None` for no gun (empty, melee,
+/// or not a gun). The first three follow docs/ROADMAP.md's balance notes.
+fn mw2_weapon(rimworld: Option<&str>) -> Option<&'static str> {
+    Some(match rimworld? {
+        "Gun_AssaultRifle" => "masada_mp",
+        "Gun_SniperRifle" => "cheytac_mp",
+        "Gun_PumpShotgun" => "spas12_mp",
+        "Gun_ChainShotgun" => "aa12_mp",
+        "Gun_BoltActionRifle" => "m21_mp",
+        "Gun_HeavySMG" => "ump45_mp",
+        "Gun_MachinePistol" => "pp2000_mp",
+        "Gun_Autopistol" => "usp_mp",
+        "Gun_Revolver" => "coltanaconda_mp",
+        "Gun_LMG" => "m240_mp",
+        "Gun_Minigun" => "rpd_mp",
+        "Gun_ChargeRifle" => "scar_mp",
+        "Gun_ChargeLance" => "barrett_mp",
+        name if name.starts_with("Gun_") => "m4_mp",
+        _ => return None,
+    })
+}
+
+/// Keeps the player holding only the MW2 version of their colonist's gun, or
+/// nothing: again after every respawn, and when the colonist's gun changes.
+fn arm_player(floor: &mut FlatFloor, authority: &mut net::AuthorityWorld, local: sim::ClientId, pawn: &PawnState, dt: f32) {
+    floor.since_arm += dt;
+    let gun = mw2_weapon(pawn.weapon.as_deref());
+    let want = gun.and_then(|name| authority.0.weapon_index_by_script_name(name)).unwrap_or(0);
+    if floor.armed_with.as_ref() != Some(&pawn.weapon) {
+        floor.armed_with = Some(pawn.weapon.clone());
+        match (pawn.weapon.as_deref(), gun) {
+            (Some(rimworld), Some(name)) if want != 0 => println!("[rimworld] your gun: {name} (RimWorld {rimworld})"),
+            (Some(rimworld), Some(name)) => println!("[rimworld] no MW2 gun {name} for RimWorld {rimworld}: empty handed"),
+            (Some(rimworld), None) => println!("[rimworld] RimWorld {rimworld} isn't a gun: empty handed"),
+            (None, _) => println!("[rimworld] your colonist has no gun: empty handed"),
+        }
+        floor.since_arm = ARM_SECONDS;
+    }
+    let holding = authority.0.player(local).map(|ps| ps.weapon);
+    if holding.is_none_or(|weapon| weapon == want) || floor.since_arm < ARM_SECONDS {
+        return;
+    }
+    floor.since_arm = 0.0;
+    if let Err(error) = authority.0.set_only_weapon(local, want) {
+        diag::warn!(World, "RimWorld flat floor: could not hand the player their gun: {error}");
+    }
+}
