+/// A box made facing north turned back to the building's own frame, so that once placed
+/// facing `rot` it lands where it was made: for linked art such as fences, which link to
+/// the cells around them whichever way they face.
+fn unturn(part: Local, rot: u8) -> Local {
+    let mut p = part;
+    for _ in 0..rot % 4 {
+        // A quarter turn back: north-facing (u east, v north) to the next rot's frame.
+        let [u0, y0, v0, u1, y1, v1] = p;
+        p = [1.0 - v1, y0, u0, 1.0 - v0, y1, u1];
+    }
+    p
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn building(def: &str, rect: [i32; 4], rot: u8) -> BuildingState {
+        BuildingState {
+            def: def.into(),
+            rect,
+            rot,
+            at: [rect[0] as f32 + 0.5, rect[1] as f32 + 0.5],
+            draw: [1.0, 1.0],
+            tex: 0,
+            turn: 0,
+            flip: false,
+            fill: 0.4,
+            solid: false,
+        }
+    }
+
+    #[test]
+    fn mountains_rise_from_their_edge() {
+        // A 9 by 9 map, all rock but the west column.
+        let mut cells = vec![terrain::ROCK; 81];
+        for z in 0..9 {
+            cells[z * 9] = b'.';
+        }
+        let terrain = Terrain { size: [9, 9], cells };
+        let roofs = Roofs { size: [9, 9], cells: vec![roof::NONE; 81], hills: 4 };
+        let detail = Detail::new(9, Some(&terrain), Some(&roofs), None, &[], 0);
+        assert_eq!(detail.top(0, 4), 0);
+        assert_eq!(detail.top(1, 4), ROCK_HEIGHT, "the edge is plain rock height");
+        assert_eq!(detail.top(8, 4), ROCK_HEIGHT + (7.0 * RISE) as i32);
+        assert!(detail.top(5, 4) > detail.top(2, 4));
+        // Flat land keeps its hills low.
+        let flat = Roofs { hills: 1, ..roofs };
+        let detail = Detail::new(9, Some(&terrain), Some(&flat), None, &[], 0);
+        assert_eq!(detail.top(8, 4), ROCK_HEIGHT + RISE_LIMIT[1]);
+    }
+
+    #[test]
+    fn caves_are_under_the_mountain() {
+        // Rock all round an open cell under a rock roof.
+        let mut cells = vec![terrain::ROCK; 25];
+        cells[12] = b'.';
+        let terrain = Terrain { size: [5, 5], cells };
+        let mut roof_cells = vec![roof::NONE; 25];
+        roof_cells[12] = roof::THICK;
+        let roofs = Roofs { size: [5, 5], cells: roof_cells, hills: 3 };
+        let detail = Detail::new(5, Some(&terrain), Some(&roofs), None, &[], 0);
+        assert!(detail.top(2, 2) >= ROCK_HEIGHT);
+        assert_eq!(detail.roof_at(2, 2), roof::THICK);
+    }
+
+    #[test]
+    fn boxes_turn_with_their_building() {
+        let rect = [10.0, 20.0, 11.0, 22.0];
+        // The front strip of a box: north when facing north, south facing south.
+        let front = [0.0, 0.0, 0.9, 1.0, 1.0, 1.0];
+        assert_eq!(place(front, rect, 0)[2], 20.0);
+        assert!((place(front, rect, 2)[5] - 22.0).abs() < 1e-5);
+        assert!((place(front, rect, 1)[3] - 11.0).abs() < 1e-5);
+        assert!((place(front, rect, 3)[0] - 10.0).abs() < 1e-5);
+    }
+
+    #[test]
+    fn a_bed_has_its_headboard_where_it_faces() {
+        // RimWorld cells x 3, z 4..5, facing north: block z 4..6 on a 10 cell map.
+        let bed = building("Bed", [3, 4, 3, 5], 0);
+        let detail = Detail::new(10, None, None, None, &[bed], 1);
+        let parts = detail.parts(0, 0);
+        assert_eq!(parts.len(), 3);
+        // The headboard reaches the north end, block z 4.
+        assert!((parts[1].bounds[2] - 4.0).abs() < 1e-5);
+        assert_eq!(detail.model(3, 5), Model::Low);
+        assert_eq!(parts[0].tex, Some(0));
+        // A picture RimWorld did not send is none.
+        let detail = Detail::new(10, None, None, None, &[building("Bed", [3, 4, 3, 5], 0)], 0);
+        assert_eq!(detail.parts(0, 0)[0].tex, None);
+    }
+
+    #[test]
+    fn sprites_lie_as_rimworld_draws_them() {
+        // A 2 by 1 picture at RimWorld (5, 5) on a 10 cell map: block (5, 5).
+        let sprite = Sprite { at: [5.0, 5.0], draw: [2.0, 1.0], turn: 0, size: 10 };
+        assert_eq!(sprite.uv(5.0, 5.0), [0.5, 0.5]);
+        // East is right, north (block z down) is up.
+        assert_eq!(sprite.uv(6.0, 5.0), [1.0, 0.5]);
+        assert_eq!(sprite.uv(5.0, 4.5), [0.5, 0.0]);
+        // Turned a quarter clockwise, its right edge is south.
+        let turned = Sprite { turn: 1, ..sprite };
+        let [u, v] = turned.uv(5.0, 6.0);
+        assert!((u - 1.0).abs() < 1e-5 && (v - 0.5).abs() < 1e-5);
+    }
+
+    #[test]
+    fn fences_link_to_their_neighbours() {
+        let a = building("Fence", [3, 3, 3, 3], 0);
+        let b = building("Fence", [4, 3, 4, 3], 0);
+        let detail = Detail::new(10, None, None, None, &[a, b], 1);
+        // A post and two rails each.
+        assert_eq!(detail.parts(0, 0).len(), 6);
+    }
+}
