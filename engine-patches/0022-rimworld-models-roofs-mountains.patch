diff --git a/crates/rimworld_world/src/detail.rs b/crates/rimworld_world/src/detail.rs
new file mode 100644
index 0000000..4fcfaf5
--- /dev/null
+++ b/crates/rimworld_world/src/detail.rs
@@ -0,0 +1,593 @@
+//! What the floor needs from RimWorld beyond each cell's terrain code: roofs, how high its
+//! mountains rise, the art of its walls and floors, and a model for everything else built.
+//!
+//! RimWorld keeps no height for its rock: a mountain is the cells of natural rock, and the
+//! roof over them says how deep in it they are (a thin rock roof at its edges and over
+//! caves, thick "overhead mountain" deep inside). Here a mountain rises with the distance
+//! from its edge, as far as the map's world tile is hilly, and a cave is an open cell under
+//! a rock roof, with the mountain's rock over its head.
+//!
+//! Every cell is in block space: block `(x, z)` is RimWorld cell `(x, size - 1 - z)`.
+use std::collections::{HashMap, HashSet, VecDeque};
+
+use rimworld_bridge::{BuildingState, Roofs, Skins, Terrain, roof, terrain};
+
+use super::{BUILT_HEIGHT, ROCK_HEIGHT};
+
+/// Small tiles in the atlas for RimWorld's art; a picture past these has none.
+pub(crate) const SMALL_TILES: u16 = 512;
+/// Blocks a mountain rises over [`ROCK_HEIGHT`] for each cell further in from its edge.
+const RISE: f32 = 0.75;
+/// The most a mountain rises over [`ROCK_HEIGHT`], by the world tile's hilliness: unknown,
+/// flat, small hills, large hills, mountainous, impassable.
+const RISE_LIMIT: [i32; 6] = [10, 2, 4, 8, 14, 20];
+/// How dark faces are under a roof: rock (caves), and built.
+pub(crate) const UNDER_ROCK: f32 = 0.55;
+pub(crate) const UNDER_ROOF: f32 = 0.78;
+
+/// No skin: the cell keeps MW2's texture.
+const NO_SKIN: u16 = u16::MAX;
+
+/// How a cell under a building model collides, beyond its terrain code.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]
+pub(crate) enum Model {
+    #[default]
+    None,
+    /// A model low enough to step onto: half a block of collision, not a full block.
+    Low,
+    /// A model; the cell's terrain code decides its collision.
+    Tall,
+}
+
+/// RimWorld's picture of a building, laid flat over it as RimWorld draws it from above.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct Sprite {
+    /// Its middle, in RimWorld cells (`z` north); its width and height in cells before the
+    /// turn; quarter turns clockwise.
+    at: [f32; 2],
+    draw: [f32; 2],
+    turn: u8,
+    size: i32,
+}
+
+impl Sprite {
+    /// The picture's coordinates (`0..1` right and down) at block point `(x, z)`.
+    pub(crate) fn uv(&self, x: f32, z: f32) -> [f32; 2] {
+        let (mut dx, mut dz) = (x - self.at[0], self.size as f32 - z - self.at[1]);
+        // Undo the picture's clockwise turn: a quarter turn counterclockwise each.
+        for _ in 0..self.turn % 4 {
+            (dx, dz) = (-dz, dx);
+        }
+        [dx / self.draw[0].max(0.01) + 0.5, 0.5 - dz / self.draw[1].max(0.01)]
+    }
+}
+
+/// A box of a building's model, in block space.
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) struct Part {
+    /// `[x0, y0, z0, x1, y1, z1]`, `y` in blocks above the floor.
+    pub(crate) bounds: [f32; 6],
+    /// Its picture's small tile, or plain when RimWorld sent none.
+    pub(crate) tex: Option<u16>,
+    pub(crate) sprite: Sprite,
+    /// How light it is: darker under a roof.
+    pub(crate) light: f32,
+}
+
+/// RimWorld's world over the terrain codes, cell by cell, in block space.
+#[derive(Clone, Debug, PartialEq, Default)]
+pub(crate) struct Detail {
+    size: i32,
+    roof: Vec<u8>,
+    /// The top of the rock at a mountain cell or over a cave, in blocks; 0 elsewhere.
+    top: Vec<u8>,
+    wall: Vec<u16>,
+    floor: Vec<u16>,
+    model: Vec<Model>,
+    /// The highest block of any cell, plus one.
+    pub(crate) max_top: i32,
+    /// Building models, by the 16 by 16 chunk holding each building's middle.
+    parts: HashMap<(i32, i32), Vec<Part>>,
+}
+
+impl Detail {
+    /// `textures` is how many pictures RimWorld has sent: a skin or building naming one past
+    /// these keeps MW2's texture.
+    pub(crate) fn new(
+        size: i32,
+        terrain: Option<&Terrain>,
+        roofs: Option<&Roofs>,
+        skins: Option<&Skins>,
+        buildings: &[BuildingState],
+        textures: usize,
+    ) -> Self {
+        let cells = (size.max(0) * size.max(0)) as usize;
+        let rim = |z: i32| size - 1 - z;
+        let texture = |index: u16| (usize::from(index) < textures && index < SMALL_TILES).then_some(index);
+        let mut detail = Self {
+            size,
+            roof: vec![roof::NONE; cells],
+            top: vec![0; cells],
+            wall: vec![NO_SKIN; cells],
+            floor: vec![NO_SKIN; cells],
+            model: vec![Model::None; cells],
+            max_top: ROCK_HEIGHT,
+            parts: HashMap::new(),
+        };
+        let code = |x: i32, z: i32| terrain.and_then(|t| t.at(x, rim(z)));
+        for z in 0..size {
+            for x in 0..size {
+                let i = (z * size + x) as usize;
+                if let Some(roofs) = roofs {
+                    detail.roof[i] = roofs.at(x, rim(z));
+                }
+                if let Some(skins) = skins {
+                    detail.wall[i] = skins.wall(x, rim(z)).and_then(texture).unwrap_or(NO_SKIN);
+                    detail.floor[i] = skins.floor(x, rim(z)).and_then(texture).unwrap_or(NO_SKIN);
+                }
+            }
+        }
+        // Mountains: rock, and everything under a rock roof (caves).
+        let hills = roofs.map_or(0, |roofs| usize::from(roofs.hills).min(RISE_LIMIT.len() - 1));
+        let limit = RISE_LIMIT[hills];
+        let mass = |d: &Self, x: i32, z: i32| {
+            let i = (z * size + x) as usize;
+            code(x, z) == Some(terrain::ROCK) || matches!(d.roof[i], roof::ROCK | roof::THICK)
+        };
+        let distance = distance_in(size, |x, z| mass(&detail, x, z));
+        for (i, d) in distance.into_iter().enumerate() {
+            if d > 0 {
+                let rise = ((d - 1) as f32 * RISE) as i32;
+                let top = ROCK_HEIGHT + rise.min(limit);
+                detail.top[i] = top.clamp(0, 255) as u8;
+                detail.max_top = detail.max_top.max(top);
+            }
+        }
+        // Buildings: a model each, and where it stands.
+        let fences: HashSet<(i32, i32)> = buildings
+            .iter()
+            .filter(|b| fence(&b.def))
+            .flat_map(|b| cells_of(b.rect))
+            .collect();
+        for building in buildings {
+            let (parts, body) = model_of(building, &fences);
+            if parts.is_empty() {
+                continue;
+            }
+            let [x0, z0, x1, z1] = building.rect;
+            for (rx, rz) in cells_of(building.rect) {
+                let (x, z) = (rx, rim(rz));
+                if !(0..size).contains(&x) || !(0..size).contains(&z) {
+                    continue;
+                }
+                let i = (z * size + x) as usize;
+                detail.model[i] = if body <= 0.6 { Model::Low } else { Model::Tall };
+            }
+            // The rectangle in block space: x across, z from the north edge down.
+            let rect = [x0 as f32, (size - 1 - z1) as f32, (x1 + 1) as f32, (size - z0) as f32];
+            let (mx, mz) = ((x0 + x1) / 2, rim((z0 + z1) / 2));
+            let light = match detail.roof_at(mx, mz) {
+                roof::ROCK | roof::THICK => UNDER_ROCK,
+                roof::BUILT => UNDER_ROOF,
+                _ => 1.0,
+            };
+            let sprite = Sprite { at: building.at, draw: building.draw, turn: building.turn, size };
+            let tex = u16::try_from(building.tex).ok().and_then(texture);
+            let chunk = (mx >> 4, mz >> 4);
+            let list = detail.parts.entry(chunk).or_default();
+            for part in parts {
+                let bounds = place(part, rect, building.rot);
+                detail.max_top = detail.max_top.max(bounds[4].ceil() as i32);
+                list.push(Part { bounds, tex, sprite, light });
+            }
+        }
+        detail
+    }
+
+    fn index(&self, x: i32, z: i32) -> Option<usize> {
+        ((0..self.size).contains(&x) && (0..self.size).contains(&z)).then(|| (z * self.size + x) as usize)
+    }
+
+    pub(crate) fn roof_at(&self, x: i32, z: i32) -> u8 {
+        self.index(x, z).map_or(roof::NONE, |i| self.roof[i])
+    }
+
+    /// The top of the rock at a mountain cell or over a cave; 0 for other cells.
+    pub(crate) fn top(&self, x: i32, z: i32) -> i32 {
+        self.index(x, z).map_or(0, |i| i32::from(self.top[i]))
+    }
+
+    pub(crate) fn wall(&self, x: i32, z: i32) -> Option<u16> {
+        self.index(x, z).map(|i| self.wall[i]).filter(|&s| s != NO_SKIN)
+    }
+
+    pub(crate) fn floor(&self, x: i32, z: i32) -> Option<u16> {
+        self.index(x, z).map(|i| self.floor[i]).filter(|&s| s != NO_SKIN)
+    }
+
+    pub(crate) fn model(&self, x: i32, z: i32) -> Model {
+        self.index(x, z).map_or(Model::None, |i| self.model[i])
+    }
+
+    /// The building models whose middles are in chunk `(cx, cz)`.
+    pub(crate) fn parts(&self, cx: i32, cz: i32) -> &[Part] {
+        self.parts.get(&(cx, cz)).map_or(&[], Vec::as_slice)
+    }
+
+    /// The chunks holding any building model, in either.
+    pub(crate) fn part_chunks<'a>(a: Option<&'a Self>, b: Option<&'a Self>) -> impl Iterator<Item = (i32, i32)> + 'a {
+        let keys = |d: Option<&'a Self>| d.into_iter().flat_map(|d| d.parts.keys().copied());
+        keys(a).chain(keys(b))
+    }
+
+    /// Everything about cell `(x, z)` that changes its blocks.
+    pub(crate) fn signature(&self, x: i32, z: i32) -> (u8, u8, u16, u16, Model) {
+        self.index(x, z).map_or((roof::NONE, 0, NO_SKIN, NO_SKIN, Model::None), |i| {
+            (self.roof[i], self.top[i], self.wall[i], self.floor[i], self.model[i])
+        })
+    }
+}
+
+/// The cells of an inclusive RimWorld rectangle.
+fn cells_of([x0, z0, x1, z1]: [i32; 4]) -> impl Iterator<Item = (i32, i32)> {
+    (z0..=z1).flat_map(move |z| (x0..=x1).map(move |x| (x, z)))
+}
+
+/// For each cell where `inside` holds, how many steps (diagonals too) it is to the nearest
+/// cell where it does not, counting that cell: 1 at the edge. 0 outside. The map's edge is
+/// not an edge: a mountain runs on past it.
+fn distance_in(size: i32, inside: impl Fn(i32, i32) -> bool) -> Vec<u32> {
+    let cells = (size.max(0) * size.max(0)) as usize;
+    let mut distance = vec![0u32; cells];
+    let mut queue = VecDeque::new();
+    for z in 0..size {
+        for x in 0..size {
+            if !inside(x, z) {
+                queue.push_back((x, z));
+            }
+        }
+    }
+    let mut seen: Vec<bool> = (0..cells).map(|i| !inside(i as i32 % size, i as i32 / size)).collect();
+    while let Some((x, z)) = queue.pop_front() {
+        let here = distance[(z * size + x) as usize];
+        for dz in -1..=1 {
+            for dx in -1..=1 {
+                let (nx, nz) = (x + dx, z + dz);
+                if !(0..size).contains(&nx) || !(0..size).contains(&nz) {
+                    continue;
+                }
+                let i = (nz * size + nx) as usize;
+                if !seen[i] {
+                    seen[i] = true;
+                    distance[i] = here + 1;
+                    queue.push_back((nx, nz));
+                }
+            }
+        }
+    }
+    // A map all mountain has no edge to measure from: as deep as can be.
+    for (i, d) in distance.iter_mut().enumerate() {
+        if !seen[i] {
+            *d = 1000;
+        }
+    }
+    distance
+}
+
+/// A box in a building's own frame: `[u0, y0, v0, u1, y1, v1]`, `u` across it to its right
+/// and `v` from its back (0) to its front (1), the way it faces; `y` in blocks.
+type Local = [f32; 6];
+
+/// A local box in block space over the building's block rectangle `[x0, z0, x1, z1]`,
+/// facing `rot` (RimWorld's: 0 north, 1 east, 2 south, 3 west).
+pub(crate) fn place([u0, y0, v0, u1, y1, v1]: Local, [x0, z0, x1, z1]: [f32; 4], rot: u8) -> [f32; 6] {
+    let (w, d) = (x1 - x0, z1 - z0);
+    // Block z grows south. Facing north the front is the north edge; u runs east.
+    let (ax, az) = match rot % 4 {
+        0 => ([x0 + u0 * w, x0 + u1 * w], [z1 - v1 * d, z1 - v0 * d]),
+        1 => ([x0 + v0 * w, x0 + v1 * w], [z0 + u0 * d, z0 + u1 * d]),
+        2 => ([x1 - u1 * w, x1 - u0 * w], [z0 + v0 * d, z0 + v1 * d]),
+        _ => ([x1 - v1 * w, x1 - v0 * w], [z1 - u1 * d, z1 - u0 * d]),
+    };
+    [ax[0], y0, az[0], ax[1], y1, az[1]]
+}
+
+fn fence(def: &str) -> bool {
+    def.to_ascii_lowercase().contains("fence")
+}
+
+/// Four legs, `thick` square, `inset` in from the corners, `height` tall.
+fn legs(inset: f32, thick: f32, height: f32) -> [Local; 4] {
+    let (a, b) = (inset, 1.0 - inset - thick);
+    [
+        [a, 0.0, a, a + thick, height, a + thick],
+        [b, 0.0, a, b + thick, height, a + thick],
+        [a, 0.0, b, a + thick, height, b + thick],
+        [b, 0.0, b, b + thick, height, b + thick],
+    ]
+}
+
+/// A building's model as boxes in its own frame, and the height of its body, for how it
+/// collides. Shapes by what its def's name says it is; anything else is a box as tall as
+/// it is cover.
+fn model_of(building: &BuildingState, fences: &HashSet<(i32, i32)>) -> (Vec<Local>, f32) {
+    let name = building.def.to_ascii_lowercase();
+    let has = |word: &str| name.contains(word);
+    let [x0, z0, x1, z1] = building.rect;
+    let span = ((x1 - x0).max(z1 - z0) + 1) as f32;
+    let mut parts: Vec<Local> = Vec::new();
+    let body;
+    if has("spot") {
+        // Sleeping and work spots are marks on the ground.
+        parts.push([0.05, 0.0, 0.05, 0.95, 0.02, 0.95]);
+        body = 0.0;
+    } else if has("bedroll") {
+        parts.push([0.06, 0.0, 0.04, 0.94, 0.16, 0.96]);
+        body = 0.16;
+    } else if has("bed") && !has("bench") {
+        // Frame and mattress, the headboard at the head: the way the bed faces.
+        parts.push([0.04, 0.0, 0.02, 0.96, 0.45, 0.98]);
+        parts.push([0.02, 0.0, 0.92, 0.98, 0.9, 1.0]);
+        parts.push([0.02, 0.0, 0.0, 0.98, 0.6, 0.06]);
+        body = 0.45;
+    } else if has("shelf") || has("bookcase") {
+        let t = 0.06;
+        parts.extend(legs(0.03, t, 1.9));
+        for y in [0.05, 0.65, 1.25, 1.84] {
