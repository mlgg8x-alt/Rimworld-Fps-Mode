+//! RimWorld x MW2 bridge, engine side (milestone M0).
+//!
+//! A background thread listens on localhost (default `127.0.0.1:47820`, override with
+//! `RWMW2_BRIDGE_ADDR`) for the RimWorld mod, answers its `hello`, and forwards every
+//! message through a channel. A Bevy system drains the channel each frame into
+//! [`RimworldLink`], so game systems never touch the socket.
+//!
+//! RimWorld is the source of truth: this side only reads what it is told.
+
+use std::io::{BufRead, BufReader, Write};
+use std::net::{SocketAddr, TcpListener, TcpStream};
+use std::sync::Mutex;
+use std::sync::mpsc::{self, Receiver, Sender};
+
+use bevy::prelude::*;
+use rwmw2_protocol::{DEFAULT_ADDR, Message, PROTOCOL_VERSION, Side};
+
+pub struct RimworldBridgePlugin;
+
+impl Plugin for RimworldBridgePlugin {
+    fn build(&self, app: &mut App) {
+        let addr = std::env::var("RWMW2_BRIDGE_ADDR").unwrap_or_else(|_| DEFAULT_ADDR.to_string());
+        let (tx, rx) = mpsc::channel();
+        match TcpListener::bind(&addr) {
+            Ok(listener) => {
+                report(&format!("listening for RimWorld on {addr}"));
+                let spawned = std::thread::Builder::new()
+                    .name("rimworld-bridge".into())
+                    .spawn(move || accept_loop(listener, tx));
+                if let Err(error) = spawned {
+                    report(&format!("could not start listener thread: {error}"));
+                }
+            }
+            // Not fatal: the game runs normally without RimWorld, e.g. while bridge-echo
+            // already holds the port.
+            Err(error) => report(&format!("not listening on {addr}: {error}")),
+        }
+        app.insert_resource(RimworldInbox(Mutex::new(rx)))
+            .init_resource::<RimworldLink>()
+            .add_systems(PreUpdate, drain_inbox);
+    }
+}
+
+/// What the engine currently knows about the connected RimWorld game.
+#[derive(Resource, Debug, Default, Clone)]
+pub struct RimworldLink {
+    pub connected: bool,
+    pub game_version: Option<String>,
+    /// RimWorld's `TicksGame` from the latest heartbeat.
+    pub last_tick: Option<i64>,
+}
+
+enum BridgeEvent {
+    Connected(SocketAddr),
+    Received(Message),
+    Disconnected,
+}
+
+#[derive(Resource)]
+struct RimworldInbox(Mutex<Receiver<BridgeEvent>>);
+
+fn accept_loop(listener: TcpListener, tx: Sender<BridgeEvent>) {
+    // One RimWorld at a time; the next connection is accepted when this one closes.
+    for stream in listener.incoming() {
+        let Ok(stream) = stream else { continue };
+        if let Err(error) = serve(stream, &tx) {
+            report(&format!("connection ended: {error}"));
+        }
+        if tx.send(BridgeEvent::Disconnected).is_err() {
+            return; // app shut down
+        }
+    }
+}
+
+fn serve(stream: TcpStream, tx: &Sender<BridgeEvent>) -> std::io::Result<()> {
+    let peer = stream.peer_addr()?;
+    stream.set_nodelay(true)?;
+    let mut writer = stream.try_clone()?;
+    let _ = tx.send(BridgeEvent::Connected(peer));
+    for line in BufReader::new(stream).lines() {
+        let line = line?;
+        match Message::from_line(&line) {
+            Ok(message) => {
+                if matches!(message, Message::Hello { .. }) {
+                    let reply = Message::Hello { side: Side::Iw4l, protocol: PROTOCOL_VERSION, game_version: None };
+                    writer.write_all(reply.to_line().as_bytes())?;
+                }
+                if tx.send(BridgeEvent::Received(message)).is_err() {
+                    return Ok(());
+                }
+            }
+            Err(error) => report(&format!("skipped unreadable line ({error}): {line}")),
+        }
+    }
+    Ok(())
+}
+
+fn drain_inbox(inbox: Res<RimworldInbox>, mut link: ResMut<RimworldLink>) {
+    let Ok(rx) = inbox.0.lock() else { return };
+    while let Ok(event) = rx.try_recv() {
+        match event {
+            BridgeEvent::Connected(peer) => {
+                link.connected = true;
+                report(&format!("RimWorld connected from {peer}"));
+            }
+            BridgeEvent::Disconnected => {
+                *link = RimworldLink::default();
+                report("RimWorld disconnected");
+            }
+            BridgeEvent::Received(Message::Hello { protocol, game_version, .. }) => {
+                if protocol != PROTOCOL_VERSION {
+                    report(&format!("protocol mismatch: RimWorld speaks {protocol}, engine speaks {PROTOCOL_VERSION}"));
+                }
+                report(&format!("hello from RimWorld {}", game_version.as_deref().unwrap_or("?")));
+                link.game_version = game_version;
+            }
+            BridgeEvent::Received(Message::Tick { tick }) => {
+                link.last_tick = Some(tick);
+                report(&format!("RimWorld tick {tick}"));
+            }
+            // Snapshots, shots and the rest arrive with M1/M2.
+            BridgeEvent::Received(_) => {}
+        }
+    }
+}
+
+/// M0 output goes to the terminal as well as the engine log, so it is visible while testing.
+fn report(message: &str) {
+    println!("[rimworld] {message}");
+    diag::info!(Net, "rimworld: {message}");
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A fake RimWorld connects, says hello and sends a tick; the plugin answers hello
+    /// and the link resource reflects both.
+    #[test]
+    fn hello_and_tick_reach_the_link() {
+        // SAFETY: tests in this crate run single-threaded with respect to this variable.
+        unsafe { std::env::set_var("RWMW2_BRIDGE_ADDR", "127.0.0.1:47899") };
+        let mut app = App::new();
+        app.add_plugins(MinimalPlugins).add_plugins(RimworldBridgePlugin);
+        app.update();
+
+        let mut client = TcpStream::connect("127.0.0.1:47899").expect("plugin is listening");
+        client
+            .write_all(b"{\"t\":\"hello\",\"side\":\"rimworld\",\"protocol\":0,\"game_version\":\"1.6.4871 rev590\"}\n{\"t\":\"tick\",\"tick\":600}\n")
+            .unwrap();
+        let mut reply = String::new();
+        BufReader::new(client.try_clone().unwrap()).read_line(&mut reply).unwrap();
+        assert_eq!(Message::from_line(&reply).unwrap(), Message::Hello { side: Side::Iw4l, protocol: 0, game_version: None });
+
+        for _ in 0..200 {
+            app.update();
+            if app.world().resource::<RimworldLink>().last_tick == Some(600) {
+                break;
+            }
+            std::thread::sleep(std::time::Duration::from_millis(5));
+        }
+        let link = app.world().resource::<RimworldLink>();
+        assert!(link.connected);
+        assert_eq!(link.game_version.as_deref(), Some("1.6.4871 rev590"));
+        assert_eq!(link.last_tick, Some(600));
+    }
+}
