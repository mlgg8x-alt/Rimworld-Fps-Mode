+fn colonist_speed_scale(gun: f32, in_tree: bool) -> f32 {
+    let wanted = COLONIST_SPEED * CELL as f32 * BLOCK;
+    let sprint = MW2_RUN_SPEED * MW2_SPRINT_SCALE * gun.max(0.1);
+    let tree = if in_tree { TICKS_PER_CELL / (TICKS_PER_CELL + TREE_PATH_COST) } else { 1.0 };
+    wanted / sprint * tree
