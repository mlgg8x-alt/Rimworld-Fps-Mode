+        let Some(ps) = frame.player_mut(id) else {
+            return false;
+        };
+        ps.move_speed_scale_multiplier = scale;
+        true
+    }
+
     pub fn set_viewangles(&mut self, id: ClientId, viewangles: [f32; 3]) -> bool {
         self.frame().set_viewangles(id, viewangles)
     }
