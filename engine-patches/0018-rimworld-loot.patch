+/// RimWorld's looting, between the link and the HUD's loot panel: what the played
+/// colonist has and can reach goes up to the panel, and the panel's clicks go to RimWorld,
+/// which does the taking and dropping with its own rules.
+fn sync_loot(
+    floor: Res<FlatFloor>,
+    link: Option<Res<RimworldLink>>,
+    outbox: Option<Res<RimworldOutbox>>,
+    weapons: Option<Res<assets::PreparedWeapons>>,
+    mut ui: ResMut<frame::RimLootUi>,
+    mut seen: Local<Option<(u64, String)>>,
+) {
+    let loot = link.as_deref().and_then(|link| {
+        let loot = link.loot.as_ref()?;
+        (link.player_pawn.as_deref() == Some(loot.pawn.as_str())).then(|| (link, loot.clone()))
+    });
+    let Some((link, loot)) = loot.filter(|_| floor.active) else {
+        if ui.active {
+            *ui = frame::RimLootUi::default();
+        }
+        *seen = None;
+        return;
+    };
+    for click in std::mem::take(&mut ui.clicks) {
+        let message = match click {
+            frame::RimLootClick::Take(item) => BridgeMessage::LootTake { pawn: loot.pawn.clone(), item },
+            frame::RimLootClick::Drop(item) => BridgeMessage::LootDrop { pawn: loot.pawn.clone(), item },
+        };
+        if let Some(outbox) = outbox.as_deref() {
+            outbox.send(&message);
+        }
+    }
+    let key = (link.loot_revision, loot.pawn.clone());
+    if ui.active && seen.as_ref() == Some(&key) {
+        return;
+    }
+    *seen = Some(key);
+    let entry = |item: &rimworld_bridge::LootItem| frame::RimLootEntry {
+        id: item.id.clone(),
+        label: item.label.clone(),
+        kind: match item.kind {
+            LootKind::Weapon => frame::RimLootKind::Weapon,
+            LootKind::Apparel => frame::RimLootKind::Apparel,
+            LootKind::Item => frame::RimLootKind::Item,
+        },
+        mass: item.mass,
+        weapon: mw2_weapon(Some(&item.def))
+            .zip(weapons.as_deref())
+            .and_then(|(name, weapons)| weapons.0.resolve_index(name).ok().flatten()),
+    };
+    ui.active = true;
+    ui.name = link.player().and_then(|pawn| pawn.name.clone()).unwrap_or_else(|| loot.pawn.clone());
+    ui.mass = loot.mass;
+    ui.capacity = loot.capacity;
+    ui.kit = loot.kit.iter().map(entry).collect();
+    ui.nearby = loot
+        .nearby
+        .iter()
+        .map(|source| frame::RimLootGroup { label: source.label.clone(), items: source.items.iter().map(entry).collect() })
+        .collect();
+}
