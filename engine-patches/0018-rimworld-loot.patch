diff --git a/crates/hud/src/rimworld_loot.rs b/crates/hud/src/rimworld_loot.rs
new file mode 100644
index 0000000..8998b58
--- /dev/null
+++ b/crates/hud/src/rimworld_loot.rs
@@ -0,0 +1,307 @@
+//! RimWorld looting (rimworld-mw2), drawn as MW2 HUD chrome in the
+//! Minecraft inventory's style: the played colonist's kit on the left, what
+//! lies within its reach on the right. F opens and closes it; a click takes a
+//! thing nearby or drops one of the colonist's own. RimWorld does the moving
+//! (`frame::RimLootUi`); this draws what it said and hands back the clicks.
+use std::collections::HashMap;
+
+use asset_core::AssetRef;
+use asset_game::{FontDef, MenuCatalog};
+use assets::PreparedWeapons;
+use bevy::input::mouse::MouseWheel;
+use bevy::prelude::*;
+use frame::{RimLootClick, RimLootEntry, RimLootKind, RimLootUi};
+use hud_iw4::ui_text_height;
+
+use crate::chrome::ui_text_width;
+use crate::draw2d::{Draw2dList, tessellate_fonts};
+use crate::gpu_list::{HudTessPass, TessJob};
+use crate::images::{HUD_CHROME_NAMESPACE, HudImages};
+use crate::minecraft_inventory::{
+    ACCENT, CENTER, Canvas, EDGE, FONT_SMALL, FONT_TITLE, HEADER, HIGHLIGHT, MAX, PANEL, SLOT, SLOT_EDGE, SLOT_HOVER,
+    TEXT, TEXT_DIM,
+};
+
+#[derive(Component)]
+pub(crate) struct RimLootRaster;
+
+/// The panel's size over its virtual layout.
+const K: f32 = 1.3;
+const PANEL_X: f32 = -160.0;
+const PANEL_Y: f32 = -115.0;
+const PANEL_W: f32 = 320.0;
+const PANEL_H: f32 = 232.0;
+const HEADER_H: f32 = 20.0;
+/// The two columns: the colonist's kit, then what lies nearby.
+const COLUMNS: [f32; 2] = [-154.0, 4.0];
+const COL_W: f32 = 150.0;
+const ROWS_Y: f32 = -66.0;
+const ROW_H: f32 = 12.0;
+const ROWS: usize = 14;
+const ROW_PX: f32 = 5.5;
+
+/// What the panel keeps between frames: each column's scroll.
+#[derive(Default)]
+pub(crate) struct LootInput {
+    scroll: [usize; 2],
+}
+
+/// A line of a column: a heading or a thing.
+enum Row<'a> {
+    Heading(String),
+    Entry(&'a RimLootEntry),
+}
+
+fn kit_rows(ui: &RimLootUi) -> Vec<Row<'_>> {
+    ui.kit.iter().map(Row::Entry).collect()
+}
+
+fn nearby_rows(ui: &RimLootUi) -> Vec<Row<'_>> {
+    let mut rows = Vec::new();
+    for group in ui.nearby.iter().filter(|group| !group.items.is_empty()) {
+        rows.push(Row::Heading(group.label.to_uppercase()));
+        rows.extend(group.items.iter().map(Row::Entry));
+    }
+    rows
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn update_rimworld_loot(
+    surface: Res<crate::surface::Hud2dSurface>,
+    catalog: Option<Res<MenuCatalog>>,
+    ui: Option<ResMut<RimLootUi>>,
+    weapons: Option<Res<PreparedWeapons>>,
+    (keys, buttons, mut wheel): (Res<ButtonInput<KeyCode>>, Res<ButtonInput<MouseButton>>, MessageReader<MouseWheel>),
+    windows: Query<&Window, With<bevy::window::PrimaryWindow>>,
+    mut input: Local<LootInput>,
+    (mut hud_images, mut images): (ResMut<HudImages>, ResMut<Assets<Image>>),
+    mut pass: ResMut<HudTessPass>,
+) {
+    let Some(mut ui) = ui else {
+        pass.rimworld_loot = TessJob::Hide;
+        return;
+    };
+    if !ui.active || !surface.is_ready() {
+        pass.rimworld_loot = TessJob::Hide;
+        ui.open = false;
+        return;
+    }
+    if keys.just_pressed(KeyCode::KeyF) || (ui.open && keys.just_pressed(KeyCode::Escape)) {
+        ui.open = !ui.open && !keys.just_pressed(KeyCode::Escape);
+    }
+    let fonts: HashMap<String, &FontDef> = catalog
+        .as_deref()
+        .map(|catalog| {
+            [FONT_TITLE, FONT_SMALL]
+                .into_iter()
+                .filter_map(|name| catalog.font(name).map(|font| (name.to_owned(), font)))
+                .collect()
+        })
+        .unwrap_or_default();
+    let mut canvas = Canvas { surface: &surface, cmds: Vec::new(), fonts, k: 1.0, site: "rimworld_loot" };
+    let weapons = weapons.as_deref();
+
+    if ui.open {
+        canvas.k = K;
+        // The mouse in the panel's centred virtual space.
+        let mouse = windows.single().ok().and_then(Window::cursor_position).map(|m| {
+            let [sx, sy] = surface.placement().scale_virtual_to_real;
+            Vec2::new((m.x - surface.width() * 0.5) / sx / K, (m.y - surface.height() * 0.5) / sy / K)
+        });
+        let column = mouse.and_then(|m| COLUMNS.iter().position(|&x| m.x >= x && m.x < x + COL_W));
+        for event in wheel.read() {
+            if let Some(column) = column {
+                let step = if event.y < 0.0 { 1 } else if event.y > 0.0 { -1 } else { 0 };
+                input.scroll[column] = input.scroll[column].saturating_add_signed(step);
+            }
+        }
+        let clicked = buttons.just_pressed(MouseButton::Left);
+        let click = draw_panel(&mut canvas, &ui, weapons, &mut input, mouse, clicked);
+        if let Some(click) = click {
+            ui.clicks.push(click);
+        }
+    } else {
+        for _ in wheel.read() {}
+        input.scroll = [0, 0];
+        canvas.k = 1.15;
+        draw_hint(&mut canvas, &ui);
+    }
+
+    let list = Draw2dList { cmds: canvas.cmds };
+    let fonts = canvas.fonts;
+    let (quads, _) = tessellate_fonts(&list, &fonts);
+    for font in fonts.values() {
+        let _ = hud_images.get(HUD_CHROME_NAMESPACE, AssetRef::bare_name(&font.material), &mut images);
+    }
+    pass.rimworld_loot = if quads.is_empty() { TessJob::Hide } else { TessJob::Quads(quads) };
+}
+
+fn text_width(canvas: &Canvas<'_>, font: &str, text: &str, px: f32) -> f32 {
+    canvas.fonts.get(font).map_or(0.0, |def| ui_text_width(def, text, px / ui_text_height(1.0)))
+}
+
+/// `text` cut to fit `width`, with an ellipsis when cut.
+fn fit(canvas: &Canvas<'_>, font: &str, text: &str, px: f32, width: f32) -> String {
+    if text_width(canvas, font, text, px) <= width {
+        return text.to_owned();
+    }
+    let mut chars: Vec<char> = text.chars().collect();
+    while !chars.is_empty() {
+        chars.pop();
+        let cut: String = chars.iter().collect::<String>() + "...";
+        if text_width(canvas, font, &cut, px) <= width {
+            return cut;
+        }
+    }
+    String::new()
+}
+
+/// "Press F to loot" along the bottom while something lies within reach.
+fn draw_hint(canvas: &mut Canvas<'_>, ui: &RimLootUi) {
+    let count = ui.nearby_count();
+    if count == 0 {
+        return;
+    }
+    let align = (CENTER, MAX);
+    let first = ui.nearby.iter().find(|group| !group.items.is_empty()).map_or("", |group| group.label.as_str());
+    let what = if count == 1 { "1 ITEM".to_owned() } else { format!("{count} ITEMS") };
+    let text = format!("LOOT  {}  //  {what}", first.to_uppercase());
+    let px = 6.5;
+    let key_w = 11.0;
+    let w = text_width(canvas, FONT_SMALL, &text, px) + key_w + 14.0;
+    let (x, y) = (-w * 0.5, -78.0);
+    canvas.fill(x, y, w, 14.0, [0.04, 0.03, 0.02, 0.70], align);
+    canvas.frame(x, y, w, 14.0, EDGE, align);
+    canvas.fill(x, y, 2.0, 14.0, ACCENT, align);
+    canvas.fill(x + 6.0, y + 2.5, key_w, 9.0, [ACCENT[0], ACCENT[1], ACCENT[2], 0.85], align);
+    canvas.text(FONT_SMALL, x + 6.0 + key_w * 0.5 - 2.2, y + 3.5, px, [0.05, 0.04, 0.03, 1.0], "F", false, align);
+    canvas.text(FONT_SMALL, x + 10.0 + key_w, y + 3.5, px, HIGHLIGHT, &text, false, align);
+}
+
+/// The panel; returns what the player clicked.
+fn draw_panel(
+    canvas: &mut Canvas<'_>,
+    ui: &RimLootUi,
+    weapons: Option<&PreparedWeapons>,
+    input: &mut LootInput,
+    mouse: Option<Vec2>,
+    clicked: bool,
+) -> Option<RimLootClick> {
+    let c = (CENTER, CENTER);
+    // Dim the world, then glass, header, edges and MW2's brackets.
+    canvas.fill(-2000.0, -2000.0, 4000.0, 4000.0, [0.0, 0.0, 0.0, 0.45], c);
+    canvas.fill(PANEL_X, PANEL_Y + HEADER_H, PANEL_W, PANEL_H - HEADER_H, PANEL, c);
+    canvas.fill(PANEL_X, PANEL_Y, PANEL_W, HEADER_H, HEADER, c);
+    canvas.quad(PANEL_X, PANEL_Y, PANEL_W, HEADER_H, [ACCENT[0], ACCENT[1], ACCENT[2], 0.22], "gradient_fadein_fadebottom", [0.0, 0.0, 1.0, 1.0], c);
+    canvas.fill(PANEL_X, PANEL_Y + HEADER_H - 1.0, PANEL_W, 1.0, [ACCENT[0], ACCENT[1], ACCENT[2], 0.85], c);
+    canvas.fill(PANEL_X, PANEL_Y, 3.0, HEADER_H, ACCENT, c);
+    canvas.text(FONT_TITLE, PANEL_X + 9.0, PANEL_Y + 5.0, 10.0, HIGHLIGHT, "LOOT", false, c);
+    canvas.text(FONT_SMALL, PANEL_X + PANEL_W - 8.0, PANEL_Y + 7.5, 6.0, TEXT_DIM, "F TO CLOSE", true, c);
+    canvas.frame(PANEL_X, PANEL_Y, PANEL_W, PANEL_H, EDGE, c);
+    canvas.brackets(PANEL_X - 2.0, PANEL_Y - 2.0, PANEL_W + 4.0, PANEL_H + 4.0, 8.0, [ACCENT[0], ACCENT[1], ACCENT[2], 0.9], c);
+
+    // Column titles: the colonist and its load, and what lies nearby.
+    let [kit_x, near_x] = COLUMNS;
+    let title_y = PANEL_Y + HEADER_H + 6.0;
+    let name = fit(canvas, FONT_SMALL, &ui.name.to_uppercase(), 6.0, COL_W - 50.0);
+    canvas.text(FONT_SMALL, kit_x, title_y, 6.0, HIGHLIGHT, &name, false, c);
+    canvas.text(FONT_SMALL, kit_x + COL_W, title_y, 6.0, TEXT_DIM, "CLICK TO DROP", true, c);
+    canvas.text(FONT_SMALL, near_x, title_y, 6.0, HIGHLIGHT, "NEARBY", false, c);
+    canvas.text(FONT_SMALL, near_x + COL_W, title_y, 6.0, TEXT_DIM, "CLICK TO TAKE", true, c);
+    // The load, as a bar that turns red when the colonist is overloaded.
+    let bar_y = title_y + 10.0;
+    let load = if ui.capacity > 0.0 { ui.mass / ui.capacity } else { 0.0 };
+    canvas.fill(kit_x, bar_y, COL_W - 48.0, 4.0, SLOT, c);
+    let fill = if load > 1.0 { [0.85, 0.22, 0.16, 1.0] } else { ACCENT };
+    canvas.fill(kit_x, bar_y, (COL_W - 48.0) * load.clamp(0.0, 1.0), 4.0, fill, c);
+    canvas.frame(kit_x, bar_y, COL_W - 48.0, 4.0, SLOT_EDGE, c);
+    let carried = format!("{:.1} / {:.0} KG", ui.mass, ui.capacity);
+    canvas.text(FONT_SMALL, kit_x + COL_W, bar_y - 1.0, 5.5, TEXT, &carried, true, c);
+    canvas.fill(near_x, bar_y + 1.5, COL_W, 0.5, EDGE, c);
+
+    let mut click = None;
+    for (column, rows) in [kit_rows(ui), nearby_rows(ui)].into_iter().enumerate() {
+        let x = COLUMNS[column];
+        input.scroll[column] = input.scroll[column].min(rows.len().saturating_sub(ROWS));
+        let first = input.scroll[column];
+        if rows.is_empty() {
+            let empty = if column == 0 { "NOTHING" } else { "NOTHING WITHIN REACH" };
+            canvas.text(FONT_SMALL, x + 4.0, ROWS_Y + 3.0, ROW_PX, TEXT_DIM, empty, false, c);
+        }
+        for (line, row) in rows.iter().skip(first).take(ROWS).enumerate() {
+            let y = ROWS_Y + line as f32 * ROW_H;
+            match row {
+                Row::Heading(label) => {
+                    let label = fit(canvas, FONT_SMALL, label, ROW_PX, COL_W - 4.0);
+                    canvas.text(FONT_SMALL, x + 1.0, y + 4.0, ROW_PX, ACCENT, &label, false, c);
+                    canvas.fill(x, y + ROW_H - 1.5, COL_W, 0.5, [ACCENT[0], ACCENT[1], ACCENT[2], 0.45], c);
+                }
+                Row::Entry(entry) => {
+                    let hover = mouse.is_some_and(|m| m.x >= x && m.x < x + COL_W && m.y >= y && m.y < y + ROW_H - 1.0);
+                    canvas.fill(x, y, COL_W, ROW_H - 1.0, if hover { SLOT_HOVER } else { SLOT }, c);
+                    if hover {
+                        canvas.frame(x, y, COL_W, ROW_H - 1.0, HIGHLIGHT, c);
+                    }
+                    draw_entry(canvas, weapons, entry, x, y, hover);
+                    if hover && clicked {
+                        click = Some(if column == 0 {
+                            RimLootClick::Drop(entry.id.clone())
+                        } else {
+                            RimLootClick::Take(entry.id.clone())
+                        });
+                    }
+                }
+            }
+        }
+        // More than fits: where the view is in the list.
+        if rows.len() > ROWS {
+            let track = ROWS as f32 * ROW_H;
+            let thumb = track * ROWS as f32 / rows.len() as f32;
+            let at = (track - thumb) * first as f32 / (rows.len() - ROWS) as f32;
+            canvas.fill(x + COL_W + 1.5, ROWS_Y, 1.0, track, SLOT_EDGE, c);
+            canvas.fill(x + COL_W + 1.0, ROWS_Y + at, 2.0, thumb, ACCENT, c);
+        }
+    }
+    let footer = "WEAPONS GO IN HAND  //  APPAREL IS WORN  //  THE REST IS CARRIED";
+    canvas.text(FONT_SMALL, 0.0 - text_width(canvas, FONT_SMALL, footer, 5.0) * 0.5, PANEL_Y + PANEL_H - 10.0, 5.0, TEXT_DIM, footer, false, c);
+    click
+}
+
+/// A thing's row: its kind (a gun's MW2 kill icon), label and mass.
+fn draw_entry(canvas: &mut Canvas<'_>, weapons: Option<&PreparedWeapons>, entry: &RimLootEntry, x: f32, y: f32, hover: bool) {
+    let c = (CENTER, CENTER);
+    let icon_w = 24.0;
+    let h = ROW_H - 1.0;
+    let mut drew_icon = false;
+    if let (Some(weapon), Some(reg)) = (entry.weapon, weapons) {
+        let namespace = reg.0.namespace_of(weapon).unwrap_or(HUD_CHROME_NAMESPACE);
+        if let Some(icon) = reg.0.kill_icon_image_of(weapon).or_else(|| reg.0.kill_icon_of(weapon)) {
+            let facts = reg.0.facts_of(weapon);
+            let ratio: f32 = match facts.map(|f| f.kill_icon_ratio) {
+                Some(1) => 2.0,
+                Some(2) => 4.0,
+                _ => 1.0,
+            };
+            let flip = facts.is_some_and(|f| f.flip_kill_icon);
+            let ih = (icon_w / ratio).min(h - 1.0);
+            let iw = ih * ratio;
+            let st = if flip { [1.0, 0.0, 0.0, 1.0] } else { [0.0, 0.0, 1.0, 1.0] };
+            canvas.quad_ns(x + 2.0 + (icon_w - iw) * 0.5, y + (h - ih) * 0.5, iw, ih, TEXT, icon, namespace, st, c);
+            drew_icon = true;
+        }
+    }
+    if !drew_icon {
+        let tag = match entry.kind {
+            RimLootKind::Weapon => "WPN",
+            RimLootKind::Apparel => "GEAR",
+            RimLootKind::Item => "ITEM",
+        };
+        let tw = text_width(canvas, FONT_SMALL, tag, 4.5);
+        canvas.text(FONT_SMALL, x + 2.0 + (icon_w - tw) * 0.5, y + 3.0, 4.5, [ACCENT[0], ACCENT[1], ACCENT[2], 0.9], tag, false, c);
+    }
+    let mass = format!("{:.1} KG", entry.mass);
+    let mass_w = text_width(canvas, FONT_SMALL, &mass, 4.5);
+    canvas.text(FONT_SMALL, x + COL_W - 3.0, y + 3.0, 4.5, TEXT_DIM, &mass, true, c);
+    let label = fit(canvas, FONT_SMALL, &entry.label, ROW_PX, COL_W - icon_w - mass_w - 12.0);
+    canvas.text(FONT_SMALL, x + icon_w + 5.0, y + 2.5, ROW_PX, if hover { HIGHLIGHT } else { TEXT }, &label, false, c);
+}
