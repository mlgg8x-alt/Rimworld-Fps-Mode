diff --git a/crates/frame/src/rimworld_loot.rs b/crates/frame/src/rimworld_loot.rs
new file mode 100644
index 0000000..6d4324d
--- /dev/null
+++ b/crates/frame/src/rimworld_loot.rs
@@ -0,0 +1,77 @@
+//! RimWorld looting (rimworld-mw2): between the world that hears RimWorld
+//! (`rimworld_world`) and the HUD that draws the loot panel and takes the
+//! player's clicks (`hud`). RimWorld does every transfer; this only carries
+//! what it said and what the player asked for.
+use bevy::prelude::*;
+
+/// What a thing is, which decides what taking it does in RimWorld.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum RimLootKind {
+    /// Taken into the hands; the gun held drops.
+    Weapon,
+    /// Worn; whatever it replaces drops.
+    Apparel,
+    /// Carried.
+    Item,
+}
+
+/// One thing on the panel.
+#[derive(Clone, Debug, PartialEq)]
+pub struct RimLootEntry {
+    /// RimWorld's id for it, which a click hands back.
+    pub id: String,
+    /// RimWorld's label, count and quality included.
+    pub label: String,
+    pub kind: RimLootKind,
+    /// Its mass in kg, the whole stack.
+    pub mass: f32,
+    /// The MW2 weapon it stands for, for a gun: its kill icon is drawn.
+    pub weapon: Option<u32>,
+}
+
+/// Things lying together: the ground, or a corpse's or downed pawn's gear.
+#[derive(Clone, Debug, PartialEq)]
+pub struct RimLootGroup {
+    pub label: String,
+    pub items: Vec<RimLootEntry>,
+}
+
+/// What the player clicked on the panel, by RimWorld id.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum RimLootClick {
+    /// A thing nearby, to take.
+    Take(String),
+    /// A thing of the colonist's own, to drop.
+    Drop(String),
+}
+
+#[derive(Resource, Default)]
+pub struct RimLootUi {
+    /// A RimWorld colonist is played and RimWorld said what it has.
+    pub active: bool,
+    /// The panel is open (the HUD's to change).
+    pub open: bool,
+    /// The played colonist's name.
+    pub name: String,
+    /// Mass carried and how much the colonist can carry, in kg.
+    pub mass: f32,
+    pub capacity: f32,
+    /// The weapon in hand, apparel worn and things carried.
+    pub kit: Vec<RimLootEntry>,
+    /// What lies within reach, by where it lies.
+    pub nearby: Vec<RimLootGroup>,
+    /// Clicks the HUD took, for the world to send to RimWorld.
+    pub clicks: Vec<RimLootClick>,
+}
+
+impl RimLootUi {
+    /// The panel is up: the mouse is the player's and the game takes no input.
+    pub fn captures_input(&self) -> bool {
+        self.active && self.open
+    }
+
+    /// How many things lie within reach.
+    pub fn nearby_count(&self) -> usize {
+        self.nearby.iter().map(|group| group.items.len()).sum()
+    }
+}
