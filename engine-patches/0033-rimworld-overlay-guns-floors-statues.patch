+/// How much longer than MW2's the local player's reload lasts (RimWorld x MW2: as long as
+/// their colonist's), for the viewmodel to draw it so; `None` for MW2's own.
+static LOCAL_RELOAD_SCALE: core::sync::atomic::AtomicU32 = core::sync::atomic::AtomicU32::new(0);
+
+pub fn set_local_reload_scale(scale: Option<f32>) {
+    let bits = scale.filter(|s| *s > 0.0).map_or(0, f32::to_bits);
+    LOCAL_RELOAD_SCALE.store(bits, core::sync::atomic::Ordering::Relaxed);
+}
+
+pub fn local_reload_scale() -> Option<f32> {
+    let bits = LOCAL_RELOAD_SCALE.load(core::sync::atomic::Ordering::Relaxed);
+    (bits != 0).then(|| f32::from_bits(bits))
+}
