+/// RimWorld floor: the models and materials of every other MW2 multiplayer
+/// map, so RimWorld things can be drawn with any of them, not only the
+/// stand-in map's. The stand-in's own stay as they are. Their color maps are
+/// decoded with the map's. `RWMW2_ALL_MAPS=0` turns this off.
+fn absorb_other_map_models(
+    path: &Path,
+    progress: &LoadProgress,
+    materials: &mut asset_material::MaterialCatalog,
+    map_xmodels: &mut super::helpers::MapXModelCatalog,
+    report: &mut Vec<String>,
+) {
+    if std::env::var("RWMW2_ALL_MAPS").is_ok_and(|v| v.trim() == "0") {
+        report.push("rimworld: other maps' models off (RWMW2_ALL_MAPS=0)".into());
+        return;
+    }
+    let zones = other_map_zones(path);
+    let before = map_xmodels.scene_asset_count();
+    let stage = progress.begin_scoped(StageId::MapAssets, "other maps", Some(zones.len() as u64));
+    let mut walked = 0;
+    for (n, zone) in zones.iter().enumerate() {
+        if progress.is_canceled() {
+            break;
+        }
+        stage.set_completed(n as u64);
+        let image = match asset_transport::open_zone(zone) {
+            Ok(image) if image.game == ZoneGame::Iw4 => image,
+            Ok(_) => continue,
+            Err(error) => {
+                diag::warn!(World, "rimworld: skipped {}: {error}", zone.display());
+                continue;
+            }
+        };
+        let Ok(header) = image.header() else {
+            continue;
+        };
+        let mut memory = ZoneMemory::for_header(&header);
+        let Ok(mut stream) = memory.stream(&image.bytes) else {
+            continue;
+        };
+        let mut sink = ZoneWalkSink::default();
+        sink.set_capture_zone(asset_core::ZoneOwner::from_zone_path(zone));
+        sink.set_capture_ns(asset_core::AssetNamespace::Iw4);
+        if let Err(error) = load_zone(&mut stream, &mut sink) {
+            diag::warn!(
+                World,
+                "rimworld: {} walk stopped after {} assets: {error}",
+                zone.display(),
+                sink.walked
+            );
+        }
+        let mut scenes = sink.map_xmodels.take_scene_assets();
+        let linked = materials.absorb_asset_population(std::mem::take(&mut sink.materials));
+        scenes.remap_walk_materials(&linked);
+        map_xmodels.absorb_scene_assets(scenes);
+        walked += 1;
+    }
+    stage.done();
+    let line = format!(
+        "rimworld: added {} models from {walked} other maps ({} materials in all)",
+        map_xmodels.scene_asset_count().saturating_sub(before),
+        materials.materials.len()
+    );
+    diag::info!(World, "{line}");
+    report.push(line);
+}
+
+/// The other IW4 multiplayer map zones beside `path` and in the DLC folder.
+fn other_map_zones(path: &Path) -> Vec<std::path::PathBuf> {
+    let Some(dir) = path.parent() else {
+        return Vec::new();
+    };
+    let mut dirs = vec![dir.to_path_buf(), dir.join("dlc")];
+    if let Some(up) = dir.parent() {
+        dirs.push(up.join("dlc"));
+    }
+    let mut zones: Vec<std::path::PathBuf> = dirs
+        .iter()
+        .filter_map(|dir| std::fs::read_dir(dir).ok())
+        .flatten()
+        .filter_map(|entry| entry.ok().map(|entry| entry.path()))
+        .filter(|zone| {
+            let Some(stem) = zone.file_stem().and_then(|s| s.to_str()) else {
+                return false;
+            };
+            let stem = stem.to_ascii_lowercase();
+            zone.extension().is_some_and(|e| e.eq_ignore_ascii_case("ff"))
+                && stem.starts_with("mp_")
+                && !stem.ends_with("_load")
+                && zone.file_stem() != path.file_stem()
+        })
+        .collect();
+    zones.sort();
+    zones.dedup_by(|a, b| a.file_stem() == b.file_stem());
+    zones
+}
