+/// Whether the load in flight is the RimWorld floor. The zone walk sees only
+/// the stand-in map's path, so the match load says so here first.
+static FLAT_LOAD: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+pub fn set_flat_load(flat: bool) {
+    FLAT_LOAD.store(flat, std::sync::atomic::Ordering::Relaxed);
+}
+
+pub fn flat_load() -> bool {
+    FLAT_LOAD.load(std::sync::atomic::Ordering::Relaxed)
+}
+
 pub fn is_flat(zone: &str) -> bool {
     zone.eq_ignore_ascii_case(FLAT_ZONE)
 }
