+/// How brightly lamps light each roofed cell (M12+), 0 dark to 15 lit, in [`Terrain`]'s order.
+#[derive(Debug, Clone, PartialEq)]
+pub struct Glow {
+    pub size: [i32; 2],
+    pub cells: Vec<u8>,
+}
+
+impl Glow {
+    /// From `glow`'s hex digits; anything else reads as dark.
+    pub fn new(size: [i32; 2], cells: &str) -> Self {
+        Self { size, cells: cells.bytes().map(|c| (c as char).to_digit(16).map_or(0, |d| d as u8)).collect() }
+    }
+
+    /// How lit cell `(x, z)` is, 0 to 1; dark off the map.
+    pub fn at(&self, x: i32, z: i32) -> f32 {
+        let [sx, sz] = self.size;
+        if !(0..sx).contains(&x) || !(0..sz).contains(&z) {
+            return 0.0;
+        }
+        self.cells.get((z * sx + x) as usize).map_or(0.0, |&level| f32::from(level) / 15.0)
+    }
 }
 
