+        fn EnumWindows(callback: unsafe extern "system" fn(isize, isize) -> i32, param: isize) -> i32;
+        fn GetWindowThreadProcessId(window: isize, process: *mut u32) -> u32;
+        fn IsWindowVisible(window: isize) -> i32;
+        fn GetWindow(window: isize, command: u32) -> isize;
+        fn ShowWindow(window: isize, command: i32) -> i32;
+        fn SetForegroundWindow(window: isize) -> i32;
+    }
+
+    /// This game's own window: the first visible top-level window of this process.
+    #[cfg(windows)]
+    pub(super) fn own() -> Option<i64> {
+        unsafe extern "system" fn each(window: isize, found: isize) -> i32 {
+            const GW_OWNER: u32 = 4;
+            let mut process = 0u32;
+            // SAFETY: `found` is the `&mut isize` handed to EnumWindows below, alive for the call.
+            unsafe {
+                GetWindowThreadProcessId(window, &raw mut process);
+                if process != std::process::id() || IsWindowVisible(window) == 0 || GetWindow(window, GW_OWNER) != 0 {
+                    return 1;
+                }
+                *(found as *mut isize) = window;
+            }
+            0
+        }
+        let mut found: isize = 0;
+        // SAFETY: the callback only writes through the pointer to `found`, which outlives the call.
+        unsafe {
+            EnumWindows(each, &raw mut found as isize);
+        }
+        (found != 0).then_some(found as i64)
+    }
+
+    /// Hides MW2's window, or shows it in front.
+    #[cfg(windows)]
+    pub(super) fn show(window: i64, shown: bool) {
+        const SW_HIDE: i32 = 0;
+        const SW_SHOW: i32 = 5;
+        // SAFETY: plain user32 calls on a window handle; a stale handle only makes them fail.
+        unsafe {
+            ShowWindow(window as isize, if shown { SW_SHOW } else { SW_HIDE });
+            if shown {
+                SetForegroundWindow(window as isize);
+            }
+        }
+    }
+
+    #[cfg(not(windows))]
+    pub(super) fn own() -> Option<i64> {
+        None
+    }
+
+    #[cfg(not(windows))]
+    pub(super) fn show(_window: i64, _shown: bool) {}
+}
+
+/// Where MW2's window stands in the one-application flow (M12).
+#[derive(Default)]
+pub(crate) struct OneWindow {
+    /// Seconds until the next look for our window.
+    look_in: f32,
+    /// Whether this connection's RimWorld has been told our window.
+    told: bool,
+    hidden: bool,
+}
+
+/// Whether MW2's window hides while no colonist is controlled: on unless
+/// `RWMW2_ONE_WINDOW=0`.
+fn one_window_on() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        let on = !matches!(std::env::var("RWMW2_ONE_WINDOW").map(|v| v.trim().to_lowercase()).as_deref(), Ok("0" | "off" | "false"));
+        println!("[rimworld] one window (MW2 hides until a colonist is controlled): {on}");
+        on
+    })
+}
+
+/// M12, one application: the game is played in RimWorld, and MW2's window only shows while
+/// RimWorld's "Control in MW2" hands it a colonist; letting the colonist go hides it again.
+/// RimWorld is told our window in our `hello`, or as soon as we find it.
+pub(crate) fn one_window(
+    floor: Res<FlatFloor>,
+    time: Res<Time>,
+    link: Option<Res<RimworldLink>>,
+    outbox: Option<Res<RimworldOutbox>>,
+    mut state: Local<OneWindow>,
+) {
+    use std::sync::atomic::Ordering;
+    let connected = link.as_deref().is_some_and(|link| link.connected);
+    let mut window = rimworld_bridge::OWN_WINDOW.load(Ordering::Relaxed);
+    if window == 0 {
+        state.look_in -= time.delta_secs();
+        if state.look_in <= 0.0 {
+            state.look_in = 1.0;
+            if let Some(found) = window::own() {
+                window = found;
+                rimworld_bridge::OWN_WINDOW.store(found, Ordering::Relaxed);
+            }
+        }
+    }
+    if !connected {
+        state.told = false;
+    } else if window != 0 && !state.told {
+        // Again, in case RimWorld said hello before we had a window.
+        if let Some(outbox) = outbox.as_deref()
+            && outbox.send(&rimworld_bridge::hello())
+        {
+            state.told = true;
+        }
+    }
+    if window == 0 {
+        return;
+    }
+    let hide = one_window_on()
+        && floor.active
+        && link.as_deref().is_some_and(|link| link.connected && link.snapshots > 0 && link.player_pawn.is_none());
+    if hide != state.hidden {
+        state.hidden = hide;
+        window::show(window, !hide);
+        println!("[rimworld] {}", if hide { "MW2 hides until a colonist is controlled in RimWorld" } else { "MW2 is back: controlling a colonist" });
+    }
 }
 
