+/// Each swinging door's two leaves, slid as far into the walls beside it as RimWorld has
+/// swung them (M11). A door still in the way is its own blocks, so only one that has swung
+/// clear is drawn: its leaves are seen finishing their slide.
+fn add_doors(vertices: &mut Vec<Vertex>, indices: &mut Vec<u32>, cards: &Cards, size: i32) {
+    let Some(lay) = cards.lay else { return };
+    let (Some(doors), Some(detail)) = (lay.doors, lay.detail) else { return };
+    let half = CELL as f32 / 2.0;
+    let top = DOOR_GAP as f32;
+    for (x, z) in doors.cells() {
+        let (Some(door), Some(swing)) = (doors.at(x, z), doors.swing(x, z)) else { continue };
+        if swing < DOOR_OPEN {
+            continue;
+        }
+        let (bx, bz) = (x * CELL, (size - 1 - z) * CELL);
+        let Some(tex) = detail.wall(bx, bz) else { continue };
+        // How far each leaf has slid out of the doorway.
+        let slid = swing * half;
+        let (x0, z0) = (bx as f32, bz as f32);
+        if door.axis == 0 {
+            // A door facing north or south: its leaves slide east and west.
+            leaf(vertices, indices, tex, [x0 - slid, z0 + half], [x0 + half - slid, z0 + half], top);
+            leaf(vertices, indices, tex, [x0 + half + slid, z0 + half], [x0 + CELL as f32 + slid, z0 + half], top);
+        } else {
+            leaf(vertices, indices, tex, [x0 + half, z0 - slid], [x0 + half, z0 + half - slid], top);
+            leaf(vertices, indices, tex, [x0 + half, z0 + half + slid], [x0 + half, z0 + CELL as f32 + slid], top);
+        }
+    }
+}
+
+/// One of a door's leaves: an upright piece of its own picture from `from` to `to` (block
+/// space) and `top` blocks high, seen from either side.
+fn leaf(vertices: &mut Vec<Vertex>, indices: &mut Vec<u32>, tex: u16, from: [f32; 2], to: [f32; 2], top: f32) {
+    // Bottom left, bottom right, top right, top left, and the picture there.
+    let corners = [(from, 0.0), (to, 0.0), (to, top), (from, top)];
+    let pictured = [[0.0, 1.0], [1.0, 1.0], [1.0, 0.0], [0.0, 0.0]];
+    let base = vertices.len() as u32;
+    for (([x, z], y), uv) in corners.into_iter().zip(pictured) {
+        vertices.push(Vertex {
+            position: [x, y, z],
+            uv: small_uv(tex, uv),
+            color: [1.0, 1.0, 1.0, 1.0],
+            sky_light: 15.0,
+            block_light: 0.0,
+        });
+    }
+    indices.extend([base, base + 1, base + 2, base, base + 2, base + 3]);
+    indices.extend([base, base + 2, base + 1, base, base + 3, base + 2]);
+}
