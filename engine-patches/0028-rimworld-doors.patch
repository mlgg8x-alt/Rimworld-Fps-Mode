+/// How far every door on RimWorld's map has swung (M11+).
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct Doors {
+    cells: std::collections::HashMap<(i32, i32), Door>,
+    /// How many whole steps a swing counts: a swing of `steps` is wide open.
+    steps: u32,
+}
+
+/// One door, as far as RimWorld has swung it.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Door {
+    /// How far it has swung, in whole steps of [`Doors::steps`].
+    pub open: u32,
+    /// Which way its leaves slide: 0 east and west, 1 north and south.
+    pub axis: u8,
+}
+
+impl Doors {
+    pub fn new(doors: Vec<DoorState>, steps: u32) -> Self {
+        let cells = doors
+            .into_iter()
+            .map(|door| ((door.at[0], door.at[1]), Door { open: door.open, axis: door.axis }))
+            .collect();
+        Self { cells, steps: steps.max(1) }
+    }
+
+    /// The door on cell `(x, z)`, if one stands there.
+    pub fn at(&self, x: i32, z: i32) -> Option<Door> {
+        self.cells.get(&(x, z)).copied()
+    }
+
+    /// How far the door on cell `(x, z)` has swung: 0 shut, 1 wide open.
+    pub fn swing(&self, x: i32, z: i32) -> Option<f32> {
+        self.at(x, z).map(|door| (door.open as f32 / self.steps as f32).clamp(0.0, 1.0))
+    }
+
+    /// Every cell a door stands on.
+    pub fn cells(&self) -> impl Iterator<Item = (i32, i32)> + '_ {
+        self.cells.keys().copied()
+    }
+
+    pub fn len(&self) -> usize {
+        self.cells.len()
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.cells.is_empty()
+    }
 }
 
