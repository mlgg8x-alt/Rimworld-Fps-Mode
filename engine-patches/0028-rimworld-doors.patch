+/// The chunks holding a door that has just swung clear, or just swung back into the way, with
+/// their neighbours: only those, because doors move far too often to walk the whole floor (M11).
+fn swung_chunks(floor: &FlatFloor, was: Option<&Doors>) -> Vec<(i32, i32)> {
+    let now = floor.doors.as_deref();
+    let shut = |doors: Option<&Doors>, x: i32, z: i32| {
+        doors.and_then(|doors| doors.swing(x, z)).is_some_and(|swing| swing < DOOR_OPEN)
+    };
+    let mut chunks = std::collections::BTreeSet::new();
+    let cells = now.into_iter().flat_map(Doors::cells).chain(was.into_iter().flat_map(Doors::cells));
+    for (x, z) in cells {
+        // A door RimWorld has stopped sending is the gap it was before, as an unknown one is.
+        if shut(was, x, z) == shut(now, x, z) {
+            continue;
+        }
+        let (bx, bz) = (x * CELL, (floor.size - 1 - z) * CELL);
+        for (dx, dz) in [(-1, 0), (0, 0), (CELL, 0), (0, -1), (0, CELL)] {
+            chunks.insert(((bx + dx) >> 4, (bz + dz) >> 4));
+        }
+    }
+    chunks.into_iter().collect()
+}
