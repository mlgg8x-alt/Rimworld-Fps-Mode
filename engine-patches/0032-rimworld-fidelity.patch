+/// A pixel of the next mip level down from `from`: the four under it.
+fn mip_pixel(from: &RgbaImage, x: u32, y: u32) -> Rgba<u8> {
+    let mut sum = [0u32; 4];
+    for (dx, dy) in [(0, 0), (1, 0), (0, 1), (1, 1)] {
