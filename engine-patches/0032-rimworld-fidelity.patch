+/// Fires the player's gun as RimWorld fires their colonist's (M15): its clip holds one
+/// burst, its shots `between` apart, and once the burst is spent MW2 reloads and it holds
+/// fire for RimWorld's cooldown and aiming time, at the game's speed `rate`. Its reserve never
+/// runs out. `None` (no gun, or not playing) leaves MW2's own guns as they were.
+fn fire_like_rimworld(floor: &mut FlatFloor, authority: &mut net::AuthorityWorld, local: sim::ClientId, gun: Option<rimworld_bridge::GunTiming>, rate: f32, dt: f32) {
+    let Some(gun) = gun else {
+        if floor.gun_clip.take().is_some() {
+            sim::voxel::set_magazine(None);
+        }
+        floor.gun_hold = 0.0;
+        return;
+    };
+    let rounds = gun.burst.clamp(1, 1000) as i32;
+    floor.gun_hold = (floor.gun_hold - dt * rate.max(0.1)).max(0.0);
+    let clip = authority.0.held_clip(local);
+    // A round fired: not the clip cut to a burst when the gun is handed over.
+    if let (Some(before), Some(now)) = (floor.gun_clip, clip)
+        && now < before
+        && before <= rounds
+    {
+        floor.gun_hold = if now == 0 { gun.cooldown + gun.warmup } else { gun.between };
+    }
+    floor.gun_clip = Some(clip.unwrap_or(0));
+    sim::voxel::set_magazine(Some(sim::voxel::Magazine { client: local.0, rounds, hold: floor.gun_hold > 0.0 }));
+}
