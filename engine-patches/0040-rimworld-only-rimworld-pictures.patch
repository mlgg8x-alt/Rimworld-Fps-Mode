+/// How `figure` is drawn: its RimWorld picture, else the one it had while the new one loads;
+/// None while RimWorld has not drawn it yet, and then it is not shown at all (M22: a raid
+/// came as RimWorld pictures, MW2 soldiers and coloured boxes at once).
+fn picture(figure: &Figure, cutouts: &HashMap<u16, [f32; 4]>, eye: Option<[f64; 3]>, people: f32) -> Option<Card> {
+    card(figure, cutouts, eye, people).or_else(|| {
+        let (art, draw) = figure.was?;
+        card(&Figure { art: Some(art), draw: Some(draw), ..figure.clone() }, cutouts, eye, people)
+    })
+}
