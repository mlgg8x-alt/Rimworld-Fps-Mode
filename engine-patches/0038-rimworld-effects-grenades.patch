+/// M20 (rimworld-mw2): the effects `frame::RimFx` asks for, as they play.
+#[derive(Default)]
+struct RimFxPlaying {
+    /// Each kept effect, by its key: its handle, the name it plays, where, and when it began.
+    held: HashMap<u64, (u16, &'static str, [f32; 3], i32)>,
+    /// The name the game has for each list of names (by the list's address), `None` when it
+    /// has none of them.
+    chosen: HashMap<usize, Option<&'static str>>,
+}
+
+/// Milliseconds after which a kept effect that does not loop starts again.
+const RIM_FX_AGAIN_MS: i32 = 8000;
+
+/// M20 (rimworld-mw2): plays RimWorld's effects with MW2's own, as `frame::RimFx` lists
+/// them: the first of each list of names the game has; once, or kept going (started again
+/// should it end) until no longer listed.
+fn present_rim_fx(
+    rim: Option<ResMut<frame::RimFx>>,
+    catalog: Option<Res<PreparedFxCatalog>>,
+    mut elem_infos: ResMut<PreparedFxElemInfos>,
+    mut host: ResMut<HostFxSystem>,
+    fx_world: FxSceneAccess,
+    mut playing: Local<RimFxPlaying>,
+) {
+    let Some(mut rim) = rim else {
+        return;
+    };
+    let Some(catalog) = catalog else {
+        rim.once.clear();
+        return;
+    };
+    if rim.once.is_empty() && rim.held.is_empty() && playing.held.is_empty() {
+        return;
+    }
+    elem_infos.0.sync(&catalog.0);
+    let view = fx_world.view();
+    let scene = view.as_ref().map(|scene| scene as &dyn FxScene);
+    let RimFxPlaying { held, chosen } = &mut *playing;
+    let mut pick = |names: &'static [&'static str]| -> Option<&'static str> {
+        *chosen.entry(names.as_ptr() as usize).or_insert_with(|| {
+            let found = names.iter().copied().find(|name| catalog.0.map_fx_name(name).resolve(&catalog.0).is_some());
+            match found {
+                Some(name) => println!("[rimworld] effect: {name}"),
+                None => println!("[rimworld] no MW2 effect of {names:?}"),
+            }
+            found
+        })
+    };
+    for shot in std::mem::take(&mut rim.once) {
+        let Some(name) = pick(shot.names) else { continue };
+        play_named_oriented_in_world(
+            &mut host.0,
+            &catalog.0,
+            &elem_infos.0,
+            catalog.0.map_fx_name(name),
+            shot.origin,
+            axis_from_hit_normal(shot.forward),
+            scene,
+        );
+    }
+    let now = host.0.msec_now;
+    held.retain(|key, (handle, name, origin, began)| {
+        let ours = host.0.slot_for_handle(*handle).filter(|slot| slot.def_name == *name && slot.msec_begin == *began);
+        let looping = ours.is_some_and(|slot| slot.status & fx_iw4::FX_STATUS_HAS_PENDING_LOOP_ELEMS != 0);
+        let wanted = rim.held.get(key).is_some_and(|shot| shot.origin == *origin && shot.names.contains(name));
+        let keep = ours.is_some() && wanted && (looping || now.wrapping_sub(*began) < RIM_FX_AGAIN_MS);
+        if !keep && ours.is_some() {
+            host.0.stop_owned(*handle);
+        }
+        keep
+    });
+    for (key, shot) in &rim.held {
+        if held.contains_key(key) {
+            continue;
+        }
+        let Some(name) = pick(shot.names) else { continue };
+        let Some(handle) = spawn_named_oriented_in_world(
+            &mut host.0,
+            &catalog.0,
+            &elem_infos.0,
+            catalog.0.map_fx_name(name),
+            shot.origin,
+            axis_from_hit_normal(shot.forward),
+            now,
+            scene,
+        )
+        .and_then(PlayResult::handle) else {
+            continue;
+        };
+        let began = host.0.slot_for_handle(handle).map_or(now, |slot| slot.msec_begin);
+        held.insert(*key, (handle, name, shot.origin, began));
+    }
+}
