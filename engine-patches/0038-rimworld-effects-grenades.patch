+/// M20: fire or G while the played colonist holds grenades (RimWorld says how far they are
+/// thrown): RimWorld throws one where the player aims on the ground, no further than it can
+/// be thrown and no sooner than RimWorld would throw the next.
+#[allow(clippy::too_many_arguments)]
+fn throw_key(
+    time: Res<Time>,
+    floor: Res<FlatFloor>,
+    link: Option<Res<RimworldLink>>,
+    keys: Option<Res<ButtonInput<KeyCode>>>,
+    mouse: Option<Res<ButtonInput<MouseButton>>>,
+    (hud_input, loot, hold): (Option<Res<frame::HudInputView>>, Res<frame::RimLootUi>, Res<frame::RimHold>),
+    (presented, local): (Res<net::PresentedSnapshot>, Res<net::LocalPresentClient>),
+    outbox: Option<Res<RimworldOutbox>>,
+    mut wait: Local<f32>,
+) {
+    let link = link.as_deref();
+    let rate = link.and_then(|link| link.rate).unwrap_or(1.0).max(0.1);
+    *wait = (*wait - time.delta_secs()).max(0.0);
+    let Some((gun, range)) = link.and_then(|link| link.player_gun).and_then(|gun| Some((gun, gun.throw?))) else {
+        return;
+    };
+    let pressed = mouse.is_some_and(|mouse| mouse.just_pressed(MouseButton::Left)) || keys.is_some_and(|keys| keys.just_pressed(KeyCode::KeyG));
+    if !pressed || !floor.active || floor.spectating || hold.paused || loot.open {
+        return;
+    }
+    if hud_input.is_some_and(|input| input.console_open || input.script_menu_open) {
+        return;
+    }
+    let (Some(pawn), Some(outbox), Some(ps)) = (floor.playing.clone(), outbox, presented.player(local.0)) else {
+        return;
+    };
+    if *wait > 0.0 {
+        println!("[rimworld] not ready to throw again for {:.1}s", *wait);
+        return;
+    }
+    let eye = [ps.origin[0], ps.origin[1], ps.origin[2] + ps.view_height_current];
+    let reach = range.max(1.0) * CELL as f32 * BLOCK;
+    let to = floor.map_to_rimworld(aim_on_ground(eye, ps.viewangles, ps.origin[2], reach));
+    if outbox.send(&BridgeMessage::PlayerThrow { pawn, to }) {
+        println!("[rimworld] threw at ({:.1}, {:.1})", to[0], to[1]);
+        *wait = (gun.warmup + gun.cooldown) / rate;
+    }
+}
+
+/// Where a player whose eye is at map point `eye`, looking along `angles` (pitch, yaw in
+/// degrees, MW2's), aims on the ground at height `ground`: no further across than `reach`,
+/// and that far when they look level or up.
+fn aim_on_ground(eye: [f32; 3], angles: [f32; 3], ground: f32, reach: f32) -> [f32; 3] {
+    let (pitch, yaw) = (angles[0].to_radians(), angles[1].to_radians());
+    let across = Vec2::new(yaw.cos(), yaw.sin());
+    let down = pitch.sin();
+    let far = if down > 0.01 { (eye[2] - ground).max(0.0) / down * pitch.cos() } else { reach };
+    let d = far.min(reach);
+    [eye[0] + across.x * d, eye[1] + across.y * d, ground]
+}
