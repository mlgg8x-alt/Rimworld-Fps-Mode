+/// M20: MW2's own effects for RimWorld's, each a list of names to try in turn (the game has
+/// the effects of every map loaded, so not all of them).
+mod fx_names {
+    pub const MUZZLE: &[&str] = &["muzzleflashes/ak47_flash_wv", "muzzleflashes/heavy_flash_wv_a", "muzzleflashes/beretta_flash_wv"];
+    pub const DIRT: &[&str] = &["impacts/large_dirt_1", "impacts/large_dirt", "impacts/default_hit"];
+    pub const WALL: &[&str] = &["impacts/large_concrete_1", "impacts/large_brick", "impacts/default_hit"];
+    pub const FLESH: &[&str] = &["impacts/flesh_hit_body_nonfatal", "impacts/flesh_hit", "impacts/flesh_hit_splat"];
+    pub const FIRE_SMALL: &[&str] = &["fire/firelp_small_pm", "fire/firelp_small_pm_a", "fire/fire_woodtrash_small1v2res"];
+    pub const FIRE_BIG: &[&str] = &["fire/fire_med_loop02_res", "fire/firelp_barrel_pm", "fire/fire_vehicle_small_loop1_res", "fire/firelp_small_pm"];
+    pub const FIRE_SMOKE: &[&str] = &["smoke/thin_black_smoke_m", "smoke/car_damage_blacksmoke", "smoke/thin_black_smoke_l"];
+    pub const SMOKE: &[&str] = &["smoke/battlefield_smokebank_s", "smoke/room_smoke_200", "smoke/hallway_smoke_light", "smoke/thin_light_smoke_l"];
+    pub const TOX: &[&str] = &["smoke/thin_light_smoke_l", "smoke/car_damage_whitesmoke", "smoke/battlefield_smokebank_s"];
+    pub const ROT: &[&str] = &["smoke/thin_light_smoke_m", "smoke/thin_light_smoke_l"];
+    pub const DUST: &[&str] = &["smoke/thin_black_smoke_l", "smoke/car_damage_blacksmoke", "smoke/battlefield_smokebank_s"];
+    pub const FLAME_BLAST: &[&str] = &["explosions/fire_vehicle_flame_up_medbig1", "props/barrelexp", "explosions/grenadeexp_default"];
+    pub const EMP_BLAST: &[&str] = &["explosions/emp_flash_mp", "explosions/electrical_transformer_sparks_a", "explosions/generator_sparks_a"];
+    pub const FOAM_BLAST: &[&str] = &["explosions/steam_pipe_burst1", "smoke/flashbang_smoke", "smoke/grenade_smoke"];
+    pub const SMOKE_BLAST: &[&str] = &["smoke/grenade_smoke", "smoke/flashbang_smoke"];
+    pub const STUN_BLAST: &[&str] = &["explosions/flashbang", "explosions/concussion_grenade"];
+}
+
+/// The effect a RimWorld blast of `damage` adds to MW2's explosion (M20), if any.
+fn blast_effect(damage: &str) -> Option<&'static [&'static str]> {
+    Some(match damage {
+        "Flame" | "Burn" | "Incineration" | "Napalm" => fx_names::FLAME_BLAST,
+        "EMP" | "ElectricalBurn" | "MechBandShockwave" => fx_names::EMP_BLAST,
+        "Extinguish" => fx_names::FOAM_BLAST,
+        "Smoke" | "ToxGas" | "Tox" | "DeadlifeDust" | "RotStink" => fx_names::SMOKE_BLAST,
+        "Stun" | "Flashbang" => fx_names::STUN_BLAST,
+        _ => return None,
+    })
+}
+
+/// Blocks from the eye within which bullets flash and strike (M20), and how many a frame.
+const SHOT_EFFECT_REACH: f32 = 60.0 * CELL as f32;
+const MAX_SHOT_EFFECTS: usize = 12;
+
+/// A direction in block space (x east, y up, z south) as one in MW2's map space.
+fn map_direction(way: Vec3) -> [f32; 3] {
+    let way = way.normalize_or(Vec3::Y);
+    [way.x, -way.z, way.y]
+}
+
+/// M20: a muzzle flash for each of RimWorld's shots just `fired`, and a strike where each
+/// tracer in flight lands within the next `dt` seconds: blood on someone hit, dust off a
+/// wall, dirt on the ground. Only near the eye, and only so many a frame.
+fn shot_effects(floor: &FlatFloor, fired: &[Tracer], dt: f32) -> Vec<frame::RimFxShot> {
+    let eye = floor.eye.map(|eye| Vec3::new(eye[0] as f32, eye[1] as f32, eye[2] as f32));
+    let near = |p: Vec3| eye.is_none_or(|eye| eye.distance(p) <= SHOT_EFFECT_REACH);
+    let to_map = |b: Vec3| sim::voxel::to_map(floor.origin, [f64::from(b.x), f64::from(b.y), f64::from(b.z)]);
+    let playing = floor.playing.as_deref();
+    let flashes = fired
+        .iter()
+        .filter(|tracer| near(tracer.from) && Some(tracer.shooter.as_str()) != playing)
+        .map(|tracer| frame::RimFxShot { names: fx_names::MUZZLE, origin: to_map(tracer.from), forward: map_direction(tracer.to - tracer.from) });
+    let strikes = floor
+        .tracers
+        .iter()
+        .filter(|tracer| {
+            let length = tracer.from.distance(tracer.to);
+            tracer.flown < length && tracer.flown + tracer.speed * dt >= length && near(tracer.to)
+        })
+        .map(|tracer| {
+            let names = if tracer.hit {
+                fx_names::FLESH
+            } else if tracer.to.y > 0.3 {
+                fx_names::WALL
+            } else {
+                fx_names::DIRT
+            };
+            frame::RimFxShot { names, origin: to_map(tracer.to), forward: map_direction(tracer.from - tracer.to) }
+        });
+    flashes.chain(strikes).take(MAX_SHOT_EFFECTS).collect()
+}
+
+/// Fires and gas patches shown at most, the nearest the eye first, and how far away (M20).
+const MAX_FIRE_EFFECTS: usize = 32;
+const MAX_GAS_EFFECTS: usize = 32;
+const EFFECT_REACH: f32 = 80.0 * CELL as f32;
+/// A fire this big (RimWorld's `fireSize`) burns as a big one, with smoke above it.
+const BIG_FIRE: f32 = 0.9;
+/// Gas this thick (of 255) shows; rot stink only when this thick.
+const THIN_GAS: u8 = 30;
+const THICK_ROT: u8 = 140;
+
+/// The effects kept going for RimWorld's fires and gas (M20), by a key steady from frame to
+/// frame: the nearest the eye, as many as MW2 can carry.
+fn lasting_effects(floor: &FlatFloor, fires: &[rimworld_bridge::FireState], gas: &[rimworld_bridge::GasPatch]) -> HashMap<u64, frame::RimFxShot> {
+    let size = floor.size;
+    let eye = floor.eye.map(|eye| Vec2::new(eye[0] as f32, eye[2] as f32));
+    let away = |p: Vec3| eye.map_or(0.0, |eye| eye.distance(Vec2::new(p.x, p.z)));
+    let to_map = |b: Vec3| sim::voxel::to_map(floor.origin, [f64::from(b.x), f64::from(b.y), f64::from(b.z)]);
+    let key = |kind: u64, x: f32, z: f32| (kind << 56) | ((((x * 4.0) as i64 as u64) & 0x0fff_ffff) << 28) | (((z * 4.0) as i64 as u64) & 0x0fff_ffff);
+    let up = [0.0, 0.0, 1.0];
+    let mut held = HashMap::new();
+    let mut burning: Vec<(f32, &rimworld_bridge::FireState, Vec3)> = fires
+        .iter()
+        .map(|fire| {
+            let at = rimworld_block(size, fire.x, 0.0, fire.z);
+            (away(at), fire, at)
+        })
+        .filter(|(distance, ..)| *distance <= EFFECT_REACH)
+        .collect();
+    burning.sort_by(|a, b| a.0.total_cmp(&b.0));
+    for (_, fire, at) in burning.into_iter().take(MAX_FIRE_EFFECTS) {
+        let big = fire.size >= BIG_FIRE;
+        let names = if big { fx_names::FIRE_BIG } else { fx_names::FIRE_SMALL };
+        held.insert(key(1, fire.x, fire.z), frame::RimFxShot { names, origin: to_map(at), forward: up });
+        if big {
+            held.insert(key(2, fire.x, fire.z), frame::RimFxShot { names: fx_names::FIRE_SMOKE, origin: to_map(at + Vec3::Y), forward: up });
+        }
+    }
+    let half = rimworld_bridge::GAS_PATCH as f32 / 2.0;
+    let mut hanging: Vec<(f32, &'static [&'static str], [f32; 2], Vec3)> = gas
+        .iter()
+        .filter_map(|patch| {
+            let names = match patch.kind.as_str() {
+                "smoke" if patch.density >= THIN_GAS => fx_names::SMOKE,
+                "tox" if patch.density >= THIN_GAS => fx_names::TOX,
+                "dust" if patch.density >= THIN_GAS => fx_names::DUST,
+                "rot" if patch.density >= THICK_ROT => fx_names::ROT,
+                _ => return None,
+            };
+            let (x, z) = (patch.at[0] as f32 + half, patch.at[1] as f32 + half);
+            let at = rimworld_block(size, x, 0.0, z);
+            Some((away(at), names, [x, z], at))
+        })
+        .filter(|(distance, ..)| *distance <= EFFECT_REACH)
+        .collect();
+    hanging.sort_by(|a, b| a.0.total_cmp(&b.0));
+    for (_, names, [x, z], at) in hanging.into_iter().take(MAX_GAS_EFFECTS) {
+        held.insert(key(3, x, z), frame::RimFxShot { names, origin: to_map(at), forward: up });
+    }
+    held
+}
+
+/// Hands MW2's effects system what RimWorld shows this frame (M20): the blasts and bullet
+/// strikes `update` found, and its fires and gas, kept going while they last.
+fn present_effects(mut floor: ResMut<FlatFloor>, link: Option<Res<RimworldLink>>, mut fx: ResMut<frame::RimFx>) {
+    let once = std::mem::take(&mut floor.effects);
+    let connected = floor.active && link.as_deref().is_some_and(|link| link.connected);
+    if !connected {
+        fx.held.clear();
+        return;
+    }
+    fx.once.extend(once);
+    let link = link.as_deref();
+    let fires = link.and_then(|link| link.fires.as_deref()).map_or(&[][..], Vec::as_slice);
+    let gas = link.and_then(|link| link.gas.as_deref()).map_or(&[][..], Vec::as_slice);
+    let held = lasting_effects(&floor, fires, gas);
+    if fx.held != held {
+        fx.held = held;
+    }
+}
