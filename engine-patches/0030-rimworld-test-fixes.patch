+/// RimWorld's map has no classes: MW2's class select is answered at once with the first
+/// class, as the `spawn &` console command does (M13). The colonist's own gun replaces it.
+fn skip_class_select(
+    floor: Res<FlatFloor>,
+    screen: Option<Res<frame::AppScreen>>,
+    time: Res<Time>,
+    mut exec: MessageWriter<frame::UiExecCommand>,
+    mut wait: Local<f32>,
+) {
+    if (!floor.active && !floor.pending) || screen.is_none_or(|screen| *screen != frame::AppScreen::ClassSelect) {
+        *wait = 0.0;
+        return;
+    }
+    *wait -= time.delta_secs();
+    if *wait > 0.0 {
+        return;
+    }
+    // Again if it has not taken after a while.
+    *wait = 2.0;
+    diag::info!(World, "rimworld: skipping MW2's class select");
+    exec.write(frame::UiExecCommand { text: "spawn &".into() });
+}
