+/// One of Minecraft's 16-pixel block textures, its first frame for an animated one, tinted
+/// and made opaque (see-through pixels, as in leaves, go dark).
+fn block_texture(dir: &std::path::Path, name: &str, tint: [u8; 3]) -> Option<RgbaImage> {
+    let image = image::open(dir.join(format!("{name}.png"))).ok()?.to_rgba8();
+    let side = image.width();
+    if side == 0 || image.height() < side {
+        return None;
+    }
+    let frame = image::imageops::crop_imm(&image, 0, 0, side, side).to_image();
+    let frame = if side == TILE { frame } else { image::imageops::resize(&frame, TILE, TILE, image::imageops::FilterType::Nearest) };
+    Some(RgbaImage::from_fn(TILE, TILE, |x, y| {
+        let p = frame.get_pixel(x, y);
+        let alpha = u32::from(p[3]);
+        let channel = |i: usize| {
+            let over = (u32::from(p[i]) * alpha + 40 * (255 - alpha)) / 255;
+            (over * u32::from(tint[i]) / 255) as u8
+        };
+        Rgba([channel(0), channel(1), channel(2), 255])
+    }))
+}
