+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn floor_and_wall_layout() {
+        assert!(cell_at(250, 0, -1, 0) == Cell::Floor);
+        assert!(cell_at(250, 249, -1, 249) == Cell::Floor);
+        assert!(cell_at(250, 125, 0, 125) == Cell::Air);
+        assert!(cell_at(250, -1, 0, 10) == Cell::Wall);
+        assert!(cell_at(250, 250, 1, 250) == Cell::Wall);
+        assert!(cell_at(250, 250, 2, 250) == Cell::Air);
+        assert!(cell_at(250, -2, -1, 0) == Cell::Air);
+    }
+
+    #[test]
+    fn a_floor_cell_shows_only_its_top() {
+        let mut mesh = SectionMesh::default();
+        add_block(&mut mesh, 250, [10, -1, 10], Cell::Floor);
+        assert_eq!(mesh.indices.len(), 6);
+        assert!(mesh.vertices[..4].iter().all(|v| v.position[1] == 0.0));
+    }
+
+    #[test]
+    fn atlas_mips_reach_one_pixel_a_tile() {
+        let atlas = atlas();
+        let last = atlas.mipmaps.last().unwrap();
+        assert_eq!((last.width(), last.height()), (TILES, 1));
+    }
+
+    #[test]
+    fn map_origin_is_the_middle_of_the_floor() {
+        let floor = FlatFloor { size: 250, origin: [125.0, 0.0, 125.0], ..Default::default() };
+        let middle = floor.cell_to_map(124.5, 124.5);
+        assert!(middle.iter().all(|v| v.abs() < 1e-3), "{middle:?}");
+    }
+}
