+/// Standard base64, padding optional; `None` on anything else.
+fn base64(text: &str) -> Option<Vec<u8>> {
+    let value = |c: u8| match c {
+        b'A'..=b'Z' => Some(c - b'A'),
+        b'a'..=b'z' => Some(c - b'a' + 26),
+        b'0'..=b'9' => Some(c - b'0' + 52),
+        b'+' => Some(62),
+        b'/' => Some(63),
+        _ => None,
+    };
+    let text = text.trim_end_matches('=').as_bytes();
+    let mut out = Vec::with_capacity(text.len() * 3 / 4);
+    let (mut bits, mut held) = (0u32, 0u32);
+    for &c in text {
+        bits = (bits << 6) | u32::from(value(c)?);
+        held += 6;
+        if held >= 8 {
+            held -= 8;
+            out.push((bits >> held) as u8);
+            bits &= (1 << held) - 1;
+        }
+    }
+    Some(out)
+}
+
+/// The two windows, on Windows; elsewhere there is nothing to switch.
+mod window {
+    /// Puts RimWorld's window `rimworld` over MW2's (the window in front now, as Tab was
+    /// just pressed in it) and in front; MW2's window, to come back to.
+    #[cfg(windows)]
+    pub(super) fn bring_up(rimworld: i64) -> Option<i64> {
+        #[repr(C)]
+        #[derive(Default)]
+        struct Rect {
+            left: i32,
+            top: i32,
+            right: i32,
+            bottom: i32,
+        }
+        #[link(name = "user32")]
+        unsafe extern "system" {
+            fn GetForegroundWindow() -> isize;
+            fn GetWindowRect(window: isize, rect: *mut Rect) -> i32;
+            fn IsIconic(window: isize) -> i32;
+            fn ShowWindow(window: isize, command: i32) -> i32;
+            fn SetWindowPos(window: isize, after: isize, x: i32, y: i32, cx: i32, cy: i32, flags: u32) -> i32;
+            fn SetForegroundWindow(window: isize) -> i32;
+        }
+        const SW_RESTORE: i32 = 9;
+        const HWND_TOP: isize = 0;
+        const SWP_SHOWWINDOW: u32 = 0x0040;
+        let rimworld = rimworld as isize;
+        // SAFETY: plain user32 calls on window handles; a stale handle only makes them fail.
+        unsafe {
+            let mw2 = GetForegroundWindow();
+            if mw2 == 0 || mw2 == rimworld {
+                return None;
+            }
+            let mut rect = Rect::default();
+            if IsIconic(rimworld) != 0 {
+                ShowWindow(rimworld, SW_RESTORE);
+            }
+            if GetWindowRect(mw2, &raw mut rect) != 0 {
+                SetWindowPos(
+                    rimworld,
+                    HWND_TOP,
+                    rect.left,
+                    rect.top,
+                    rect.right - rect.left,
+                    rect.bottom - rect.top,
+                    SWP_SHOWWINDOW,
+                );
+            }
+            (SetForegroundWindow(rimworld) != 0).then_some(mw2 as i64)
+        }
+    }
+
+    #[cfg(not(windows))]
+    pub(super) fn bring_up(_rimworld: i64) -> Option<i64> {
+        None
+    }
+}
+
+/// Size of a cell in map units: for tests.
+#[cfg(test)]
+pub(crate) fn cell_units() -> f32 {
+    crate::CELL as f32 * sim::voxel::BLOCK
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn base64_reads_standard_text() {
+        assert_eq!(base64("aGVsbG8=").as_deref(), Some(&b"hello"[..]));
+        assert_eq!(base64("aGk").as_deref(), Some(&b"hi"[..]));
+        assert_eq!(base64("/+8A").as_deref(), Some(&[0xff, 0xef, 0x00][..]));
+        assert_eq!(base64("a b"), None);
+    }
+
+    #[test]
+    fn a_view_is_north_up_and_as_wide_as_rimworld_says() {
+        let origin = crate::middle(250);
+        let view = View { size: 4, x: 125.0, z: 125.0, cells: 40.0, jpg: String::new() };
+        let (north_west, south_east, width) = corners(origin, 250, &view);
+        // Map +Y is north and +X east, the middle of the floor is the map's origin.
+        assert!(north_west[0] < 0.0 && north_west[1] > 0.0);
+        assert!(south_east[0] > 0.0 && south_east[1] < 0.0);
+        assert!((width - 40.0 * cell_units()).abs() < 0.01);
+        assert!((north_west[0] + south_east[0]).abs() < 0.01);
+    }
+
+    #[test]
+    fn a_view_decodes_with_the_north_row_first() {
+        // Two rows: RimWorld's first is the bottom (south), black; the top is white.
+        let mut picture = image::RgbImage::new(8, 8);
+        for (_, y, pixel) in picture.enumerate_pixels_mut() {
+            *pixel = if y < 4 { image::Rgb([0, 0, 0]) } else { image::Rgb([255, 255, 255]) };
+        }
+        let mut jpg = Vec::new();
+        image::codecs::jpeg::JpegEncoder::new_with_quality(&mut jpg, 95).encode_image(&picture).unwrap();
+        let text = encode(&jpg);
+        let view = View { size: 8, x: 0.0, z: 0.0, cells: 8.0, jpg: text };
+        let image = decode(&view).expect("decodes");
+        let data = image.data.expect("pixels");
+        assert!(data[0] > 200, "the north row is first");
+        assert!(data[data.len() - 4] < 50, "the south row is last");
+    }
+
+    fn encode(bytes: &[u8]) -> String {
+        const SET: &[u8] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+        let mut out = String::new();
+        for chunk in bytes.chunks(3) {
+            let n = chunk.iter().enumerate().fold(0u32, |n, (i, &b)| n | u32::from(b) << (16 - 8 * i));
+            for i in 0..=chunk.len() {
+                out.push(SET[(n >> (18 - 6 * i) & 63) as usize] as char);
+            }
+        }
+        out
+    }
+}
