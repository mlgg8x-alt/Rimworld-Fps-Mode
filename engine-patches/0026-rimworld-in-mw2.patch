diff --git a/crates/rimworld_world/src/rimview.rs b/crates/rimworld_world/src/rimview.rs
new file mode 100644
index 0000000..f900603
--- /dev/null
+++ b/crates/rimworld_world/src/rimview.rs
@@ -0,0 +1,249 @@
+//! M9: RimWorld inside MW2. The minimap shows what RimWorld's camera sees around the MW2
+//! player (the mod's `view`, a small JPEG ten times a second), and Tab brings RimWorld's own
+//! window up over MW2's, fully playable; Tab in RimWorld comes back (the mod does that).
+//!
+//! While the player flies free, where they fly goes to RimWorld as `spectate`, so its camera
+//! follows them; while they play a colonist, RimWorld's camera follows that colonist.
+
+use bevy::asset::RenderAssetUsages;
+use bevy::prelude::*;
+use bevy::render::render_resource::{Extent3d, TextureDimension, TextureFormat};
+use rimworld_bridge::{BridgeMessage, RimworldLink, RimworldOutbox, View};
+
+use crate::{FlatFloor, rimworld_block};
+
+/// A `view` older than this many seconds is stale: the minimap shows the floor's own map.
+pub(crate) const VIEW_SECONDS: f32 = 2.0;
+/// The minimap shows the square inside the picture that stays inside it however the
+/// minimap turns: 1/√2 of its side.
+const TURNING: f32 = std::f32::consts::FRAC_1_SQRT_2;
+
+/// The latest picture of RimWorld, ready for the minimap.
+#[derive(Clone)]
+pub(crate) struct ViewPicture {
+    pub image: Handle<Image>,
+    /// Its north-west and south-east corners, in map units.
+    pub north_west: [f32; 2],
+    pub south_east: [f32; 2],
+    /// How much of it the minimap shows, side to side, in map units.
+    pub range: f32,
+    /// Seconds since it arrived.
+    pub age: f32,
+}
+
+/// `view`'s picture as an image, north row first; `None` if it does not decode.
+pub(crate) fn decode(view: &View) -> Option<Image> {
+    let jpg = base64(&view.jpg)?;
+    let picture = image::load_from_memory_with_format(&jpg, image::ImageFormat::Jpeg).ok()?.to_rgba8();
+    let (width, height) = picture.dimensions();
+    if width == 0 || height == 0 {
+        return None;
+    }
+    // RimWorld reads its picture back bottom row first.
+    let row = width as usize * 4;
+    let raw = picture.into_raw();
+    let pixels: Vec<u8> = raw.chunks_exact(row).rev().flatten().copied().collect();
+    Some(Image::new(
+        Extent3d { width, height, depth_or_array_layers: 1 },
+        TextureDimension::D2,
+        pixels,
+        TextureFormat::Rgba8UnormSrgb,
+        RenderAssetUsages::default(),
+    ))
+}
+
+/// Where `view` lies on a floor `size` cells a side at `origin`: its north-west and
+/// south-east corners in map units, and its width.
+pub(crate) fn corners(origin: [f64; 3], size: i32, view: &View) -> ([f32; 2], [f32; 2], f32) {
+    let half = view.cells / 2.0;
+    let map = |x: f32, z: f32| {
+        let b = rimworld_block(size, x, 0.0, z);
+        let p = sim::voxel::to_map(origin, [f64::from(b.x), f64::from(b.y), f64::from(b.z)]);
+        [p[0], p[1]]
+    };
+    let north_west = map(view.x - half, view.z + half);
+    let south_east = map(view.x + half, view.z - half);
+    (north_west, south_east, (south_east[0] - north_west[0]).abs())
+}
+
+/// How much of a picture `width` map units across the minimap shows.
+pub(crate) fn range(width: f32) -> f32 {
+    width * TURNING
+}
+
+/// A map point the player flies at, as a `spectate`.
+pub(crate) fn spectate(floor: &FlatFloor, eye: [f32; 3]) -> BridgeMessage {
+    let [x, z] = floor.map_to_rimworld(eye);
+    BridgeMessage::Spectate { x, z }
+}
+
+/// Tab on the floor: RimWorld's window comes up where MW2's is, instead of the scoreboard.
+pub(crate) fn tab_to_rimworld(
+    floor: Res<FlatFloor>,
+    keys: Option<Res<ButtonInput<KeyCode>>>,
+    hud_input: Option<Res<frame::HudInputView>>,
+    link: Option<Res<RimworldLink>>,
+    outbox: Option<Res<RimworldOutbox>>,
+) {
+    if !floor.active || !keys.is_some_and(|keys| keys.just_pressed(KeyCode::Tab)) {
+        return;
+    }
+    if hud_input.is_some_and(|input| input.console_open || input.script_menu_open) {
+        return;
+    }
+    let Some(rimworld) = link.as_deref().filter(|link| link.connected).and_then(|link| link.rimworld_window) else {
+        println!("[rimworld] Tab: RimWorld did not say which window is its own");
+        return;
+    };
+    match window::bring_up(rimworld) {
+        Some(back) => {
+            if let Some(outbox) = outbox {
+                outbox.send(&BridgeMessage::RimworldShown { back: back.to_string() });
+            }
+        }
+        None => println!("[rimworld] Tab: could not bring RimWorld's window up"),
+    }
+}
