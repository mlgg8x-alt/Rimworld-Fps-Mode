diff --git a/crates/hud/src/menus/rimworld.rs b/crates/hud/src/menus/rimworld.rs
new file mode 100644
index 0000000..dc6f9a7
--- /dev/null
+++ b/crates/hud/src/menus/rimworld.rs
@@ -0,0 +1,99 @@
+//! RimWorld x MW2 (M9): the Escape menu holds only what this game has. MW2's own in-game
+//! menu names the map, the game type, the teams and the classes, and offers to mute other
+//! players; none of that exists here, where RimWorld decides everything and nobody else is
+//! playing. Those items are hidden as the menu opens, leaving the options and the way out.
+
+use asset_game::MenuEvent;
+
+use super::runtime::Runner;
+
+/// An item whose text, picture or action mentions one of these is not for this game.
+const DROPPED: &[&str] = &[
+    "MPUI_", "MAPNAME", "CURRENT_MAP", "GAMETYPE", "GAME_TYPE", "FREE_FOR_ALL", "FFA", "CLASS",
+    "LOADOUT", "TEAM", "MUTE", "VOICE", "FRIEND", "SQUAD", "PARTY", "CLAN", "EMBLEM",
+    "SCOREBOARD", "RECORD", "DEMO",
+];
+/// An item whose name or action mentions one of these stays, whatever else it says.
+const KEPT: &[&str] = &[
+    "OPTION", "SETTING", "CONTROL", "RESUME", "BACK", "CLOSE", "LEAVE", "QUIT", "EXIT", "END_GAME",
+    "ENDGAME", "DISCONNECT", "MAIN_MENU",
+];
+
+/// Hides what MW2's in-game menu `name` offers that RimWorld x MW2 does not have. The items
+/// it hides are logged once per menu, so the list above can be judged from a real game.
+pub(crate) fn trim(runner: &mut Runner<'_, '_>, name: &str) {
+    let Some(def) = runner.catalog.get(name) else { return };
+    let hidden: Vec<(usize, String)> = def
+        .items
+        .iter()
+        .enumerate()
+        .filter(|(_, item)| {
+            let scripts = scripts(&item.handlers.action) + " " + &scripts(&item.handlers.accept);
+            drops(&words(&[&item.name, &item.text_key, &item.text_exp, &item.material_exp, &item.dvar, &scripts]))
+        })
+        .map(|(index, item)| (index, label(&item.name, &item.text_key)))
+        .collect();
+    let Some(open) = runner.menus.get_mut(&def.name) else { return };
+    for &(index, _) in &hidden {
+        if let Some(state) = open.items.get_mut(index) {
+            state.hidden = true;
+        }
+    }
+    if !hidden.is_empty() {
+        let names: Vec<&str> = hidden.iter().map(|(_, label)| label.as_str()).collect();
+        println!("[rimworld] escape menu {}: hid {}", def.name, names.join(", "));
+    }
+}
+
+/// What an item's handlers run, flattened.
+fn scripts(events: &[MenuEvent]) -> String {
+    events
+        .iter()
+        .map(|event| match event {
+            MenuEvent::Script(line) => line.clone(),
+            MenuEvent::If { condition, then } => format!("{condition} {}", scripts(then)),
+            MenuEvent::Else(then) => scripts(then),
+            MenuEvent::SetLocalVar { name, expr, .. } => format!("{name} {expr}"),
+        })
+        .collect::<Vec<_>>()
+        .join(" ")
+}
+
+/// Everything an item says about itself, in upper case.
+fn words(parts: &[&str]) -> String {
+    parts.join(" ").to_uppercase()
+}
+
+/// Whether what an item says puts it out of this game: it mentions something MW2 has and
+/// RimWorld x MW2 does not, and nothing that keeps it.
+fn drops(said: &str) -> bool {
+    DROPPED.iter().any(|word| said.contains(word)) && !KEPT.iter().any(|word| said.contains(word))
+}
+
+/// A name for the log: the item's own, else the text it shows.
+fn label(name: &str, text_key: &str) -> String {
+    let name = if name.is_empty() { text_key } else { name };
+    if name.is_empty() { "(unnamed)".to_owned() } else { name.to_owned() }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_map_the_game_type_the_teams_and_muting_go() {
+        assert!(drops(&words(&["", "@MPUI_CHANGE_CLASS", "", "", "", ""])));
+        assert!(drops(&words(&["muteplayer", "", "", "", "", ""])));
+        assert!(drops(&words(&["mapname", "", "", "\"MPUI_ESTATE\"", "", ""])));
+        assert!(drops(&words(&["", "", "", "", "ui_gametype", ""])));
+    }
+
+    #[test]
+    fn the_options_and_the_way_out_stay() {
+        assert!(!drops(&words(&["options", "@MENU_OPTIONS", "", "", "", ""])));
+        assert!(!drops(&words(&["leavegame", "@MPUI_LEAVE_GAME", "", "", "", ""])));
+        assert!(!drops(&words(&["resume", "@MENU_RESUME_GAME", "", "", "", ""])));
+        // Leaving the game mentions the main menu, which it goes back to.
+        assert!(!drops(&words(&["quit", "@MPUI_END_GAME", "", "", "", "open main_menu"])));
+    }
+}
