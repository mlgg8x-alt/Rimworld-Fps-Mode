<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RimWorldMW2</RootNamespace>
    <AssemblyName>RimWorldMW2</AssemblyName>
    <OutputPath>../1.6/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DebugType>none</DebugType>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference-only RimWorld and Unity assemblies, so the mod builds without a game install.
         Versions are pinned in versions.json; keep the two in step. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
    <!-- Harmony ships as its own RimWorld mod, so never copy its DLL into ours. -->
    <PackageReference Include="Lib.Harmony" Version="2.4.2" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
